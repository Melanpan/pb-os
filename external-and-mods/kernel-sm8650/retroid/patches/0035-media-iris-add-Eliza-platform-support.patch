From da71da2b4bca71e6083d5c2ccd9d1586d5650815 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Thu, 10 Sep 2026 20:55:19 +0700
Subject: [PATCH 35/71] media: iris: add Eliza platform support

Eliza has an Iris 3.3 (VPU33) core with two VPP pipes, capable of
4096x2176 at 60 fps. It runs the vpu30_p2 firmware and otherwise
shares the SM8650 programming model, including the XO controller
reset sequence in the power-off path.

Add platform data for it: VPU33 ops and buffer sizing, the SM8550
clock table, a reset table with the extra vcodec0_core reset, the
XO controller reset, OPP power domains on MX/CX, and instance caps
capped at 4K with the two-pipe cycle counts.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../platform/qcom/iris/iris_platform_common.h |  1 +
 .../platform/qcom/iris/iris_platform_eliza.h  | 26 +++++++++++
 .../platform/qcom/iris/iris_platform_vpu3x.c  | 44 +++++++++++++++++++
 drivers/media/platform/qcom/iris/iris_probe.c |  4 ++
 4 files changed, 75 insertions(+)
 create mode 100644 drivers/media/platform/qcom/iris/iris_platform_eliza.h

diff --git a/drivers/media/platform/qcom/iris/iris_platform_common.h b/drivers/media/platform/qcom/iris/iris_platform_common.h
index 974809509..69c239c60 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -54,6 +54,7 @@ extern const struct iris_firmware_data iris_hfi_gen1_data;
 extern const struct iris_firmware_data iris_hfi_gen2_data;
 extern const struct iris_firmware_data iris_hfi_milos_data;
 
+extern const struct iris_platform_data eliza_data;
 extern const struct iris_platform_data milos_data;
 extern const struct iris_platform_data qcs8300_data;
 extern const struct iris_platform_data sc7280_data;
diff --git a/drivers/media/platform/qcom/iris/iris_platform_eliza.h b/drivers/media/platform/qcom/iris/iris_platform_eliza.h
new file mode 100644
index 000000000..14b2b2325
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_platform_eliza.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __IRIS_PLATFORM_ELIZA_H__
+#define __IRIS_PLATFORM_ELIZA_H__
+
+static const char * const eliza_clk_reset_table[] = { "bus", "core", "vcodec0_core" };
+
+static const char * const eliza_opp_pd_table[] = { "mx", "cx" };
+
+static struct platform_inst_caps platform_inst_cap_eliza = {
+	.min_frame_width = 96,
+	.max_frame_width = 4096,
+	.min_frame_height = 96,
+	.max_frame_height = 4096,
+	.max_mbpf = (4096 * 2176) / 256,
+	.mb_cycles_vpp = 200,
+	.mb_cycles_fw = 489583,
+	.mb_cycles_fw_vpp = 66234,
+	.max_frame_rate = MAXIMUM_FPS,
+	.max_operating_rate = MAXIMUM_FPS,
+};
+
+#endif
diff --git a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
index 74626b35d..79148ca99 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
@@ -12,6 +12,7 @@
 #include "iris_vpu_buffer.h"
 #include "iris_vpu_common.h"
 
+#include "iris_platform_eliza.h"
 #include "iris_platform_qcs8300.h"
 #include "iris_platform_sm8550.h"
 #include "iris_platform_sm8650.h"
@@ -36,6 +37,12 @@ static const struct iris_firmware_desc iris_vpu30_p1_gen2_desc = {
 	.fwname = "qcom/vpu/vpu30_p1_s7.mbn",
 };
 
+static const struct iris_firmware_desc iris_vpu30_p2_gen2_desc = {
+	.firmware_data = &iris_hfi_gen2_data,
+	.get_vpu_buffer_size = iris_vpu33_buf_size,
+	.fwname = "qcom/vpu/vpu30_p2.mbn",
+};
+
 static const struct iris_firmware_desc iris_vpu33_p4_gen2_desc = {
 	.firmware_data = &iris_hfi_gen2_data,
 	.get_vpu_buffer_size = iris_vpu33_buf_size,
@@ -89,6 +96,43 @@ static const struct tz_cp_config tz_cp_config_vpu3[] = {
  * Shares most of SM8550 data except:
  * - inst_caps to platform_inst_cap_qcs8300
  */
+/*
+ * Two-pipe VPU33: shares most of SM8650 data except:
+ * - firmware, inst_caps and num_vpp_pipe for a 4K-class core
+ * - clk_rst_tbl with the extra vcodec0_core reset
+ * - opp_pd_tbl on MX/CX (no MXC/MMCX rails)
+ */
+const struct iris_platform_data eliza_data = {
+	.firmware_desc_gen2 = &iris_vpu30_p2_gen2_desc,
+	.vpu_ops = &iris_vpu33_ops,
+	.icc_tbl = iris_icc_info_vpu3x,
+	.icc_tbl_size = ARRAY_SIZE(iris_icc_info_vpu3x),
+	.clk_rst_tbl = eliza_clk_reset_table,
+	.clk_rst_tbl_size = ARRAY_SIZE(eliza_clk_reset_table),
+	.controller_rst_tbl = sm8650_controller_reset_table,
+	.controller_rst_tbl_size = ARRAY_SIZE(sm8650_controller_reset_table),
+	.bw_tbl_dec = iris_bw_table_dec_vpu3x,
+	.bw_tbl_dec_size = ARRAY_SIZE(iris_bw_table_dec_vpu3x),
+	.pmdomain_tbl = iris_pmdomain_table_vpu3x,
+	.pmdomain_tbl_size = ARRAY_SIZE(iris_pmdomain_table_vpu3x),
+	.opp_pd_tbl = eliza_opp_pd_table,
+	.opp_pd_tbl_size = ARRAY_SIZE(eliza_opp_pd_table),
+	.clk_tbl = sm8550_clk_table,
+	.clk_tbl_size = ARRAY_SIZE(sm8550_clk_table),
+	.opp_clk_tbl = iris_opp_clk_table_vpu3x,
+	/* Upper bound of DMA address range */
+	.dma_mask = 0xe0000000 - 1,
+	.inst_iris_fmts = iris_fmts_vpu3x_dec,
+	.inst_iris_fmts_size = ARRAY_SIZE(iris_fmts_vpu3x_dec),
+	.inst_caps = &platform_inst_cap_eliza,
+	.tz_cp_config_data = tz_cp_config_vpu3,
+	.tz_cp_config_data_size = ARRAY_SIZE(tz_cp_config_vpu3),
+	.num_vpp_pipe = 2,
+	.max_session_count = 16,
+	.max_core_mbpf = ((1920 * 1088) / 256) * 24,
+	.max_core_mbps = ((4096 * 2176) / 256) * 60,
+};
+
 const struct iris_platform_data qcs8300_data = {
 	.firmware_desc_gen2 = &iris_vpu30_p4_s6_gen2_desc,
 	.vpu_ops = &iris_vpu3_ops,
diff --git a/drivers/media/platform/qcom/iris/iris_probe.c b/drivers/media/platform/qcom/iris/iris_probe.c
index e4acf4a74..f6bb24ac6 100644
--- a/drivers/media/platform/qcom/iris/iris_probe.c
+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -356,6 +356,10 @@ static const struct dev_pm_ops iris_pm_ops = {
 };
 
 static const struct of_device_id iris_dt_match[] = {
+	{
+		.compatible = "qcom,eliza-iris",
+		.data = &eliza_data,
+	},
 	{
 		.compatible = "qcom,milos-iris",
 		.data = &milos_data,
-- 
