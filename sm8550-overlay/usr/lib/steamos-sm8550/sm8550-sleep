#!/bin/sh
# sm8550-sleep pre|post: run by systemd-suspend.service (drop-in) around
# every system sleep on SM8550.
#
# pre:  the stick LEDs fade out first (they would otherwise stay lit until
#       the kernel suspends, after the screen is already dark), Bluetooth off
#       (its UART clock keeps the SoC's XO on), and every audio stream off
#       the hardware. An open stream keeps the audio DSP graph and its
#       clocks up, and the SoC never reaches full sleep. Steam plays a sound
#       when it goes to sleep, and its web helper (Chromium) keeps that
#       stream open for about 15 s; suspending the sink does not stop a
#       stream that is playing. So every stream moves to a silent null sink
#       first, then the hardware sinks and sources are suspended.
# post: undo all of it (the LEDs fade back in); removing the null sink sends
#       the streams back to the default devices.
# The one image also runs on SM8650, where konkr-sleep prepares the sleep.
grep -qa "qcom,sm8550" /sys/firmware/devicetree/base/compatible 2>/dev/null || exit 0
BT_MARK=/run/sm8550-sleep-bt-was-on
LED_SAVE=/run/sm8550-sleep-leds
NULL=sm8550-sleep

leds() {
    # The stick LEDs: multicolor groups (the RGB rings; on the AYN Odin 2
    # PWM multicolor LEDs on two SN3112s). The charge LED is left alone.
    for d in /sys/class/leds/*; do
        case "$(basename "$(readlink "$d/device/driver" 2>/dev/null)")" in
            leds_group_multicolor|leds_pwm_multicolor) echo "$d" ;;
        esac
    done
}

fade() {
    # $1 = out|in: every LED in $LED_SAVE ("led brightness" lines) from its saved
    # brightness to 0, or back up to it, over 0.3 s. Each LED steps through every
    # level it passes, on a gamma curve so the fade looks even to the eye.
    # The kernel scales each colour channel by the brightness and rounds down,
    # so near 0 a pink would show red alone (blue already 0): below the level
    # where every main channel of its colour (a quarter of the strongest or
    # more) still lights, the LED is off.
    /usr/lib/pbos-platformd/pbos-platformd led-fade "$1" "$LED_SAVE"
}

pactl_users() {
    # Runs "$@" once per user with a PipeWire socket, with $p set to that user's pactl.
    for sock in /run/user/*/pulse/native; do
        [ -S "$sock" ] || continue
        rt=${sock%/pulse/native}; uid=${rt##*/}
        user=$(id -nu "$uid" 2>/dev/null) || continue
        p="runuser -u $user -- env XDG_RUNTIME_DIR=$rt pactl"
        "$@"
    done
}

audio_off() {
    mod=$($p load-module module-null-sink sink_name=$NULL 2>/dev/null) && echo "$mod" > "/run/sm8550-sleep-null-$uid"
    for i in $($p list sink-inputs short 2>/dev/null | cut -f1); do $p move-sink-input "$i" $NULL; done
    for o in $($p list source-outputs short 2>/dev/null | cut -f1); do $p move-source-output "$o" $NULL.monitor; done
    for s in $($p list sinks short 2>/dev/null | cut -f2); do [ "$s" = $NULL ] || $p suspend-sink "$s" 1; done
    for s in $($p list sources short 2>/dev/null | cut -f2); do
        [ "$s" = $NULL.monitor ] || $p suspend-source "$s" 1
    done
}

audio_on() {
    for s in $($p list sinks short 2>/dev/null | cut -f2); do $p suspend-sink "$s" 0; done
    for s in $($p list sources short 2>/dev/null | cut -f2); do $p suspend-source "$s" 0; done
    if [ -e "/run/sm8550-sleep-null-$uid" ]; then
        $p unload-module "$(cat "/run/sm8550-sleep-null-$uid")"
        rm -f "/run/sm8550-sleep-null-$uid"
    fi
}

streams_open() {
    for f in /proc/asound/card*/pcm*/sub*/status; do
        [ -e "$f" ] || continue
        [ "$(head -n1 "$f")" = closed ] || return 0
    done
    return 1
}

case "$1" in
pre)
    : > "$LED_SAVE"
    for d in $(leds); do
        b=$(cat "$d/brightness") && [ "$b" != 0 ] && echo "$d $b" >> "$LED_SAVE"
    done
    fade out
    if rfkill list bluetooth 2>/dev/null | grep -q "Soft blocked: no"; then
        rfkill block bluetooth && touch "$BT_MARK"
    fi
    pactl_users audio_off
    i=0
    while streams_open && [ $i -lt 30 ]; do sleep 0.5; i=$((i + 1)); done
    ;;
post)
    if [ -e "$LED_SAVE" ]; then
        fade in
        rm -f "$LED_SAVE"
    fi
    pactl_users audio_on
    if [ -e "$BT_MARK" ]; then
        rm -f "$BT_MARK"
        rfkill unblock bluetooth
    fi
    ;;
esac
exit 0
