def refresh_user_apps(force: bool = False) -> None:
    """Take in the user apps installed, updated or removed since last time.
    APPS is replaced, never changed, so a loop over it elsewhere goes on
    undisturbed."""
    global APPS
    stamp = barry_apps.stamp()
    if not force and stamp == APPS_STAMP[0]:
        return
    APPS_STAMP[0] = stamp
    apps = dict(BUILTIN_APPS)
    for app_id, m in barry_apps.installed().items():
        icon = f"file://{os.path.join(m['dir'], m['icon'])}" if m["icon"] else "app"
        spec = {"name": m["name"], "icon": icon, "user": True, "version": m["version"], "dir": m["dir"],
                "keepAwake": m.get("keepAwake", False)}
        if m["type"] == "web":
            # A Firefox app, like Discord, with its profile in the app's
            # data folder: removing the app logs it out and leaves nothing.
            web = m["web"]
            # The profile is this site's alone: it may keep its data (no
            # "store data in persistent storage?" prompt); no notifications.
            prefs = {"permissions.default.desktop-notification": 2,
                     "permissions.default.persistent-storage": 1}
            if "microphone" in web["allow"]:
                prefs["permissions.default.microphone"] = 1
            if "camera" in web["allow"]:
                prefs["permissions.default.camera"] = 1
            if web["allow"]:
                prefs["media.navigator.permission.disabled"] = True
            spec.update(profile=os.path.join(barry_apps.APP_DATA_DIR, app_id, "firefox"),
                        args=["--kiosk", web["url"]], zoom=str(web["zoom"]), prefs=prefs)
        else:
            # ids are [a-z0-9._-]: only the dots need escaping, for
            # xdotool's and KWin's regexes alike.
            spec.update(main=m["main"], service=m["service"],
                        window=f"^Barry App {app_id.replace('.', '[.]')}$")
        apps[app_id] = spec
    APPS = apps
    publish("apps", "home")
# The home screen's order and the apps it hides (the Barry Launcher plugin's
