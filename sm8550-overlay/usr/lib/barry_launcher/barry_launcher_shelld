               "keyd": keyd_state, "apps": apps_state, "tools": tools_state}


class Events:
    """Each topic's answer as last worked out, and the event stream's
    clients (these only on the main loop)."""

    def __init__(self) -> None:
        self.lock = threading.Lock()  # answers worked out one at a time, in the order things changed
        self.answers: dict[str, bytes] = {}
        self.clients: list[EventClient] = []
        self.flush_queued = False

    def answer(self, topic: str) -> bytes:
        with self.lock:
            return self.answers[topic]


EVENTS = Events()


def publish(*topics: str) -> None:
    """Something behind these topics changed: work their answers out again
    (from any thread, never with STATE.lock held), and send the ones that
    differ to the event stream's clients, as soon as the main loop is free
    (the changes of one go together, a line each)."""
    if "home" in topics or "apps" in topics:
        background_soon()  # what shows may have changed: apps in the background
    changed = False
    with EVENTS.lock:
        for topic in topics:
            body = json.dumps(TOPIC_STATE[topic]()).encode()
            if body != EVENTS.answers.get(topic):
                EVENTS.answers[topic] = body
                changed = True
        if not changed or EVENTS.flush_queued:
            return
        EVENTS.flush_queued = True
    GLib.idle_add(flush_events, priority=GLib.PRIORITY_HIGH)


def flush_events() -> bool:
    with EVENTS.lock:
        EVENTS.flush_queued = False
        answers = dict(EVENTS.answers)
    for client in list(EVENTS.clients):
        client.send_changed(answers)
    return False


class EventClient:
    """One connection to the event stream (main loop only). It gets each
    topic's answer when it differs from the one it got last."""

    def __init__(self, sock: socket.socket) -> None:
        self.sock = sock
        self.sent: dict[str, bytes] = {}
        self.out = b""
        self.inbuf = b""
        self.out_watch = 0
        self.closed = False
        self.tool = False  # a tool's window that slides away when asked ({"tool": true})
        try:
            # Who it is (the kernel's word): tools are asked, and answer, by pid.
            self.pid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                           struct.calcsize("3i")))[0]
        except OSError:
            self.pid = 0
        self.in_watch = GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, sock.fileno(),
                                              GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR,
                                              self.readable)

    def send_changed(self, answers: dict[str, bytes]) -> None:
        lines = []
        for topic in TOPICS:
            body = answers.get(topic)
            if body is not None and body != self.sent.get(topic):
                self.sent[topic] = body
                lines.append(b'{"topic": "' + topic.encode() + b'", "data": ' + body + b"}\n")
        if lines:
            self.out += b"".join(lines)
            self.drain()

    def drain(self) -> bool:
        if self.closed:
            return False
        try:
            self.out = self.out[self.sock.send(self.out):]
        except BlockingIOError:
            pass
        except OSError:
            self.close()
            return False
        if len(self.out) > EVENT_BACKLOG_MAX:
            log("event stream: a client fell behind; dropped")
            self.close()
            return False
        if self.out and not self.out_watch:
            self.out_watch = GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, self.sock.fileno(),
                                                   GLib.IOCondition.OUT, lambda *_: self.drain())
        elif not self.out and self.out_watch:
            GLib.source_remove(self.out_watch)
            self.out_watch = 0
        return bool(self.out)

    def readable(self, _fd, _cond) -> bool:
        try:
            data = self.sock.recv(4096)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data:
            self.close()
            return False
        self.inbuf += data
        while b"\n" in self.inbuf and not self.closed:
            line, self.inbuf = self.inbuf.split(b"\n", 1)
            client_message(self, line)
        if len(self.inbuf) > EVENT_LINE_MAX:
            self.close()
        return not self.closed

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        for watch in (self.in_watch, self.out_watch):
            if watch:
                GLib.source_remove(watch)
        self.in_watch = self.out_watch = 0
        self.sock.close()
        if self in EVENTS.clients:
            EVENTS.clients.remove(self)


def client_message(client: EventClient, line: bytes) -> None:
    """A line from an event stream client: {"keyboard_height": n}; a tool's
    window: {"tool": true}, {"tool_left": true} (tools_leave)."""
    try:
        msg = json.loads(line)
    except ValueError:
        return
    if not isinstance(msg, dict):
        return
    if msg.get("tool") is True:
        client.tool = True
    if msg.get("tool_left") is True and client.tool and client.pid:
        tool_gone(client.pid)
    h = msg.get("keyboard_height")
    if isinstance(h, int) and not isinstance(h, bool) and h >= 0:
        # The keyboard window is there: mark it if that has not happened yet.
        if not STATE.overlay_marked:
            mark_keyboard_overlay(quiet=True)
        set_keyboard_height(h)


def set_keyboard_height(h: int) -> None:
    """The key panel's height, as Keyboard.qml reports it."""
    if h == STATE.keyboard_height:
        return
    STATE.keyboard_height = h
    apply_inset()
    publish("keyd")


def start_events() -> socket.socket:
    """The event stream's socket, in a folder only we may enter."""
    folder = os.path.dirname(EVENTS_SOCKET)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    os.chmod(folder, 0o700)
    try:
        os.unlink(EVENTS_SOCKET)  # left by an earlier run
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(EVENTS_SOCKET)
    os.chmod(EVENTS_SOCKET, 0o600)
    srv.listen(16)
    srv.setblocking(False)

    def accept(_fd, _cond) -> bool:
        while True:
            try:
                conn, _ = srv.accept()
            except BlockingIOError:
                return True
            except OSError as err:
                log(f"event stream: {err}")
                return True
            conn.setblocking(False)
            client = EventClient(conn)
            EVENTS.clients.append(client)
            with EVENTS.lock:
                answers = dict(EVENTS.answers)
            client.send_changed(answers)  # the snapshot, every topic in TOPICS' order
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, srv.fileno(), GLib.IOCondition.IN, accept)
    return srv


def watch_config() -> list:
    """The user apps (installed or removed by barry-app too, without asking
    here) and the home screen's order (the Barry Launcher plugin, barry_apps):
    file monitors on their folders. The monitors, to keep."""
    os.makedirs(barry_apps.APPS_DIR, exist_ok=True)  # GLib would poll for a missing one
    os.makedirs(os.path.dirname(HOME_LAYOUT), exist_ok=True)
    layout = os.path.basename(HOME_LAYOUT)

    def config_changed(_monitor, file, other, _event) -> None:
        if layout in (file.get_basename(), other.get_basename() if other else None):
            publish("apps")
    # An install or update is several steps (barry_apps: a hidden folder,
    # the old version moved out, the new one in): taken in once they have
    # settled, read anew (the folder's time may not have moved on).
    settle = [0]

    def apps_settled() -> bool:
        settle[0] = 0
        refresh_user_apps(force=True)
        return False

    def apps_changed(_monitor, _file, _other, _event) -> None:
        if settle[0]:
            GLib.source_remove(settle[0])
        settle[0] = GLib.timeout_add(APPS_SETTLE_MS, apps_settled)
    apps = Gio.File.new_for_path(barry_apps.APPS_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
    apps.connect("changed", apps_changed)
    config = Gio.File.new_for_path(os.path.dirname(HOME_LAYOUT)).monitor_directory(
        Gio.FileMonitorFlags.WATCH_MOVES, None)
    config.connect("changed", config_changed)
    return [apps, config]


def start_desktop() -> None:
    """Desktop Mode: KWin's window placement. (KWin's input method and the
    presses that count as touches are barry_launcher_keyd's.)"""
    def place() -> bool:
        if barry_desktop.place_windows():
            log("KWin places Barry's windows on " + barry_desktop.OUTPUT)
            return False
        return True  # KWin not ready yet: again shortly
    if place():
        GLib.timeout_add(1000, place)


def main() -> None:
    # Every topic's answer before anyone may ask.
    refresh_user_apps(force=True)
    publish(*TOPICS)
    events = start_events()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    # Its own thread, so a busy main loop (an app's window searched for)
    # never holds a request up; waiting for connections, not looking for
    # them every half second (nothing here shuts it down).
    threading.Thread(target=srv.serve_forever, kwargs={"poll_interval": None}, daemon=True).start()
    setup_bundled_apps()
    monitors = watch_config()
    refresh_user_apps()
    publish("apps")  # Dino's place moved
    Atspi.init()  # page_shown reads Firefox's page; text focus is barry_launcher_keyd's
    threading.Thread(target=watch_touches, daemon=True).start()
    if DESKTOP:
        start_desktop()
    apply_inset()  # no inset left over from before a restart
    threading.Thread(target=warm_apps, daemon=True).start()
    threading.Thread(target=load_dictionary, daemon=True).start()
    # Barry opens and closes (sm8550-thor-backlightd's AYN press).
    barry_monitor = None
    if not DESKTOP:
        write_barry_flag(False)  # closed at start, as the shell starts
        barry_monitor = Gio.File.new_for_path(BARRY_FLAG).monitor_file(Gio.FileMonitorFlags.NONE, None)
        barry_monitor.connect("changed", on_barry_flag)
    write_top_input()
    if not DESKTOP:
        watch_keyboard_window()
    # Apps in the background: scopes to freeze them in, memory pressure.
    threading.Thread(target=scope_probe, daemon=True).start()
    watch_pressure()

    def ended(signum: int) -> bool:
        # Frozen apps are thawed on the way out: the SIGTERM they get as
        # their scopes stop with this service would wait until they were.
        thaw_all("Barry Launcher stops")
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
        return False
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signum, ended, signum)
    Atspi.event_main()
    del events, monitors, barry_monitor


if __name__ == "__main__":
    main()
