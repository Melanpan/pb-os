 /* returns the HWND for the X11 window, or the desktop window if it isn't a Wine window */
+/* Proton PB-OS: whether an X window is one of Steam's own (Quick Access, the
+ * Steam menu, the keyboard; WM_CLASS "steam"/"Steam"), see focus_out(). */
+static BOOL window_is_steam( Display *display, Window window )
+{
+    XClassHint hint;
+    BOOL ret = FALSE;
+
+    if (!window || window == root_window) return FALSE;
+    hint.res_name = hint.res_class = NULL;
+    if (XGetClassHint( display, window, &hint ))
+    {
+        ret = hint.res_class && (!strcmp( hint.res_class, "steam" ) || !strcmp( hint.res_class, "Steam" ));
+        if (hint.res_name) XFree( hint.res_name );
+        if (hint.res_class) XFree( hint.res_class );
+    }
+    return ret;
+}
