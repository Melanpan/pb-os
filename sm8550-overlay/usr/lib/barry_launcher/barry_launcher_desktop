#!/bin/bash
# barry_launcher_desktop: Barry Launcher on the AYN Thor's bottom screen in
# Desktop Mode (Plasma on Wayland): the same home screen, apps and keyboard
# as in Game Mode, with KWin in the place of the bottom screen's gamescope
# (barry_desktop.py). Barry's keyboard is KWin's input method
# (barry_launcher_imd) instead of Plasma's own.
# Started with the Plasma session (barry_launcher_desktop.service); from the
# applications menu, with Barry already running, it goes Home, and with
# Barry turned off in Desktop Mode (barry_launcher_desktop_switch, PB-OS
# Tools) it turns it on again.
grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible 2>/dev/null || exit 0
switch=/usr/lib/barry_launcher/barry_launcher_desktop_switch
# Run by its unit or from the menu: the cgroup says which (a menu start may
# carry plasmashell's unit environment).
in_unit=false
[[ "$(cat /proc/self/cgroup 2>/dev/null)" == */barry_launcher_desktop.service ]] && in_unit=true
if [[ "$(kreadconfig6 --file barry_launcherrc --group Desktop --key Enabled --default true)" == false ]]; then
  $in_unit && exec "$switch" settle
  exec "$switch" on >/dev/null
fi
api=http://127.0.0.1:47824
if curl -fs -X POST -H "Content-Type: application/json" -d "{}" "$api/home" >/dev/null 2>&1; then
  exit 0
fi
# Barry runs in its unit, so that turning it off stops all of it.
if ! $in_unit; then
  exec systemctl --user start barry_launcher_desktop.service
fi
# The bottom touchscreen is KWin's: Barry's trackpad takes it while open and
# could not give it back if the session ended meanwhile, which KWin then
# keeps across logins (kcminputrc), leaving Barry deaf to touch.
for name in /sys/class/input/event*/device/name; do
  if [[ "$(cat "$name" 2>/dev/null)" == bottom_touchscreen ]]; then
    ev="${name#/sys/class/input/}"
    busctl --user set-property org.kde.KWin "/org/kde/KWin/InputDevice/${ev%%/*}" \
      org.kde.KWin.InputDevice enabled b true >/dev/null 2>&1 || true
  fi
done
# KWin starts its input method at login, so on the first run it is still
# Plasma's: --notify makes KWin switch to Barry's at once.
im=/usr/share/applications/org.barry_launcher.keyboard.desktop
if [[ "$(kreadconfig6 --file kwinrc --group Wayland --key InputMethod)" != "$im" ]]; then
  kwriteconfig6 --notify --file kwinrc --group Wayland --key VirtualKeyboardEnabled true
  kwriteconfig6 --notify --file kwinrc --group Wayland --key InputMethod "$im"
fi
# Barry's keyboard, trackpad and top-screen keyboard are Wayland windows
# (proper multitouch) that must never take focus from the field or window
# they type into: a KWin rule says so, next to any rules already there.
rule=barry-launcher-nofocus
rules="$(kreadconfig6 --file kwinrulesrc --group General --key rules)"
if [[ ",$rules," != *",$rule,"* ]]; then
  rules="${rules:+$rules,}$rule"
  kwriteconfig6 --file kwinrulesrc --group General --key rules "$rules"
  kwriteconfig6 --file kwinrulesrc --group General --key count "$(tr , "\n" <<<"$rules" | grep -c .)"
fi
kwriteconfig6 --file kwinrulesrc --group "$rule" --key Description "Barry Launcher: keyboard, trackpad and Deck windows never take focus"
kwriteconfig6 --file kwinrulesrc --group "$rule" --key title "^Barry Launcher (Keyboard|Trackpad|Top Keyboard|Deck)$"
kwriteconfig6 --file kwinrulesrc --group "$rule" --key titlematch 3
kwriteconfig6 --file kwinrulesrc --group "$rule" --key acceptfocus false
kwriteconfig6 --file kwinrulesrc --group "$rule" --key acceptfocusrule 2
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
# The output's position and size: "x y w h".
geometry() {
  kscreen-doctor -o 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g' \
    | awk -v o="$1" '$1 == "Output:" { n = $3 } n == o && $1 == "Geometry:" { print $2, $3; exit }' \
    | sed -E 's/^(-?[0-9]+),(-?[0-9]+) ([0-9]+)x([0-9]+)$/\1 \2 \3 \4/'
}
# The bottom screen sits right under the top one, centered (1536x864 over
# 992x864 at 125 % puts it at 272,864). The position comes from both
# screens' sizes, so it follows their scale. Run again once
# thorch-display-setup has set the layout at login.
under_layout() {
  local tx ty tw th bw
  read -r tx ty tw th <<<"$(geometry DSI-2)"
  read -r _ _ bw _ <<<"$(geometry DSI-1)"
  [[ -n "$th" && -n "$bw" ]] || return 0
  kscreen-doctor "output.DSI-1.position.$((tx + (tw - bw) / 2)),$((ty + th))" >/dev/null 2>&1
}
# Plasma puts its panel (taskbar) on screen 0, the first output in KWin's
# order, and moves it when that order changes. The shipped layout makes the
# top screen (DSI-2) first, but a kwinoutputconfig.json saved by an older
# install can have the bottom one first, which puts the taskbar under Barry
# (pb-os issue #2). Make the top screen first whenever it is not.
top_screen_first() {
  local prio
  prio="$(kscreen-doctor -o 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g' \
    | awk '$1 == "Output:" { o = $3 } o == "DSI-2" && $1 == "priority" { print $2; exit }')"
  [[ -n "$prio" && "$prio" != 1 ]] || return 0
  kscreen-doctor output.DSI-2.priority.1 output.DSI-1.priority.2 >/dev/null 2>&1
}
under_layout
top_screen_first
(sleep 6; under_layout; top_screen_first) &
export BARRY_DESKTOP=1 BARRY_OUTPUT="${BARRY_OUTPUT:-DSI-1}"
shell_qml=/usr/share/barry_launcher/shell
/usr/lib/barry_launcher/barry_launcher_shelld &
# When the keyboards come up (KWin's input method, text focus, touches).
/usr/lib/barry_launcher/barry_launcher_keyd &
# "desktop": no game art (Game Mode's standby, Shell.qml).
QT_QPA_PLATFORM=wayland qml6 "$shell_qml/Shell.qml" -- desktop &
sleep 1  # home first, so it stays under the apps
QT_QPA_PLATFORM=wayland qml6 "$shell_qml/Keyboard.qml" -- desktop &
wait
