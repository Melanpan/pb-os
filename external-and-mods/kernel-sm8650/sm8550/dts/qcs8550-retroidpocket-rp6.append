
/*
 * The RP6's own ADSP and speaker tuning (sm8550/firmware/.../rp6), not AYN
 * Odin 2's: Odin 2's ADSP holds an 8000 mAh battery profile, the RP6 has a
 * 6000 mAh cell. With Retroid's ADSP the amps take stock Android's channel
 * numbering: 0x34 is channel 1, 0x35 is channel 0 (left and right swap
 * otherwise, as on the Nova). The Nova includes this file and its own
 * .append overrides these paths afterwards.
 */
&remoteproc_adsp {
	firmware-name = "qcom/sm8550/retroidpocket/rp6/adsp.mbn",
			"qcom/sm8550/retroidpocket/rp6/adsp_dtb.mbn";
};

&spk_amp_l {
	firmware-name = "qcom/sm8550/retroidpocket/rp6/aw883xx_acf.bin";
	awinic,audio-channel = <1>;
};

&spk_amp_r {
	firmware-name = "qcom/sm8550/retroidpocket/rp6/aw883xx_acf.bin";
	awinic,audio-channel = <0>;
};

/*
 * The body vibration motor is an LRA, driven like stock Android does it
 * (Retroid's DT: no ERM mode, 1300 mV). AYN-common's ERM setup at 5000 mV
 * left it almost still while pushing far more voltage than stock.
 */
&pm8550b_hv_haptics {
	/delete-property/ qcom,use-erm;
	qcom,vmax-mv = <1300>;
};

/*
 * Motion sensors (QMI8658 accelerometer and gyroscope) through the ADSP's
 * sensor hub, as on the AYN Thor (same ADSP build family, 01329): remote
 * heap, sensors-PD restart tracking and the FastRPC context banks' process
 * types (patch 0560).
 */
/ {
	reserved-memory {
		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
			alignment = <0x0 0x400000>;
			size = <0x0 0xc00000>;
			reusable;
		};
	};
};

&remoteproc_adsp {
	glink-edge {
		fastrpc {
			memory-region = <&adsp_rpc_remote_heap_mem>;
			qcom,fastrpc-adsp-sensors-pdr;
			qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;

			compute-cb@3 {
				qcom,pd-type = <1>;
			};

			compute-cb@4 {
				qcom,pd-type = <2>;
			};

			compute-cb@5 {
				qcom,nsessions = <8>;
				qcom,pd-type = <3>;
			};

			compute-cb@6 {
				qcom,pd-type = <7>;
			};

			compute-cb@7 {
				qcom,pd-type = <7>;
			};
		};
	};
};
