From fe2f4436dfcf9fc895492a4a4a0a88d674224d81 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 13 Oct 2026 07:54:24 +0000
Subject: [PATCH 04/71] drm/panel: visionox-vtdr6130: move the panel data into
 a descriptor

Other panels built on the VTDR6130 driver IC use different supplies,
modes, DSC parameters and init sequences. Move everything that is
specific to the current panel into a descriptor selected by the
compatible, so further panels can be added as data.

No functional change.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../gpu/drm/panel/panel-visionox-vtdr6130.c   | 131 ++++++++++++------
 1 file changed, 86 insertions(+), 45 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
index 6733e0e1d..934da37b0 100644
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130.c
@@ -16,8 +16,22 @@
 
 #include <video/mipi_display.h>
 
+struct visionox_vtdr6130;
+
+struct visionox_vtdr6130_desc {
+	const struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
+	const struct drm_display_mode *modes;
+	unsigned int num_modes;
+	unsigned long mode_flags;
+	const struct drm_dsc_config *dsc;
+	unsigned int reset_delay_ms;
+	int (*on)(struct visionox_vtdr6130 *ctx);
+};
+
 struct visionox_vtdr6130 {
 	struct drm_panel panel;
+	const struct visionox_vtdr6130_desc *desc;
 	struct drm_dsc_config dsc;
 	struct mipi_dsi_device *dsi;
 	struct gpio_desc *reset_gpio;
@@ -37,12 +51,14 @@ static inline struct visionox_vtdr6130 *to_visionox_vtdr6130(struct drm_panel *p
 
 static void visionox_vtdr6130_reset(struct visionox_vtdr6130 *ctx)
 {
+	unsigned int delay = ctx->desc->reset_delay_ms * 1000;
+
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
-	usleep_range(10000, 11000);
+	usleep_range(delay, delay + 1000);
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	usleep_range(10000, 11000);
+	usleep_range(delay, delay + 1000);
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
-	usleep_range(10000, 11000);
+	usleep_range(delay, delay + 1000);
 }
 
 static int visionox_vtdr6130_on(struct visionox_vtdr6130 *ctx)
@@ -153,18 +169,16 @@ static int visionox_vtdr6130_prepare(struct drm_panel *panel)
 	struct visionox_vtdr6130 *ctx = to_visionox_vtdr6130(panel);
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(visionox_vtdr6130_supplies),
-				    ctx->supplies);
+	ret = regulator_bulk_enable(ctx->desc->num_supplies, ctx->supplies);
 	if (ret < 0)
 		return ret;
 
 	visionox_vtdr6130_reset(ctx);
 
-	ret = visionox_vtdr6130_on(ctx);
+	ret = ctx->desc->on(ctx);
 	if (ret < 0) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		regulator_bulk_disable(ARRAY_SIZE(visionox_vtdr6130_supplies),
-				       ctx->supplies);
+		regulator_bulk_disable(ctx->desc->num_supplies, ctx->supplies);
 		return ret;
 	}
 
@@ -179,43 +193,52 @@ static int visionox_vtdr6130_unprepare(struct drm_panel *panel)
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 
-	regulator_bulk_disable(ARRAY_SIZE(visionox_vtdr6130_supplies),
-			       ctx->supplies);
+	regulator_bulk_disable(ctx->desc->num_supplies, ctx->supplies);
 
 	return 0;
 }
 
-static const struct drm_display_mode visionox_vtdr6130_mode = {
-	.clock = (1080 + 20 + 2 + 20) * (2400 + 20 + 2 + 18) * 144 / 1000,
-	.hdisplay = 1080,
-	.hsync_start = 1080 + 20,
-	.hsync_end = 1080 + 20 + 2,
-	.htotal = 1080 + 20 + 2 + 20,
-	.vdisplay = 2400,
-	.vsync_start = 2400 + 20,
-	.vsync_end = 2400 + 20 + 2,
-	.vtotal = 2400 + 20 + 2 + 18,
-	.width_mm = 71,
-	.height_mm = 157,
+static const struct drm_display_mode visionox_vtdr6130_modes[] = {
+	{
+		.clock = (1080 + 20 + 2 + 20) * (2400 + 20 + 2 + 18) * 144 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 20,
+		.hsync_end = 1080 + 20 + 2,
+		.htotal = 1080 + 20 + 2 + 20,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 20,
+		.vsync_end = 2400 + 20 + 2,
+		.vtotal = 2400 + 20 + 2 + 18,
+		.width_mm = 71,
+		.height_mm = 157,
+	},
 };
 
 static int visionox_vtdr6130_get_modes(struct drm_panel *panel,
 				       struct drm_connector *connector)
 {
+	struct visionox_vtdr6130 *ctx = to_visionox_vtdr6130(panel);
 	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < ctx->desc->num_modes; i++) {
+		mode = drm_mode_duplicate(connector->dev, &ctx->desc->modes[i]);
+		if (!mode)
+			return -ENOMEM;
 
-	mode = drm_mode_duplicate(connector->dev, &visionox_vtdr6130_mode);
-	if (!mode)
-		return -ENOMEM;
+		drm_mode_set_name(mode);
 
-	drm_mode_set_name(mode);
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
 
-	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
-	connector->display_info.width_mm = mode->width_mm;
-	connector->display_info.height_mm = mode->height_mm;
-	drm_mode_probed_add(connector, mode);
+		drm_mode_probed_add(connector, mode);
+	}
 
-	return 1;
+	connector->display_info.width_mm = ctx->desc->modes[0].width_mm;
+	connector->display_info.height_mm = ctx->desc->modes[0].height_mm;
+
+	return ctx->desc->num_modes;
 }
 
 static const struct drm_panel_funcs visionox_vtdr6130_panel_funcs = {
@@ -250,6 +273,29 @@ visionox_vtdr6130_create_backlight(struct mipi_dsi_device *dsi)
 					      &visionox_vtdr6130_bl_ops, &props);
 }
 
+static const struct drm_dsc_config visionox_vtdr6130_dsc = {
+	.dsc_version_major = 0x1,
+	.dsc_version_minor = 0x2,
+	.slice_height = 40,
+	.slice_width = 540,
+	.slice_count = 2,
+	.bits_per_component = 8,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+static const struct visionox_vtdr6130_desc visionox_vtdr6130_desc = {
+	.supplies = visionox_vtdr6130_supplies,
+	.num_supplies = ARRAY_SIZE(visionox_vtdr6130_supplies),
+	.modes = visionox_vtdr6130_modes,
+	.num_modes = ARRAY_SIZE(visionox_vtdr6130_modes),
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.dsc = &visionox_vtdr6130_dsc,
+	.reset_delay_ms = 10,
+	.on = visionox_vtdr6130_on,
+};
+
 static int visionox_vtdr6130_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -262,9 +308,12 @@ static int visionox_vtdr6130_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(ctx))
 		return PTR_ERR(ctx);
 
-	ret = devm_regulator_bulk_get_const(&dsi->dev,
-					    ARRAY_SIZE(visionox_vtdr6130_supplies),
-					    visionox_vtdr6130_supplies,
+	ctx->desc = of_device_get_match_data(dev);
+	if (!ctx->desc)
+		return -ENODEV;
+
+	ret = devm_regulator_bulk_get_const(&dsi->dev, ctx->desc->num_supplies,
+					    ctx->desc->supplies,
 					    &ctx->supplies);
 	if (ret < 0)
 		return ret;
@@ -277,20 +326,12 @@ static int visionox_vtdr6130_probe(struct mipi_dsi_device *dsi)
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
-	ctx->dsc.dsc_version_major = 0x1;
-	ctx->dsc.dsc_version_minor = 0x2;
-	ctx->dsc.slice_height = 40;
-	ctx->dsc.slice_width = 540;
-	ctx->dsc.slice_count = 2;
-	ctx->dsc.bits_per_component = 8;
-	ctx->dsc.bits_per_pixel = 8 << 4;
-	ctx->dsc.block_pred_enable = true;
+	ctx->dsc = *ctx->desc->dsc;
 
 	dsi->dsc = &ctx->dsc;
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_NO_EOT_PACKET |
-			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	dsi->mode_flags = ctx->desc->mode_flags;
 	ctx->panel.prepare_prev_first = true;
 
 	ctx->panel.backlight = visionox_vtdr6130_create_backlight(dsi);
@@ -306,7 +347,7 @@ static int visionox_vtdr6130_probe(struct mipi_dsi_device *dsi)
 }
 
 static const struct of_device_id visionox_vtdr6130_of_match[] = {
-	{ .compatible = "visionox,vtdr6130" },
+	{ .compatible = "visionox,vtdr6130", .data = &visionox_vtdr6130_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, visionox_vtdr6130_of_match);
-- 
2.43.0

