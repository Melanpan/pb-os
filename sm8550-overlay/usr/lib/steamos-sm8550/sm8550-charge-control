#!/usr/bin/env python3
"""sm8550-charge-control — charge limit and bypass charging on the Retroid
Pocket 6 and Nova.

Retroid's battery firmware (on its own ADSP, see sm8550/firmware/.../rp6 and
.../rpnova) has two OEM switches, which kernel patch 0545 exposes on the
battery manager device:

  retroid_charge_now      0 = run from USB power and leave the battery
                          alone ("charge separation", bypass), 1 = charge
  retroid_limit_capacity  1 = the firmware stops charging at 80 %

The firmware doesn't keep them across a reboot, and it may drop them when
the charger is plugged in again or the ADSP restarts, so this daemon holds
the chosen mode (MODES) and writes it again at start, after a wake and on
every charger plug-in. Modes:

  normal   charge to 100 %
  limit80  the firmware's 80 % limit
  hold     charge to HOLD_AT %, then run from USB (Retroid's automatic charge
           separation); charges again once it drops HOLD_GAP below
  bypass   always run from USB; it still charges below BYPASS_FLOOR (until
           BYPASS_FLOOR + HOLD_GAP), so a charger too weak to run the device
           can't drain it flat while plugged in

While the battery is held on purpose, HELD (holding this process's PID)
tells sm8550-charge-rest's charging indicator to show "charged".

On stop both switches go back to the firmware's defaults (charging, no
limit), so an update or a crash never leaves the device unable to charge.

For PB-OS Utils' Power tab: `settings` prints the settings, the ranges and
the live state as JSON; `save JSON` stores changes (merged, held to the
ranges) and tells the running daemon.
"""
from __future__ import annotations

import glob
import json
import os
import signal
import subprocess
import sys
import time

STATE = "/var/lib/pbos-utils/charge-control.json"
HELD = "/run/sm8550-charge-held"
BATTMGR = "/sys/bus/auxiliary/devices/pmic_glink.power-supply.*"
BATTERY = "/sys/class/power_supply/battery"
USB = "/sys/class/power_supply/qcom-battmgr-usb"
MODES = ("normal", "limit80", "hold", "bypass")
DEFAULTS = {"mode": "normal", "hold_at": 80}
HOLD_RANGE = (50, 95)
HOLD_GAP = 3
BYPASS_FLOOR = 15
LIMIT = 80
TICK_S = 10
WAIT_S = 60                      # for the battery manager after boot


def log(msg: str) -> None:
    print(f"sm8550-charge-control: {msg}", flush=True)


def rd(p: str, d: str = "") -> str:
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return d


def wr(p: str, v) -> bool:
    try:
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(str(v))
        return True
    except OSError as exc:
        log(f"write {p}: {exc}")
        return False


def battmgr() -> str | None:
    for d in sorted(glob.glob(BATTMGR)):
        if os.path.exists(f"{d}/retroid_charge_now"):
            return d
    return None


# ------------------------------------------------------------- settings --
def settings() -> dict:
    try:
        with open(STATE, encoding="utf-8") as fh:
            s = {**DEFAULTS, **json.load(fh)}
    except (OSError, ValueError):
        s = dict(DEFAULTS)
    if s.get("mode") not in MODES:
        s["mode"] = DEFAULTS["mode"]
    try:
        s["hold_at"] = max(HOLD_RANGE[0], min(HOLD_RANGE[1], int(s["hold_at"])))
    except (TypeError, ValueError):
        s["hold_at"] = DEFAULTS["hold_at"]
    return {k: s[k] for k in DEFAULTS}


def save(changes: dict) -> dict:
    s = {**settings(), **{k: v for k, v in changes.items() if k in DEFAULTS}}
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(s, fh, indent=2)
    os.replace(STATE + ".tmp", STATE)
    s = settings()
    with open(STATE + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(s, fh, indent=2)
    os.replace(STATE + ".tmp", STATE)
    subprocess.run(["systemctl", "kill", "--signal=HUP", "sm8550-charge-control.service"],
                   capture_output=True)
    return s


def live() -> dict:
    cap = rd(f"{BATTERY}/capacity")
    return {"capacity": int(cap) if cap.isdigit() else None,
            "status": rd(f"{BATTERY}/status"),
            "plugged": rd(f"{USB}/online") == "1",
            "held": held_by_us()}


def held_by_us() -> bool:
    pid = rd(HELD)
    return pid.isdigit() and os.path.exists(f"/proc/{pid}")


def report(s: dict) -> dict:
    return {"supported": battmgr() is not None, "settings": s,
            "limits": {"hold_at": list(HOLD_RANGE), "limit": LIMIT, "bypass_floor": BYPASS_FLOOR,
                       "defaults": DEFAULTS},
            "state": live()}


# --------------------------------------------------------------- daemon --
def _stop(*_) -> None:
    raise SystemExit(0)


class Daemon:
    def __init__(self, dev: str):
        self.dev = dev
        self.s = settings()
        self.charge = None       # last values written (None = write again)
        self.limit = None
        self.plugged = None
        self.wanted_charge = 1   # hysteresis memory for hold/bypass
        self.reload = False

    def want(self, cap: int | None) -> tuple[int, int]:
        """(charge_now, limit_capacity) for the mode and battery level."""
        mode = self.s["mode"]
        if mode == "normal":
            return 1, 0
        if mode == "limit80":
            return 1, 1
        if cap is None:
            return 1, 0
        if mode == "hold":
            stop, resume = self.s["hold_at"], self.s["hold_at"] - HOLD_GAP
            if cap >= stop:
                self.wanted_charge = 0
            elif cap <= resume:
                self.wanted_charge = 1
        else:                    # bypass, with a floor
            if cap <= BYPASS_FLOOR:
                self.wanted_charge = 1
            elif cap >= BYPASS_FLOOR + HOLD_GAP:
                self.wanted_charge = 0
        return self.wanted_charge, 0

    def apply(self, force: bool) -> None:
        cap_s = rd(f"{BATTERY}/capacity")
        cap = int(cap_s) if cap_s.isdigit() else None
        plugged = rd(f"{USB}/online") == "1"
        if plugged and not self.plugged:
            force = True         # firmware may have dropped the switches
        self.plugged = plugged
        charge, limit = self.want(cap)
        if force or limit != self.limit:
            if wr(f"{self.dev}/retroid_limit_capacity", limit):
                if limit != self.limit:
                    log(f"80 % limit {'on' if limit else 'off'} at {cap} %")
                self.limit = limit
        if force or charge != self.charge:
            if wr(f"{self.dev}/retroid_charge_now", charge):
                if charge != self.charge:
                    log(f"{'charging allowed' if charge else 'running from USB'} at {cap} %")
                self.charge = charge
        held = plugged and cap is not None and (
            charge == 0 or (limit == 1 and cap >= LIMIT - 1))
        if held:
            if not held_by_us():
                wr(HELD, os.getpid())
        elif os.path.exists(HELD):
            try:
                os.remove(HELD)
            except OSError:
                pass

    def restore(self) -> None:
        wr(f"{self.dev}/retroid_limit_capacity", 0)
        wr(f"{self.dev}/retroid_charge_now", 1)
        try:
            os.remove(HELD)
        except OSError:
            pass

    def run(self) -> int:
        signal.signal(signal.SIGHUP, lambda *_: setattr(self, "reload", True))
        signal.signal(signal.SIGTERM, _stop)
        log(f"mode {self.s['mode']}" + (f" at {self.s['hold_at']} %" if self.s["mode"] == "hold" else ""))
        gap = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
        force = True
        try:
            while True:
                if self.reload:
                    self.reload = False
                    self.s = settings()
                    self.wanted_charge = 1
                    log(f"mode {self.s['mode']}" + (f" at {self.s['hold_at']} %" if self.s["mode"] == "hold" else ""))
                    force = True
                # BOOTTIME runs on through suspend, MONOTONIC doesn't: a
                # growing gap means the device slept since the last tick.
                g = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
                if g - gap > 1:
                    force = True
                gap = g
                self.apply(force)
                force = False
                for _ in range(TICK_S * 2):
                    if self.reload:
                        break
                    time.sleep(0.5)
        finally:
            self.restore()


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "settings":
        print(json.dumps(report(settings())))
        return 0
    if cmd == "save" and len(sys.argv) > 2:
        try:
            changes = json.loads(sys.argv[2])
        except ValueError:
            changes = None
        if not isinstance(changes, dict):
            print("save: expected a JSON object", file=sys.stderr)
            return 2
        print(json.dumps(report(save(changes))))
        return 0
    if cmd:
        print("usage: sm8550-charge-control [settings | save JSON]", file=sys.stderr)
        return 2
    dev = None
    for _ in range(WAIT_S):
        dev = battmgr()
        if dev:
            break
        time.sleep(1)
    if not dev:
        log("no Retroid charge controls (kernel patch 0545 / Retroid firmware): nothing to do")
        return 0
    return Daemon(dev).run()


if __name__ == "__main__":
    sys.exit(main())
