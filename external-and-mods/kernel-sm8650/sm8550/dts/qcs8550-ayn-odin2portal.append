
/*
 * From Armada (armada-os/armada, packages/kernel/dts/
 * qcs8550-ayn-odin2portal.dts.patch): the Odin 2 Portal has the Odin 2's back
 * buttons M1/M2 on TLMM GPIO 57/58, which ROCKNIX's Portal DTS leaves out.
 * Same gpio-keys-paddles device as the Odin 2 (BTN_Z / BTN_C), which the
 * ayn_mcu* InputPlumber maps take as the left/right paddles.
 */
&tlmm {
	paddle_keys_default: paddle-keys-default-state {
		pins = "gpio57", "gpio58";
		function = "gpio";
		bias-pull-up;
		drive-strength = <2>;
	};
};

/ {
	gpio-keys-paddles {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&paddle_keys_default>;

		key-paddle-m1 {
			label = "Back Paddle M1";
			linux,code = <BTN_Z>;
			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};

		key-paddle-m2 {
			label = "Back Paddle M2";
			linux,code = <BTN_C>;
			gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};
	};
};

/*
 * Stock AYN settings (factory DT, KalamaP HDK overlay, same on the Odin 2,
 * Odin 2 Portal and Odin 2 Mini): the haptics base voltage is 3200 mV (the
 * per-effect voltages already match AYN-common), and the fan PWM period is
 * 50 us. AYN-common, which the Thor shares, has 5000 mV and 40 us.
 */
&pm8550b_hv_haptics {
	qcom,vmax-mv = <3200>;
};

&pwm_fan {
	pwms = <&pm8550_pwm 3 50000>;
};
