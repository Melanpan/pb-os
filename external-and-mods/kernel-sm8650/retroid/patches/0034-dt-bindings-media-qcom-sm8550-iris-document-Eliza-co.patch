From 64651c250ba17d078f97837fa033c86d08c09e42 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Wed, 9 Sep 2026 17:54:40 +0700
Subject: [PATCH 34/71] dt-bindings: media: qcom,sm8550-iris: document Eliza
 compatible

Eliza carries the same Iris 3.3 video core as SM8650, with two VPP
pipes instead of four. The block differs from SM8650 in two ways that
the binding needs to express: it has an additional MVS0 core reset
("vcodec0_core"), so four resets are required, and the video clock
controller sits on the plain MX/CX rails instead of MXC/MMCX, so the
OPP power domains are named "mx" and "cx".

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../bindings/media/qcom,sm8550-iris.yaml      | 44 +++++++++++++++++--
 1 file changed, 40 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/qcom,sm8550-iris.yaml b/Documentation/devicetree/bindings/media/qcom,sm8550-iris.yaml
index 0400ca1bf..a01ecfc8a 100644
--- a/Documentation/devicetree/bindings/media/qcom,sm8550-iris.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,sm8550-iris.yaml
@@ -23,6 +23,7 @@ properties:
               - qcom,x1e80100-iris
           - const: qcom,sm8550-iris
       - enum:
+          - qcom,eliza-iris
           - qcom,qcs8300-iris
           - qcom,sm8550-iris
           - qcom,sm8650-iris
@@ -38,8 +39,8 @@ properties:
     items:
       - const: venus
       - const: vcodec0
-      - const: mxc
-      - const: mmcx
+      - enum: [ mxc, mx ]
+      - enum: [ mmcx, cx ]
 
   clocks:
     minItems: 3
@@ -69,7 +70,7 @@ properties:
 
   resets:
     minItems: 1
-    maxItems: 3
+    maxItems: 4
 
   reset-names:
     minItems: 1
@@ -77,6 +78,7 @@ properties:
       - const: bus
       - const: xo
       - const: core
+      - const: vcodec0_core
 
   iommus:
     maxItems: 2
@@ -102,6 +104,31 @@ required:
   - dma-coherent
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          enum:
+            - qcom,eliza-iris
+    then:
+      properties:
+        resets:
+          minItems: 4
+        reset-names:
+          minItems: 4
+        power-domain-names:
+          items:
+            - const: venus
+            - const: vcodec0
+            - const: mx
+            - const: cx
+    else:
+      properties:
+        power-domain-names:
+          items:
+            - const: venus
+            - const: vcodec0
+            - const: mxc
+            - const: mmcx
   - if:
       properties:
         compatible:
@@ -111,9 +138,18 @@ allOf:
       properties:
         resets:
           minItems: 3
+          maxItems: 3
         reset-names:
           minItems: 3
-    else:
+          maxItems: 3
+  - if:
+      properties:
+        compatible:
+          enum:
+            - qcom,qcs8300-iris
+            - qcom,sm8550-iris
+            - qcom,x1p42100-iris
+    then:
       properties:
         resets:
           maxItems: 1
-- 
