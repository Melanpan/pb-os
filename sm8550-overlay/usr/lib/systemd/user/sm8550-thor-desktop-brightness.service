[Unit]
Description=AYN Thor: Plasma's brightness sliders share each screen's brightness with Game Mode
PartOf=graphical-session.target
After=plasma-powerdevil.service

[Service]
ExecCondition=/bin/sh -c 'grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/steamos-sm8550/sm8550-thor-desktop-brightness
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
