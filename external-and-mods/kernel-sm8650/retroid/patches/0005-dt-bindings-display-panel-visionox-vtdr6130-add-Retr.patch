From e27a784b5dd4ef8c3986b3ee200a38c4be130aac Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 13 Oct 2026 07:54:24 +0000
Subject: [PATCH 05/71] dt-bindings: display: panel: visionox,vtdr6130: add
 RetroidPocket panels

The RetroidPocket RP6 and the top display of the RetroidPocket Duo use
1080x1920 AMOLED panels driven by the VTDR6130, with two more supplies
than the reference panel. Add their compatibles and allow the extra
supplies for them.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../display/panel/visionox,vtdr6130.yaml      | 27 ++++++++++++++++---
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/panel/visionox,vtdr6130.yaml b/Documentation/devicetree/bindings/display/panel/visionox,vtdr6130.yaml
index c99f4146f..f2646dca5 100644
--- a/Documentation/devicetree/bindings/display/panel/visionox,vtdr6130.yaml
+++ b/Documentation/devicetree/bindings/display/panel/visionox,vtdr6130.yaml
@@ -9,12 +9,14 @@ title: Visionox VTDR6130 AMOLED DSI Panel
 maintainers:
   - Neil Armstrong <neil.armstrong@linaro.org>
 
-allOf:
-  - $ref: panel-common.yaml#
-
 properties:
   compatible:
-    const: visionox,vtdr6130
+    oneOf:
+      - const: visionox,vtdr6130
+      - description: RetroidPocket panels with the VTDR6130 driver IC
+        enum:
+          - retroidpocket,rp6-panel
+          - retroidpocket,rpduo-panel-top
 
   reg:
     maxItems: 1
@@ -23,8 +25,13 @@ properties:
   vddio-supply: true
   vci-supply: true
   vdd-supply: true
+  vdd18-supply:
+    description: 1.8V supply of the panel module
+  vdd28-supply:
+    description: 2.8V supply of the panel module
   port: true
   reset-gpios: true
+  rotation: true
 
 required:
   - compatible
@@ -35,6 +42,18 @@ required:
   - reset-gpios
   - port
 
+allOf:
+  - $ref: panel-common.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: visionox,vtdr6130
+    then:
+      properties:
+        vdd18-supply: false
+        vdd28-supply: false
+
 additionalProperties: false
 
 examples:
-- 
2.43.0

