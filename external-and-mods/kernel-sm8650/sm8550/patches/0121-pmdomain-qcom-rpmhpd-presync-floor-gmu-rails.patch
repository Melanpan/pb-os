Taken from Armada (armada-os/armada@939fb84, packages/kernel/patches/0121-pmdomain-qcom-rpmhpd-presync-floor-gmu-rails.patch),
which takes it from ROCKNIX commit ef264a23 ("sm8550/sm8750: fix gx clock issues").
Replaces the older ROCKNIX 20260801 version (see ../rocknix-skip).
Rebased for Linux 7.1.2: the gfx_gmu hunk is anchored on `lcx` (7.2 has a
`gfx1` domain there). The code it adds is unchanged.

From: ROCKNIX <noreply@rocknix.org>
Subject: [PATCH] pmdomain: qcom: rpmhpd: floor GMU managed rails low pre sync_state

Floor gfx/gmxc at their lowest functional corner until sync_state
instead: low enough for ACD to calibrate against real levels, alive
enough for the GMU's first ramp. Skip the retention level so the
floor is a corner logic can run at.

[Modified: Armada scopes the flags to dedicated SM8550/SM8750
descriptors so other Qualcomm SoCs keep stock clamp behavior.]

Rebased for Linux 7.3: 7.3 skips the retention level for every power
domain and dropped skip_retention_level, so this keeps only presync_floor.
---
diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index 907432759..6b6f85946 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -41,6 +41,7 @@
  * @addr:		Resource address as looped up using resource name from
  *			cmd-db
  * @state_synced:	Indicator that sync_state has been invoked for the rpmhpd resource
+ * @presync_floor:	Clamp to the lowest functional corner instead of the highest before sync_state
  */
 struct rpmhpd {
 	struct device	*dev;
@@ -57,6 +58,7 @@ struct rpmhpd {
 	const char	*res_name;
 	u32		addr;
 	bool		state_synced;
+	bool		presync_floor;
 };
 
 struct rpmhpd_desc {
@@ -125,6 +127,12 @@ static struct rpmhpd gfx1 = {
 	.res_name = "gfx1.lvl",
 };
 
+static struct rpmhpd gfx_gmu = {
+	.pd = { .name = "gfx", },
+	.res_name = "gfx.lvl",
+	.presync_floor = true,
+};
+
 static struct rpmhpd lcx = {
 	.pd = { .name = "lcx", },
 	.res_name = "lcx.lvl",
@@ -233,6 +241,12 @@ static struct rpmhpd gmxc = {
 	.res_name = "gmxc.lvl",
 };
 
+static struct rpmhpd gmxc_sm8750 = {
+	.pd = { .name = "gmxc", },
+	.res_name = "gmxc.lvl",
+	.presync_floor = true,
+};
+
 /* Eliza RPMH powerdomains */
 static struct rpmhpd *eliza_rpmhpds[] = {
 	[RPMHPD_CX] = &cx,
@@ -589,7 +603,7 @@ static struct rpmhpd *sm8550_rpmhpds[] = {
 	[RPMHPD_CX] = &cx,
 	[RPMHPD_CX_AO] = &cx_ao,
 	[RPMHPD_EBI] = &ebi,
-	[RPMHPD_GFX] = &gfx,
+	[RPMHPD_GFX] = &gfx_gmu,
 	[RPMHPD_LCX] = &lcx,
 	[RPMHPD_LMX] = &lmx,
 	[RPMHPD_MMCX] = &mmcx_w_cx_parent,
@@ -636,8 +650,8 @@ static struct rpmhpd *sm8750_rpmhpds[] = {
 	[RPMHPD_CX] = &cx,
 	[RPMHPD_CX_AO] = &cx_ao,
 	[RPMHPD_EBI] = &ebi,
-	[RPMHPD_GFX] = &gfx,
-	[RPMHPD_GMXC] = &gmxc,
+	[RPMHPD_GFX] = &gfx_gmu,
+	[RPMHPD_GMXC] = &gmxc_sm8750,
 	[RPMHPD_LCX] = &lcx,
 	[RPMHPD_LMX] = &lmx,
 	[RPMHPD_MX] = &mx,
@@ -967,6 +981,10 @@ static int rpmhpd_aggregate_corner(struct rpmhpd *pd, unsigned int corner)
 
 	if (pd->state_synced) {
 		to_active_sleep(pd, corner, &this_active_corner, &this_sleep_corner);
+	} else if (pd->presync_floor) {
+		/* Keep GMU managed rails alive but low until sync_state */
+		to_active_sleep(pd, max(corner, pd->enable_corner),
+				&this_active_corner, &this_sleep_corner);
 	} else {
 		/* Clamp to highest corner if sync_state hasn't happened */
 		this_active_corner = pd->level_count - 1;
