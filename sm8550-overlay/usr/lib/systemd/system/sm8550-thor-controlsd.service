[Unit]
Description=AYN Thor: fan profile and stick lighting for Barry Launcher's quick controls
After=sm8550-fand.service

[Service]
Type=simple
ExecCondition=/bin/sh -c 'grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --system --only thor-controls
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
