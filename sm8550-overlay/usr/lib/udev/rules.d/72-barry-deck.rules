# Barry Launcher (AYN Thor bottom screen).
#
# The Deck controls' devices (Barry.Input: "Barry Deck Left Pad", "... Right
# Pad", "... Buttons") are InputPlumber's alone: it reads them as part of
# its virtual Steam Deck. Kept from the compositors (the pads would be
# touchscreens to them) and from Steam (the buttons would be a second
# controller) until InputPlumber has grabbed them.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Barry Deck *", \
  ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", MODE="0600"
# The vibration motor, for Barry's haptics (keys, clicks), to the user at
# the seat.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="qcom-hv-haptics", TAG+="uaccess"
