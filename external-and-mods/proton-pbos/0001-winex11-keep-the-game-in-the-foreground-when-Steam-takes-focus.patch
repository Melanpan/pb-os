 /**********************************************************************
+ *              focus_is_steam
+ *
+ * Proton PB-OS: whether X focus is on one of Steam's own windows (Quick
+ * Access, the Steam menu, the keyboard; WM_CLASS "steam"/"Steam"), not a
+ * game's (steam_app_*).
+ */
+static BOOL focus_is_steam( Display *display )
+{
+    Window focus, root, parent, *children;
+    unsigned int count;
+    int revert, depth;
+    XClassHint hint;
+    BOOL ret = FALSE;
+
+    XGetInputFocus( display, &focus, &revert );
+    for (depth = 0; depth < 8 && focus != None && focus != PointerRoot; depth++)
+    {
+        hint.res_name = hint.res_class = NULL;
+        if (XGetClassHint( display, focus, &hint ))
+        {
+            ret = hint.res_class && (!strcmp( hint.res_class, "steam" ) || !strcmp( hint.res_class, "Steam" ));
+            if (hint.res_name) XFree( hint.res_name );
+            if (hint.res_class) XFree( hint.res_class );
+            break;
+        }
+        if (!XQueryTree( display, focus, &root, &parent, &children, &count )) break;
+        if (children) XFree( children );
+        if (parent == root) break;
+        focus = parent;
+    }
+    return ret;
+}
