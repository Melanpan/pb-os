
/* --- SteamOS-ARM-SM8650 additions --------------------------------------- */

/ {
	chassis-type = "handheld";
};

/*
 * Controller MCU UART (geni SE5 @894000). konkr_sysbtn binds here when the
 * module is loaded (it is blacklisted by default — see konkr-mcu).
 */
&uart13 {
	mcu {
		compatible = "konkr,pocket-fit-mcu";
	};
};

/*
 * Adreno 750 top step. Mainline stops at 834 MHz; every Snapdragon 8 Gen 3
 * (and Android on this handheld) runs the A750 at 903 MHz. Corner and ACD
 * level are the ones AYANEO's factory GPU table uses for 903 MHz on this SKU
 * (RPMh TURBO + ACD 0x882a5ffd); TURBO_L1 is only used there for the 950/1000
 * MHz steps of other SKUs. Bus vote kept equal to the 834 MHz step.
 */
&gpu_opp_table {
	opp-903000000 {
		opp-hz = /bits/ 64 <903000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_TURBO>;
		opp-peak-kBps = <14398437>;
		qcom,opp-acd-level = <0x882a5ffd>;
	};
};
