From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] drm/panel: SM8550 ROCKNIX panels: use
 drm_of_get_panel_orientation()

Linux 7.3 renamed of_drm_get_panel_orientation() to drm_of_get_panel_orientation() (declared in <drm/drm_of.h>); the ROCKNIX panel drivers, written for 7.2, still call the old name.
---
 drivers/gpu/drm/panel/panel-ar02-3inch.c            | 3 ++-
 drivers/gpu/drm/panel/panel-ar06-4inch.c            | 3 ++-
 drivers/gpu/drm/panel/panel-ar16-4inch.c            | 3 ++-
 drivers/gpu/drm/panel/panel-boe-xm91080g.c          | 3 ++-
 drivers/gpu/drm/panel/panel-chipone-icna35xx.c      | 3 ++-
 drivers/gpu/drm/panel/panel-ddic-ch13726a.c         | 3 ++-
 drivers/gpu/drm/panel/panel-ilitek-il97680a.c       | 3 ++-
 drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c | 3 ++-
 drivers/gpu/drm/panel/panel-wt0600-1k.c             | 3 ++-
 9 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-ar02-3inch.c b/drivers/gpu/drm/panel/panel-ar02-3inch.c
index 23b4a0124ec9..92ef12cab6ab 100644
--- a/drivers/gpu/drm/panel/panel-ar02-3inch.c
+++ b/drivers/gpu/drm/panel/panel-ar02-3inch.c
@@ -11,6 +11,7 @@
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
@@ -591,7 +592,7 @@ static int ar02_3inch_probe(struct mipi_dsi_device *dsi)
 			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
 
 	/* Orientation */
-	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret < 0) {
 		dev_err(dev, "failed to get orientation %d\n", ret);
 		return ret;
diff --git a/drivers/gpu/drm/panel/panel-ar06-4inch.c b/drivers/gpu/drm/panel/panel-ar06-4inch.c
index 33bba58aa48c..02e68ad7c402 100644
--- a/drivers/gpu/drm/panel/panel-ar06-4inch.c
+++ b/drivers/gpu/drm/panel/panel-ar06-4inch.c
@@ -10,6 +10,7 @@
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
@@ -179,7 +180,7 @@ static int ar06_4inch_probe(struct mipi_dsi_device *dsi)
 			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
 
 	/* Orientation */
-	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret < 0) {
 		dev_err(dev, "failed to get orientation %d\n", ret);
 		return ret;
diff --git a/drivers/gpu/drm/panel/panel-ar16-4inch.c b/drivers/gpu/drm/panel/panel-ar16-4inch.c
index 5078445e53e3..482ad3ecd474 100644
--- a/drivers/gpu/drm/panel/panel-ar16-4inch.c
+++ b/drivers/gpu/drm/panel/panel-ar16-4inch.c
@@ -15,6 +15,7 @@
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
@@ -342,7 +343,7 @@ static int ar16_4inch_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "failed to get reset GPIO\n");
 
-	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret < 0 && ret != -ENODEV)
 		return dev_err_probe(dev, ret, "failed to get orientation\n");
 
