[Unit]
Description=SM8550: keep the output volume across reboots
# The main account only: other logins (ssh) must not drive the shared hardware.
ConditionUser=steamos
After=wireplumber.service
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
ExecCondition=/bin/sh -c 'grep -qa "qcom,sm8550" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --user --only volume-keeper
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
