From e27188f40b6050e3f63a8bbe6811c5e72065b1d6 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Wed, 9 Sep 2026 05:36:20 +0700
Subject: [PATCH 41/71] dt-bindings: remoteproc: qcom: sc7180-pas: add the
 Eliza WPSS

The WPSS remoteproc on the Eliza SoC hosts the WLAN Q6 of the WCN7750
combo part and is booted by the WLAN driver through a qcom,rproc handle.
It takes the same PAS parameters as the SC7280 WPSS - pas_id 6, crash
reason SMEM item 626, minidump id 4, cx/mx proxy power domains - so
document qcom,eliza-wpss-pas with qcom,sc7280-wpss-pas as fallback,
which the driver already matches. The power-domain constraint has to use
"contains" now that a two-entry compatible can reach it.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../bindings/remoteproc/qcom,sc7180-pas.yaml  | 25 +++++++++++--------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
index b20780e5e..c1f2588e4 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
@@ -15,13 +15,17 @@ description:
 
 properties:
   compatible:
-    enum:
-      - qcom,sc7180-adsp-pas
-      - qcom,sc7180-mpss-pas
-      - qcom,sc7280-adsp-pas
-      - qcom,sc7280-cdsp-pas
-      - qcom,sc7280-mpss-pas
-      - qcom,sc7280-wpss-pas
+    oneOf:
+      - enum:
+          - qcom,sc7180-adsp-pas
+          - qcom,sc7180-mpss-pas
+          - qcom,sc7280-adsp-pas
+          - qcom,sc7280-cdsp-pas
+          - qcom,sc7280-mpss-pas
+          - qcom,sc7280-wpss-pas
+      - items:
+          - const: qcom,eliza-wpss-pas
+          - const: qcom,sc7280-wpss-pas
 
   reg:
     maxItems: 1
@@ -155,9 +159,10 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sc7280-cdsp-pas
-            - qcom,sc7280-wpss-pas
+          contains:
+            enum:
+              - qcom,sc7280-cdsp-pas
+              - qcom,sc7280-wpss-pas
     then:
       properties:
         power-domains:
-- 
