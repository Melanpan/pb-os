From e192bf797bdb8edb6a422239e585d9930807c323 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Thu, 10 Sep 2026 19:08:17 +0700
Subject: [PATCH 31/71] ASoC: dt-bindings: everest,es8326: add vdd and vddio
 supplies

The ES8326 is powered from a core supply (AVDD/DVDD) and a separate
I/O supply. Boards that switch these rails need a way to hand them
to the driver instead of keeping them always on. Document both as
optional so existing users are unaffected.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 Documentation/devicetree/bindings/sound/everest,es8326.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/everest,es8326.yaml b/Documentation/devicetree/bindings/sound/everest,es8326.yaml
index b5594a9d5..c7719a122 100644
--- a/Documentation/devicetree/bindings/sound/everest,es8326.yaml
+++ b/Documentation/devicetree/bindings/sound/everest,es8326.yaml
@@ -31,6 +31,12 @@ properties:
   "#sound-dai-cells":
     const: 0
 
+  vdd-supply:
+    description: Analog and digital core supply (AVDD/DVDD)
+
+  vddio-supply:
+    description: I/O supply
+
   everest,jack-pol:
     $ref: /schemas/types.yaml#/definitions/uint8
     description: |
-- 
