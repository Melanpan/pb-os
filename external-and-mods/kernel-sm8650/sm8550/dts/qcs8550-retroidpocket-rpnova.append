
/*
 * The Nova's own ADSP and speaker tuning (sm8550/firmware/.../rpnova), not
 * AYN Odin 2's. With Retroid's ADSP the amps take stock Android's channel
 * numbering: 0x34 is channel 1, 0x35 is channel 0 (left and right swap otherwise).
 */
&remoteproc_adsp {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/adsp.mbn",
			"qcom/sm8550/retroidpocket/rpnova/adsp_dtb.mbn";
};

&spk_amp_l {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/aw883xx_acf.bin";
	awinic,audio-channel = <1>;
};

&spk_amp_r {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/aw883xx_acf.bin";
	awinic,audio-channel = <0>;
};

/*
 * Motion sensors (QMI8658 accelerometer and gyroscope) through the ADSP's
 * sensor hub, as on the AYN Thor (same ADSP build family, 01329): remote
 * heap, sensors-PD restart tracking and the FastRPC context banks' process
 * types (patch 0560).
 */
/ {
	reserved-memory {
		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
			alignment = <0x0 0x400000>;
			size = <0x0 0xc00000>;
			reusable;
		};
	};
};

&remoteproc_adsp {
	glink-edge {
		fastrpc {
			memory-region = <&adsp_rpc_remote_heap_mem>;
			qcom,fastrpc-adsp-sensors-pdr;
			qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;

			compute-cb@3 {
				qcom,pd-type = <1>;
			};

			compute-cb@4 {
				qcom,pd-type = <2>;
			};

			compute-cb@5 {
				qcom,nsessions = <8>;
				qcom,pd-type = <3>;
			};

			compute-cb@6 {
				qcom,pd-type = <7>;
			};

			compute-cb@7 {
				qcom,pd-type = <7>;
			};
		};
	};
};

/*
 * The built-in mic: one WCD938x DMIC, DMIC6 on SoundWire line 10
 * (TX SWR_INPUT10), powered by MIC BIAS4 (1.8 V). The codec's DMIC widgets
 * count from 1, so DMIC6 is clocked by the "DMIC7" widget (the DMIC6/7 clock).
 * The first four routes are qcs8550-ayn-common.dtsi's.
 */
&{/sound} {
	audio-routing =
			"IN1_HPHL", "HPHL_OUT",
			"IN2_HPHR", "HPHR_OUT",
			"AMIC2", "MIC BIAS2",
			"TX SWR_INPUT1", "ADC2_OUTPUT",
			"TX SWR_INPUT10", "DMIC7_OUTPUT",
			"DMIC7", "MIC BIAS4";
};
