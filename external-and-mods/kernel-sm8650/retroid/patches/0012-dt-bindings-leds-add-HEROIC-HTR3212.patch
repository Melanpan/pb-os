From bf613467486c9cea8ef75b8ef36acfc2d885dea4 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 19 Oct 2026 20:20:18 +0700
Subject: [PATCH 12/71] dt-bindings: leds: add HEROIC HTR3212

Document the HEROIC HTR3212, a 12-channel LED driver with 8-bit PWM
brightness control configured over I2C.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../bindings/leds/heroic,htr3212.yaml         | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/heroic,htr3212.yaml

diff --git a/Documentation/devicetree/bindings/leds/heroic,htr3212.yaml b/Documentation/devicetree/bindings/leds/heroic,htr3212.yaml
new file mode 100644
index 000000000..57e9766df
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/heroic,htr3212.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/heroic,htr3212.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HEROIC HTR3212 12-channel LED controller
+
+maintainers:
+  - Teguh Sobirin <teguh@sobir.in>
+
+description:
+  The HTR3212 is a 12-channel LED driver with 8-bit PWM brightness control,
+  configured over I2C.
+
+properties:
+  compatible:
+    const: heroic,htr3212
+
+  reg:
+    maxItems: 1
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+  sdb-gpios:
+    maxItems: 1
+    description: GPIO connected to the SDB pin, asserted to enable the chip.
+
+  vdd-supply:
+    description: Power supply.
+
+  always-on:
+    type: boolean
+    description: Keep the LEDs lit across system suspend.
+
+patternProperties:
+  "^led@[1-9a-c]$":
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      reg:
+        description: LED output channel.
+        minimum: 1
+        maximum: 12
+
+    required:
+      - reg
+
+required:
+  - compatible
+  - reg
+  - "#address-cells"
+  - "#size-cells"
+  - vdd-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/leds/common.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-controller@3c {
+            compatible = "heroic,htr3212";
+            reg = <0x3c>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            sdb-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
+            vdd-supply = <&vdd_led>;
+
+            led@1 {
+                reg = <1>;
+                color = <LED_COLOR_ID_RED>;
+            };
+
+            led@2 {
+                reg = <2>;
+                color = <LED_COLOR_ID_GREEN>;
+            };
+
+            led@3 {
+                reg = <3>;
+                color = <LED_COLOR_ID_BLUE>;
+            };
+        };
+    };
-- 
