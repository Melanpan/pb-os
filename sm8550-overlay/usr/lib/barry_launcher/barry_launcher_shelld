PSI_PATH = os.environ.get("BARRY_PSI_PATH", "/proc/pressure/memory")
PSI_TRIGGER = os.environ.get("BARRY_PSI_TRIGGER", "some 300000 2000000")
# Sound: pactl subscribe's sink-input events, a burst of them looked at
# once it has been quiet this long; a pactl that ended starts again after
# AUDIO_RETRY_S.
AUDIO_SETTLE_MS = 150
AUDIO_RETRY_S = 5


def log(msg: str) -> None:
    print(msg, flush=True)


class State:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.visible = False
        self.top = False
        self.apps: dict[str, subprocess.Popen] = {}
        self.services: dict[str, subprocess.Popen] = {}  # user app -> its service (barry_apps)
        self.status: dict[str, str] = {}  # app -> what its tile says meanwhile
        self.overlay_marked = False
        self.input_focus: bool | None = None
        self.quiet_until = 0.0  # monotonic time: no keyboard for text focus before it
        self.hidden_by_hand = 0.0  # monotonic: the keyboard's own hide (its ⌄ key, a tap beside it)
        self.curtain = ""  # the name of the app opening under the cover, if any
        self.curtain_app: str | None = None
        self.curtain_shows = 0.0  # monotonic: when the cover shows (CURTAIN "delay")
        self.keyboard_height = 0  # the key panel's height, as Keyboard.qml reports it
        self.inset: int | None = None  # GAMESCOPE_FOCUS_BOTTOM_INSET last set
        self.home_serial = 0  # counts Barry opening, for its slide-in
        self.barry_open = False
        self.barry_lock = threading.Lock()  # one open or close at a time
        self.front: str | None = None  # the app shown (None: the home window)
        self.back_app: str | None = None  # in front when Barry opened
        self.open_page = 0  # the page Barry opened on (GET /home)
        self.open_lifted: tuple[int, int] | None = None  # where the swipe up that opened it lifted
        self.under = ""  # UNDER_SHOT when it shows the app Barry opened over
        self.under_taken = 0.0  # monotonic: when UNDER_SHOT was last taken (0: none)
        self.under_lock = threading.Lock()  # one picture at a time
        self.home_win = ""  # Barry's window, unmapped while an app it closed back to shows
        self.home_ready = threading.Event()
        self.top_keyboard = {"serial": 0, "visible": False}  # the Trackpad app's keyboard
        self.opened_for_game: dict[str, str] = {}  # game appid -> the app it opened
        self.tools_serial = 0  # counts the tools asked to slide away (GET /tools)
        self.leaving: dict[str, int] = {}  # tool -> its pid, while it slides away
        self.leave_pending: set[int] = set()  # of those, the ones not done yet
        self.tools_left = threading.Event()  # set as leave_pending empties
        # Apps in the background (Background): app -> its record, while it runs.
        self.life: dict[str, Background] = {}
        self.life_lock = threading.RLock()  # freezing and thawing, one at a time
        self.scope_cmd: list[str] | None = None  # systemd-run's start of a scope (scope_probe), if it works
        self.scope_seq = 0
        self.own_cgroup = ""  # shelld's (never frozen: the shell's and the keyboard's too)

    def set_top_keyboard(self, visible: bool, why: str) -> None:
        with self.lock:
            self.top_keyboard = {"serial": self.top_keyboard["serial"] + 1, "visible": visible}
        publish("top-keyboard", "keyd")
        log(f"{why}: trackpad keyboard {'up' if visible else 'down'}")

    def keyboard(self) -> dict:
        with self.lock:
            return {"visible": self.visible, "top": self.top}

    def set_keyboard(self, visible: bool, top: bool | None = None) -> None:
        if visible and barry_up():
            visible = False
        with self.lock:
            self.visible = visible
            if top is not None:
                self.top = top
        # Touches go to the keyboard's window only while it (or the cover
        # over an opening app) shows; it turns opaque as it hears so.
        keyboard_input_focus(visible or STATE.curtain_app is not None)
        apply_inset()
        publish("keyboard", "keyd")
        # Overlays draw above Barry: Barry opening just now hid it before
        # this showed it.
        if visible and barry_up():
            self.set_keyboard(False)


STATE = State()


def barry_flag() -> bool | None:
    """BARRY_FLAG: open or not; None while it is being written (empty)."""
    try:
        with open(BARRY_FLAG, encoding="utf-8") as fh:
            value = fh.read().strip()
    except OSError:
        return False
    return None if value == "" else value == "1"


def barry_up() -> bool:
    # Opening and closing is Game Mode's: in Desktop Mode the flag can still
    # read 1 from Game Mode, and it would keep the keyboard down for nothing.
    return not DESKTOP and STATE.barry_open


def write_barry_flag(open_: bool) -> None:
    # Whole (a new file renamed over it): sm8550-thor-backlightd never reads
    # it half written.
    tmp = f"{BARRY_FLAG}.shelld"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("1" if open_ else "0")
        os.chmod(tmp, 0o664)
        os.replace(tmp, BARRY_FLAG)
    except OSError as err:
        log(f"cannot write {BARRY_FLAG}: {err}")


def open_barry(why: str, page: int = 0, lifted: tuple[int, int] | None = None) -> None:
    """Barry's pages over whatever shows, on page (0 the apps); the app in
    front is remembered, for closing back to it. A tool (the trackpad, the
    Deck controls) is not an app to come back to: it closes, and closing
    Barry shows the hero art (else the AYN button only ever went between
    Barry and the tool)."""
    with STATE.barry_lock:
        if STATE.barry_open:
            return
        STATE.barry_open = True
        STATE.open_page = page
        STATE.open_lifted = lifted
        front = STATE.front
        STATE.back_app = front if front and running(front) and not APPS.get(front, {}).get("tool") else None
        log(f"{why}: Barry opens{f' over {front}' if STATE.back_app else ''}")
        write_barry_flag(True)
        go_home(raise_window=front is not None)


def close_barry(why: str, back: bool | None = None) -> None:
    """Barry's pages away: the app it opened over comes back (back), or the
    hero art shows, the app staying in the background (a tile brings it
    back). back None: only a side page goes back to its app (swiped away:
    a gesture on the app); the AYN button and the standby timeout close to
    the art."""
    with STATE.barry_lock:
        if not STATE.barry_open:
            return
        if back is None:
            back = STATE.open_page != 0
        STATE.barry_open = False
        STATE.open_page = 0
        STATE.open_lifted = None
        STATE.under = ""
        app, STATE.back_app = STATE.back_app, None
        write_barry_flag(False)
        if back and app and running(app):
            STATE.quiet_until = time.monotonic() + SIDE_QUIET_S
            # In front again (step_aside or bring_forward): said with Barry
            # closing, in one answer. In front before thawing: it is not
            # frozen again meanwhile (freeze_due).
            STATE.front = app
            thaw(app, "back in front")
            publish("home", "keyd")
            log(f"{why}: Barry closes, back to {app}")
            if DESKTOP or not step_aside(app):
                bring_forward(app)
        else:
            # STATE.front is None (open_barry brought the home window
            # forward): GET /home's "app" is false, and Shell.qml fades to
            # the art.
            publish("home", "keyd")
            log(f"{why}: Barry closes{f' to the art, {app} in the background' if app and running(app) else ''}")


def on_barry_flag(_monitor, _file, _other, event) -> None:
    """BARRY_FLAG written (an AYN press, or the screen turned off). Only a
    finished write counts: the file is emptied first, and reading it then
    closed Barry the moment it opened."""
    if event not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED):
        return
    want = barry_flag()
    if DESKTOP or want is None or want == STATE.barry_open:
        return
    # Closing goes to the art, the app Barry opened over in the background.
    threading.Thread(target=open_barry if want else close_barry,
                     args=("AYN button",) if want else ("AYN button", False), daemon=True).start()


def set_keyboard_prop(prop: str, value: str, quiet: bool = False) -> bool:
    r = subprocess.run(
        ["xprop", "-name", KEYBOARD_TITLE, "-f", prop, "32c", "-set", prop, value],
        capture_output=True, text=True,
    )
    if r.returncode != 0 and not quiet:
        log(f"cannot set {prop} on the keyboard: {r.stderr.strip()}")
    return r.returncode == 0


def apply_inset() -> None:
    """While the keyboard shows, gamescope makes the app that much shorter
    and draws it from the top: the keyboard pushes the app up instead of
    covering it."""
    with STATE.lock:
        inset = STATE.keyboard_height if STATE.visible else 0
        if inset == STATE.inset:
            return
        STATE.inset = inset
    if DESKTOP:
        barry_desktop.set_inset(inset)
        return
    r = subprocess.run(["xprop", "-root", "-f", INSET_PROP, "32c", "-set", INSET_PROP, str(inset)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        log(f"cannot set {INSET_PROP}: {r.stderr.strip()}")


def mark_keyboard_overlay(quiet: bool = False) -> bool:
    """Make the (always mapped, transparent) keyboard window an overlay."""
    if DESKTOP:
        return True  # KWin: the keyboard window refuses focus itself
    if not STATE.overlay_marked:
        if set_keyboard_prop("STEAM_INPUT_FOCUS", "0", quiet) and set_keyboard_prop("STEAM_OVERLAY", "1", quiet):
            STATE.overlay_marked = True
            STATE.input_focus = False
            log("keyboard marked as overlay")
    return STATE.overlay_marked


def keyboard_input_focus(on: bool) -> None:
    if DESKTOP:
        return
    if STATE.input_focus == on or not mark_keyboard_overlay():
        return
    if set_keyboard_prop("STEAM_INPUT_FOCUS", "2" if on else "0"):
        STATE.input_focus = on


def watch_keyboard_window() -> None:
    """The keyboard window appears shortly after we start; mark it then, so
    gamescope does not take it for an app. Tried each time gamescope
    rewrites its list of windows (it does as one maps), with one xprop
    listening, until marked."""
    if mark_keyboard_overlay(quiet=True):
        return
    try:
        # Line by line: into a pipe, xprop's output would wait for a full buffer.
        spy = subprocess.Popen(["stdbuf", "-oL", "xprop", "-spy", "-root", FOCUSABLE_PROP], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as err:
        log(f"cannot watch for the keyboard window: {err}")
        return
    fd = spy.stdout.fileno()
    os.set_blocking(fd, False)

    def changed(_fd, _cond) -> bool:
        try:
            alive = bool(os.read(fd, 4096))
        except BlockingIOError:
            alive = True
        except OSError:
            alive = False
        if mark_keyboard_overlay(quiet=True):
            return stop()
        if not alive:
            log("xprop stopped before the keyboard window turned up; it is marked as it first shows")
            return stop()
        return True

    def stop() -> bool:
        spy.kill()
        spy.wait()
        spy.stdout.close()
        return False
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, fd,
                          GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, changed)


def write_firefox_prefs(profile: str, zoom: str, extra: dict) -> None:
    os.makedirs(profile, exist_ok=True)
    prefs = dict(FIREFOX_PREFS, **{"layout.css.devPixelsPerPx": zoom}, **extra)
    lines = [f"user_pref({json.dumps(k)}, {json.dumps(v)});" for k, v in prefs.items()]
    with open(f"{profile}/user.js", "w", encoding="utf-8") as fh:
        fh.write("// Written by barry_launcher_shelld at every start; change other settings in about:config.\n")
        fh.write("\n".join(lines) + "\n")


def running(app: str) -> subprocess.Popen | None:
    proc = STATE.apps.get(app)
    return proc if proc and proc.poll() is None else None


def activate(args: list[str]) -> bool:
    """Bring the first window matching xdotool search ARGS forward: map it
    again, so it is gamescope's most recently mapped window. All of ARGS
    must match (--all): xdotool's default is any one, and "--pid P
    --classname Navigator" then took the first Firefox window of all,
    bringing up Firefox for Discord."""
    r = subprocess.run(["xdotool", "search", "--all", "--onlyvisible", *args], capture_output=True, text=True)
    wins = r.stdout.split()
    if not wins:
        return False
    r = subprocess.run(["xdotool", "windowunmap", "--sync", wins[0], "windowmap", "--sync", wins[0]],
                       capture_output=True, text=True)
    return r.returncode == 0


def app_windows(app: str) -> list[list[str]]:
    """The xdotool searches for a running app's window, in order (Game
    Mode)."""
    spec = APPS.get(app, {})
    if "flatpak" in spec:
        # Its window, or a launch dialog still waiting for an answer.
        return [["--classname", spec["window"]], ["--classname", DIALOG_CLASS]]
    pid = str(running(app).pid)
    if "qml" in spec or "qmlfile" in spec or "main" in spec:
        return [["--pid", pid, "--name", spec["window"]]]
    return [["--pid", pid, "--classname", "Navigator"]]


def bring_forward(app: str | None) -> bool:
    """Bring an app's window (None: the home screen) forward."""
    STATE.front = app
    publish("home")
    spec = APPS.get(app, {}) if app else {}
    if DESKTOP:
        if app is None:
            return barry_desktop.activate(caption=f"^{HOME_TITLE}$")
        if "flatpak" in spec:
            return barry_desktop.activate(classes=spec.get("classes"))
        if "qml" in spec or "qmlfile" in spec or "main" in spec:
            return barry_desktop.activate(caption=spec["window"])
        return barry_desktop.activate(classes=[f"barry-{app}"])
    if app is None:
        win, STATE.home_win = STATE.home_win, ""
        if win:
            # Unmapped by step_aside: mapping it is enough.
            r = subprocess.run(["xdotool", "windowmap", "--sync", win], capture_output=True, text=True)
            if r.returncode == 0:
                return True
        return activate(["--name", f"^{HOME_TITLE}$"])
    return any(activate(args) for args in app_windows(app))


def step_aside(app: str) -> bool:
    """Barry closes back to app: its own window is unmapped, and gamescope
    shows the most recently mapped window left, the app's (mapped under
    Barry all along), as it was. Mapping the app again (bring_forward)
    makes it paint anew: Signal showed a black or half-drawn frame as a
    side page closed. Only with the app's window mapped (Signal can close to
    its tray), else nothing would show."""
    if not any(window_shown(args) for args in app_windows(app)):
        return False
    r = subprocess.run(["xdotool", "search", "--onlyvisible", "--name", f"^{HOME_TITLE}$"],
                       capture_output=True, text=True)
    wins = r.stdout.split()
    if len(wins) != 1:
        return False
    if subprocess.run(["xdotool", "windowunmap", "--sync", wins[0]], capture_output=True).returncode != 0:
        return False
    STATE.home_win = wins[0]
    STATE.front = app
    publish("home")
    return True


def go_home(raise_window: bool = True) -> None:
    # Barry slides in (Shell.qml): it sees the new serial, puts itself at
    # the animation's start while still hidden, and says so; then the home
    # window comes forward. Not waiting long: it comes forward regardless.
    # Apps keep running under it (closing Barry goes back to them).
    lower_curtain("left for home")
    # The trackpad or the Deck controls slide away first: Barry's slide-in
    # is seen only once its window is forward, and that hides the tool.
    tools_leave()
    with STATE.lock:
        STATE.home_serial += 1
        STATE.home_ready.clear()
    publish("home", "keyd")
    if threading.current_thread() is threading.main_thread():
        flush_events()  # the shell must hear of it while this waits (Desktop Mode's swipe)
    STATE.home_ready.wait(HOME_READY_S)
    STATE.set_keyboard(False)
    # In both modes: Desktop Mode's Home too (a trackpad left open behind
    # Barry kept the touchscreen, 2026-10-18). One that slid away waits for
    # this, showing its empty last frame until Barry's window takes its place.
    leave_tools("")
    # Unmapping and mapping the window again (bring_forward) shows black
    # for a moment: only when something else is in front.
    if raise_window and not bring_forward(None):
        log("cannot find the home screen window")


def tool_client(pid: int) -> bool:
    """Is the process pid a tool's window on the event stream, one that
    slides away when asked ({"tool": true}; Barry.Input's ShellState)?"""
    return any(c.tool and c.pid == pid and not c.closed for c in list(EVENTS.clients))  # a worker thread


def tools_leave() -> None:
    """Going home over the trackpad or the Deck controls (Game Mode): each
    asks to slide away first (GET /tools' leaving: its pid; ToolStage.qml
    plays it), and Barry comes once it says it has ({"tool_left": true}) or
    ends, or after TOOL_LEAVE_S at the most. It stays up meanwhile, showing
    its empty last frame, until leave_tools ends it as Barry's window comes
    forward: gamescope shows the most recently mapped window alone, so had it
    quit by itself, the window under it (the app Barry opened over) would
    flash up for the moment Barry takes to get ready.

    Not overlapped with Barry's slide-in: Barry's window forward hides the
    tool at once (no cross-fade between two windows here), and Shell.qml's
    slide runs from its /home-ready, so starting that early played most of
    it unseen behind the tool. Their two animations follow each other.

    Only a tool that said it slides (a Barry.Input that knows how; it may
    not have connected yet just after starting): the rest go at once, as
    before. Not in Desktop Mode (its tools are Wayland windows beside
    Barry's under KWin, which activates Barry's window over them), nor on
    the main loop (Desktop Mode's swipe), whose event stream and pidfds
    this would hold up."""
    if DESKTOP or threading.current_thread() is threading.main_thread():
        return
    asked = {}
    for app, spec in APPS.items():
        proc = running(app) if spec.get("tool") else None
        if proc and tool_client(proc.pid):
            asked[app] = proc.pid
    if not asked:
        return
    started_at = time.monotonic()
    with STATE.lock:
        STATE.tools_serial += 1
        STATE.leaving = asked
        STATE.leave_pending = set(asked.values())
        STATE.tools_left.clear()
    publish("tools")
    for app, pid in asked.items():
        if running(app) is None:
            tool_gone(pid)  # ended just before it was asked
    names = ", ".join(asked)
    if STATE.tools_left.wait(TOOL_LEAVE_S):
        log(f"{names} slid away in {time.monotonic() - started_at:.2f} s")
    else:
        log(f"{names} did not slide away in {TOOL_LEAVE_S:.1f} s; closing it")
    with STATE.lock:
        STATE.leaving = {}
        STATE.leave_pending = set()
    publish("tools")


def tool_gone(pid: int) -> None:
    """A tool asked to slide away has (its {"tool_left": true}) or has
    ended: tools_leave goes on once all of them have."""
    with STATE.lock:
        if pid not in STATE.leave_pending:
            return
        STATE.leave_pending.discard(pid)
        if not STATE.leave_pending:
            STATE.tools_left.set()


def leave_tools(but: str) -> None:
    """The trackpad and the Deck controls are tools, not apps to come back
    to: going home, or another app starting, closes them. Their exit
    lets go of anything they held."""
    for app, spec in APPS.items():
        if app != but and spec.get("tool") and running(app):
            close(app)


def app_env(**extra: str) -> dict:
    env = dict(os.environ, GNOME_ACCESSIBILITY="1", **extra)
    if not DESKTOP:
        env.pop("WAYLAND_DISPLAY", None)  # X11, where gamescope's stacking applies
    env.pop("BARRY_DESKTOP", None)
    return env


def surface_dialogs(proc: subprocess.Popen) -> None:
    """Bring forward the dialogs a Flatpak's launch script opens before the
    app (Signal's asks about its password store on the first start, and
    quits on No): gamescope shows the most recently mapped window, so they
    would wait unseen behind the home screen."""
    shown: set[str] = set()
    deadline = time.monotonic() + DIALOG_WATCH_S
    while proc.poll() is None and time.monotonic() < deadline:
        r = subprocess.run(["xdotool", "search", "--onlyvisible", "--classname", DIALOG_CLASS],
                           capture_output=True, text=True)
        for win in r.stdout.split():
            if win not in shown:
                shown.add(win)
                subprocess.run(["xdotool", "windowunmap", "--sync", win, "windowmap", "--sync", win],
                               capture_output=True)
                log("brought a launch dialog forward")
        time.sleep(0.5)


def app_log(app: str):
    d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "barry_launcher")
    os.makedirs(d, exist_ok=True)
    return open(os.path.join(d, f"{app}.log"), "w")


def flatpak_installed(ref: str) -> bool:
    return subprocess.run(["flatpak", "info", ref], capture_output=True).returncode == 0


def flatpak_location(ref: str) -> str | None:
    r = subprocess.run(["flatpak", "info", "--show-location", ref], capture_output=True, text=True)
    return r.stdout.strip() or None


def warm_apps() -> None:
    """Read the "warm" apps' files into the page cache, so their first start
    does not wait on the SD card. The kernel drops them again under memory
    pressure."""
    time.sleep(WARM_DELAY_S)
    for app, spec in APPS.items():
        if "warm" not in spec or running(app) or not flatpak_installed(spec["flatpak"]):
            continue
        ref = spec["flatpak"]
        paths = [os.path.expanduser(p) for p in spec["warm"]]
        loc = flatpak_location(ref)
        if loc:
            paths.append(os.path.join(loc, "files"))
        r = subprocess.run(["flatpak", "info", "--show-runtime", ref], capture_output=True, text=True)
        rt = flatpak_location(r.stdout.strip()) if r.stdout.strip() else None
        if rt:
            paths += [os.path.join(rt, "files", d) for d in WARM_RUNTIME_DIRS]
        paths = [p for p in paths if os.path.isdir(p)]
        started = time.monotonic()
        r = subprocess.run(
            ["ionice", "-c", "3", "nice", "-n", "19", "sh", "-c",
             'find "$@" -name "*.noindex" -prune -o -type f -print0 | xargs -0 -r cat | wc -c', "warm", *paths],
            capture_output=True, text=True,
        )
        size = int(r.stdout.strip() or 0)
        log(f"warmed {app}: {size // 1048576} MB in {time.monotonic() - started:.0f} s")


def start_flatpak(app: str, spec: dict) -> None:
    """Install the app from Flathub for this user if needed, then start it."""
    ref = spec["flatpak"]
    try:
        if not flatpak_installed(ref):
            STATE.status[app] = "Installing…"
            publish("apps")
            log(f"installing {ref} from Flathub")
            subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
                           capture_output=True)
            r = subprocess.run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", ref],
                               capture_output=True, text=True)
            if r.returncode != 0:
                log(f"cannot install {ref}: {r.stderr.strip()[-300:]}")
                return
        for path, text in spec.get("seed", {}).items():
            path = os.path.expanduser(path)
            if not os.path.exists(path):
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(text)
                log(f"wrote {path}")
        raise_curtain(app, "flatpak")
        STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
        with app_log(app) as out:
            started(app, subprocess.Popen(
                ["flatpak", "run", ref, *spec.get("desktop_args" if DESKTOP else "args", [])],
                env=app_env(ACCESSIBILITY_ENABLED="1"),
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            ))
        watch_opening(app, "flatpak", lambda: window_shown(["--classname", spec["window"]]))
        if not DESKTOP:  # KWin shows launch dialogs itself
            threading.Thread(target=surface_dialogs, args=(STATE.apps[app],), daemon=True).start()
        log(f"started {app} (pid {STATE.apps[app].pid})")
    finally:
        STATE.status.pop(app, None)
        publish("apps")


def launch(app: str) -> tuple[int, dict]:
    keyboard = app == TOP_KEYBOARD
    if keyboard:
        app = TOP_INPUT_APP
        if running(app):
            STATE.set_top_keyboard(True, "keyboard asked for")
    spec = APPS.get(app)
    if spec is None:
        return 404, {"error": f"no app {app!r}"}
    # Started from Barry (or the plugin): Barry closes, the app shows.
    close_barry(f"{app} starts", back=False)
    leave_tools(app)
    STATE.front = app
    publish("home")
    if app in STATE.status:
        return 200, {"ok": True, "running": False}
    proc = running(app)
    if proc:
        STATE.quiet_until = time.monotonic() + SWITCH_QUIET_S
        publish("keyd")
        thaw(app, "brought forward")  # in front already (above): not frozen again meanwhile
        bring_forward(app)
        return 200, {"ok": True, "running": True}
    if "flatpak" in spec:
        STATE.status[app] = "Starting…"
        publish("apps")
        threading.Thread(target=start_flatpak, args=(app, spec), daemon=True).start()
        return 200, {"ok": True, "running": False}
    if "main" in spec:  # a user app in QML; a web one is a Firefox app below
        # Its XDG folders inside its data folder: all it saves is there.
        extra = barry_apps.app_env(app)
        data = extra["BARRY_APP_DATA"]
        for d in (data, extra["XDG_CONFIG_HOME"], extra["XDG_DATA_HOME"]):
            os.makedirs(d, exist_ok=True)
        if DESKTOP:
            extra["QT_QPA_PLATFORM"] = "wayland"
        args = ["qml6", APP_HOST_QML, "--", spec["dir"], spec["main"], app, spec["name"], data, "fullscreen"]
        with app_log(app) as out:
            if spec.get("service"):
                # One left by a window that ended unseen goes first.
                barry_apps.stop_service(STATE.services.pop(app, None))
                # In a scope of its own, frozen with the app.
                proc, url, token = barry_apps.start_service(spec["dir"], spec["service"],
                                                            app_env(**barry_apps.app_env(app)), out,
                                                            wrap=scope_prefix(app, "service"))
                STATE.services[app] = proc
                args += [url, token]
                log(f"started {app}'s service (pid {proc.pid})")
            raise_curtain(app, "qml")
            started(app, subprocess.Popen(
                scope_prefix(app) + args,
                env=app_env(**extra),
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            ))
        log(f"started {app} {spec['version']} (pid {STATE.apps[app].pid})")
        proc = STATE.apps[app]
        watch_opening(app, "qml", lambda: window_shown(["--pid", str(proc.pid), "--name", spec["window"]]))
        return 200, {"ok": True, "running": False}
    if "qml" in spec or "qmlfile" in spec:
        cmd = (["qml6", TOP_INPUT_QML, "--", spec["qml"]] if "qml" in spec
               else ["qml6", os.path.join(SHELL_DIR, spec["qmlfile"])])
        if keyboard:
            cmd.append("keyboard")  # opens with its keyboard up
        extra = {}
        if DESKTOP and spec.get("tool"):
            # The trackpad, keyboard and Deck controls must never take focus
            # from the top screen's window: a KWin rule (barry_launcher_desktop)
            # says so, so they can be Wayland windows, with proper multitouch.
            if "--" in cmd:
                cmd.insert(cmd.index("--") + 1, "desktop")
            else:
                cmd += ["--", "desktop"]
            extra["QT_QPA_PLATFORM"] = "wayland"
        started(app, subprocess.Popen(
            cmd,
            env=app_env(**extra),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ))
        log(f"started {app} (pid {STATE.apps[app].pid})")
        return 200, {"ok": True, "running": False}
    profile = os.path.join(DATA, spec["profile"])  # a user web app's is a full path already
    zoom = spec["zoom"]
    if DESKTOP:
        zoom = spec.get("desktop_zoom") or str(round(float(zoom) / DESKTOP_SCALE, 3))
    write_firefox_prefs(profile, zoom, spec.get("prefs", {}))
    # Start clean: a session left by a killed instance makes Firefox offer
    # "Open previous tabs?", which a kiosk app cannot act on.
    for leftover in ("sessionstore.jsonlz4", "sessionstore-backups"):
        path = os.path.join(profile, leftover)
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        elif os.path.exists(path):
            os.remove(path)
    if DESKTOP:
        # Wayland, so KWin hands its text fields to the input method; named
        # so KWin's scripts can tell it from the top screen's Firefox.
        cmd = ["firefox", "--name", f"barry-{app}", "--no-remote", "--profile", profile, *spec["args"]]
        env = app_env(MOZ_ENABLE_WAYLAND="1")
    else:
        cmd = ["firefox", "--no-remote", "--profile", profile, *spec["args"]]
        # Firefox draws through Vulkan; gamescope's WSI layer then gives its
        # window a gamescope swapchain, and a resize (the keyboard pushing it
        # up) can make a second one: gamescope drops the connection and the
        # window freezes. Plain Xwayland presents it instead.
        env = app_env(MOZ_USE_XINPUT2="1", MOZ_ENABLE_WAYLAND="0", DISABLE_GAMESCOPE_WSI="1")
    raise_curtain(app, "firefox")
    STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
    started(app, subprocess.Popen(
        scope_prefix(app) + cmd,
        env=env,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ))
    log(f"started {app} (pid {STATE.apps[app].pid})")
    proc = STATE.apps[app]
    watch_opening(app, "firefox", lambda: page_shown(proc.pid))
    return 200, {"ok": True, "running": False}


def raise_curtain(app: str, kind: str) -> None:
    """Cover the screen while an app opens (Keyboard.qml draws it, over
    everything, and takes the touches meanwhile). Game Mode only: under
    KWin, windows open without that flicker."""
    if DESKTOP:
        return
    STATE.curtain_app = app
    STATE.curtain = APPS[app]["name"]
    STATE.curtain_shows = time.monotonic() + CURTAIN[kind]["delay"]
    keyboard_input_focus(True)
    publish("keyboard")
    if CURTAIN[kind]["delay"] > 0:
        # The cover shows a moment later: said then (GET /keyboard's curtain).
        GLib.timeout_add(int(CURTAIN[kind]["delay"] * 1000) + 1, curtain_due)


def lower_curtain(why: str) -> None:
    if STATE.curtain_app is None:
        return
    log(f"{STATE.curtain_app} {why}: cover off")
    STATE.curtain_app = None
    STATE.curtain = ""
    keyboard_input_focus(STATE.keyboard()["visible"])
    publish("keyboard")


def curtain_due() -> bool:
    """CURTAIN's "delay" over: the cover shows now, unless it came off."""
    left = STATE.curtain_shows - time.monotonic()
    if STATE.curtain and left > 0:
        GLib.timeout_add(int(left * 1000) + 1, curtain_due)  # early by a hair
    else:
        publish("keyboard")
    return False


def watch_opening(app: str, kind: str, ready) -> None:
    """Take the cover off app once ready() and its first paint (see
    watch_curtain)."""
    if STATE.curtain_app == app:
        GLib.timeout_add(CURTAIN_POLL_MS, watch_curtain, app, kind, ready, STATE.apps[app], time.monotonic(),
                         [None])


def window_shown(search: list[str]) -> bool:
    """Is a window matching all of xdotool search ARGS mapped?"""
    r = subprocess.run(["xdotool", "search", "--all", "--onlyvisible", *search], capture_output=True, text=True)
    return bool(r.stdout.split())


def page_shown(pid: int) -> bool:
    """Has the Firefox with this pid a web page (not about:) in its window?
    Still loading counts: WhatsApp draws its own loading screen at about 3 s,
    and stays "busy" until about 13 s."""
    desk = Atspi.get_desktop(0)
    for i in range(desk.get_child_count()):
        fx = desk.get_child_at_index(i)
        if fx is None or fx.get_process_id() != pid:
            continue
        # This side keeps the app's tree as it last saw it (no listener for
        # its changes here): a Firefox just started looked empty for good.
        fx.clear_cache()
        todo = [(fx, 0)]
        while todo:
            acc, depth = todo.pop()
            if acc.get_role() == Atspi.Role.DOCUMENT_WEB:
                url = (acc.get_document_attributes() or {}).get("DocURL", "")
                if url.startswith("http") and acc.get_state_set().contains(Atspi.StateType.SHOWING):
                    return True
                continue  # not inside a page
            # application > frame > panel > scroll pane > internal frame >
            # document web; not into the toolbars and their menus.
            if depth < 5 and acc.get_role() not in (Atspi.Role.TOOL_BAR, Atspi.Role.MENU, Atspi.Role.MENU_BAR):
                for j in range(acc.get_child_count()):
                    c = acc.get_child_at_index(j)
                    if c is not None:
                        todo.append((c, depth + 1))
    return False


def watch_curtain(app: str, kind: str, ready, proc: subprocess.Popen, started: float, ready_at: list) -> bool:
    """Every CURTAIN_POLL_MS while app opens: the cover comes off once it is
    ready and has had time to paint, if it quits, if it asks something in a
    launch dialog (Signal's password store), or at the latest after its
    kind's "max"."""
    if STATE.curtain_app != app:
        return False  # off already (home, another app)
    if proc.poll() is not None:
        lower_curtain("quit while opening")
        return False
    now = time.monotonic()
    limit = CURTAIN[kind]["max"]
    if now - started > limit:
        lower_curtain(f"not ready after {limit:.0f} s")
        return False
    if kind == "flatpak" and window_shown(["--classname", DIALOG_CLASS]):
        lower_curtain("asks something")
        return False
    if ready_at[0] is None:
        try:
            if ready():
                ready_at[0] = now
        except GLib.Error as err:
            log(f"{app}: cannot tell whether it is ready: {err}")
    elif now - ready_at[0] >= CURTAIN[kind]["paint"]:
        lower_curtain(f"ready in {ready_at[0] - started:.1f} s")
        return False
    return True


def close(app: str) -> tuple[int, dict]:
    if app == TOP_KEYBOARD:
        app = TOP_INPUT_APP
    if app not in APPS:
        return 404, {"error": f"no app {app!r}"}
    proc = running(app)
    if proc:
        # A frozen app would not hear its SIGTERM (flatpak kill's) until
        # thawed, nor be frozen again while it quits.
        with STATE.life_lock:
            if app in STATE.life:
                STATE.life[app].closing = True
        thaw(app, "closing")
        if "flatpak" in APPS[app]:
            # The app runs in flatpak's sandbox, not as our child.
            subprocess.run(["flatpak", "kill", APPS[app]["flatpak"]], capture_output=True)
        else:
            proc.terminate()
        log(f"closing {app}")
    return 200, {"ok": True}


def check_app(body: dict) -> tuple[int, dict]:
    """Would the archive install, and what is in it (the plugin asks
    before installing an app with a service)."""
    path = body.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        return 400, {"ok": False, "error": "path must be the archive's full path"}
    try:
        m = barry_apps.check(path)
    except barry_apps.AppError as err:
        return 400, {"ok": False, "error": str(err)}
    except OSError as err:
        return 400, {"ok": False, "error": f"cannot read it: {err.strerror or err}"}
    if m["id"] in BUILTIN_APPS:
        return 400, {"ok": False, "error": f'"{m["id"]}" is one of Barry Launcher\'s own apps'}
    return 200, {"ok": True, "app": m}


def install_app(body: dict) -> tuple[int, dict]:
    path = body.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        return 400, {"ok": False, "error": "path must be the archive's full path"}
    try:
        m = barry_apps.install(path, reserved=set(BUILTIN_APPS))
    except barry_apps.AppError as err:
        log(f"cannot install {path}: {err}")
        return 400, {"ok": False, "error": str(err)}
    except OSError as err:
        log(f"cannot install {path}: {err}")
        return 400, {"ok": False, "error": f"cannot install: {err.strerror or err}"}
    # A running copy is the old version: it closes, to start anew.
    if running(m["id"]):
        close(m["id"])
    refresh_user_apps(force=True)
    log(f"{'updated' if m['updated'] else 'installed'} {m['id']} {m['version']}")
    return 200, {"ok": True, "app": m}


def stop(app: str, wait_s: float = 3.0) -> None:
    """Close an app and wait until it has ended: one that saves as it
    quits could otherwise write into a folder just removed."""
    proc = running(app)
    if proc:
        close(app)
        try:
            proc.wait(wait_s)
        except subprocess.TimeoutExpired:
            log(f"{app} did not quit; killing it")
            proc.kill()
            proc.wait(2)
    barry_apps.stop_service(STATE.services.pop(app, None), wait_s)


def remove_app(body: dict) -> tuple[int, dict]:
    app = str(body.get("app", ""))
    if app in BUILTIN_APPS:
        return 400, {"ok": False, "error": f"{APPS[app]['name']} is part of Barry Launcher"}
    stop(app)
    try:
        removed = barry_apps.remove(app, keep_data=bool(body.get("keepData")))
    except OSError as err:
        return 400, {"ok": False, "error": f"cannot remove: {err.strerror or err}"}
    if not removed:
        return 404, {"ok": False, "error": f"no app {app!r}"}
    drop_game_links(app)
    refresh_user_apps(force=True)
    log(f"removed {app}")
    return 200, {"ok": True}


# Apps that open with games: Steam's appid (a non-Steam game's shortcut id)
# -> a Barry Launcher app. The Barry Launcher plugin sets them and reports
# games starting and stopping; an app opened for a game closes with it
# when its link says so (and only if it was opened for it).
GAME_LINKS = os.path.join(os.path.dirname(HOME_LAYOUT), "game-links.json")


def game_links() -> list[dict]:
    try:
        with open(GAME_LINKS, encoding="utf-8") as fh:
            links = json.load(fh).get("links", [])
    except (OSError, ValueError, AttributeError):
        return []
    return [l for l in links if isinstance(l, dict) and str(l.get("game", "")).isdigit()
            and l.get("app") in APPS]


def game_links_json() -> dict:
    return {"links": [dict(l, appName=APPS[l["app"]]["name"]) for l in game_links()]}


def set_game_links(body: dict) -> tuple[int, dict]:
    links = body.get("links")
    if not isinstance(links, list):
        return 400, {"error": "links is a list"}
    clean = {}
    for l in links:
        if not isinstance(l, dict):
            continue
        game, app = str(l.get("game", "")), l.get("app")
        if not game.isdigit() or app not in APPS:
            return 400, {"error": f"no app {app!r}" if game.isdigit() else "game is a Steam appid"}
        clean[game] = {"game": game, "gameName": str(l.get("gameName", ""))[:100], "app": app,
                       "close": bool(l.get("close", True))}  # one app per game: the last wins
    os.makedirs(os.path.dirname(GAME_LINKS), exist_ok=True)
    with open(GAME_LINKS + ".tmp", "w", encoding="utf-8") as fh:
        json.dump({"links": list(clean.values())}, fh, indent=1)
        fh.write("\n")
    os.replace(GAME_LINKS + ".tmp", GAME_LINKS)
    return 200, game_links_json()


def drop_game_links(app: str) -> None:
    """An app removed: no game opens it any more."""
    links = game_links()
    kept = [l for l in links if l["app"] != app]
    if len(kept) != len(links):
        set_game_links({"links": kept})


def game_event(body: dict) -> tuple[int, dict]:
    game = str(body.get("game", ""))
    link = next((l for l in game_links() if l["game"] == game), None)
    if not game.isdigit() or link is None:
        return 200, {"ok": True, "app": None}
    app = link["app"]
    if body.get("running"):
        opened = not running(app)
        log(f"game {game} ({link['gameName'] or '?'}) started: {app}")
        code, r = launch(app)
        if code == 200 and opened:
            STATE.opened_for_game[game] = app
        return code, dict(r, app=app)
    # Stopped: close the app only if this game opened it.
    if STATE.opened_for_game.pop(game, None) == app and link["close"] and running(app):
        log(f"game {game} ({link['gameName'] or '?'}) stopped: closing {app}")
        close(app)
    return 200, {"ok": True, "app": app}


def setup_bundled_apps() -> None:
    """Install the apps that come with Barry Launcher (barry_apps), and move
    the old built-in Dino's place on the home screen and best score to the
    Dino app."""
    for app in barry_apps.install_bundled():
        log(f"installed {app}, which comes with Barry Launcher")
    try:
        with open(HOME_LAYOUT, encoding="utf-8") as fh:
            saved = json.load(fh)
        if isinstance(saved, dict) and OLD_DINO in saved.get("order", []):
            saved["order"] = [NEW_DINO if a == OLD_DINO else a for a in saved["order"]]
            saved["hidden"] = [NEW_DINO if a == OLD_DINO else a for a in saved.get("hidden", [])]
            with open(HOME_LAYOUT + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(saved, fh, indent=1)
                fh.write("\n")
            os.replace(HOME_LAYOUT + ".tmp", HOME_LAYOUT)
            log("moved Dino's place on the home screen to the Dino app")
    except (OSError, ValueError):
        pass
    # The old Dino kept its best score in qml6's own settings ([dino] best=N).
    ini = os.path.join(barry_apps.APP_DATA_DIR, NEW_DINO, "dino.ini")
    if os.path.isdir(os.path.dirname(ini)) and not os.path.exists(ini):
        for conf in glob.glob(f"{HOME}/.config/*.conf") + glob.glob(f"{HOME}/.config/*/*.conf"):
            try:
                with open(conf, encoding="utf-8") as fh:
                    text = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            section = text.split("[dino]", 1)[1].split("\n[", 1)[0] if "[dino]" in text else ""
            best = next((line.split("=", 1)[1].strip() for line in section.splitlines()
                         if line.startswith("best=")), None)
            if best and best.isdigit():
                with open(ini, "w", encoding="utf-8") as fh:
                    fh.write(f"[dino]\nbest={best}\n")
                # And out of the shared file: nothing of the old Dino left.
                before, _, rest = text.partition("[dino]")
                after = rest.split("\n[", 1)
                left = before.rstrip("\n") + ("\n\n[" + after[1] if len(after) > 1 else "\n")
                if left.strip():
                    with open(conf, "w", encoding="utf-8") as fh:
                        fh.write(left)
                else:
                    os.remove(conf)
                log(f"moved Dino's best score ({best}) from {conf}")
                break



def text_before_caret(n: int) -> str | None:
    """Up to n characters before the caret in the focused field, from
    barry_launcher_keyd (which follows the focus); None if they cannot be
    read."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(KEYD_SOCKET)
            s.sendall(f"BEFORE {n}\n".encode())
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
        return json.loads(data).get("text")
    except (OSError, ValueError):
        return None


def ends_with_word(word: str) -> bool:
    """The text before the caret ends with word, as a whole word."""
    before = text_before_caret(len(word) + 1)
    if before is None or not before.endswith(word):
        return False
    return len(before) == len(word) or not before[-len(word) - 1].isalnum()


def type_input(body: dict) -> tuple[int, dict]:
    """Autocorrect's plan for what Keyboard.qml types: it types it, in the
    order its keys came, and waits for this before typing on."""
    # "back": backspaces first, so a glided word can be swapped for another.
    # "expect": only if the field's text before the caret ends with it
    # (checked over AT-SPI), else nothing is typed.
    # "correct": the word just typed; autocorrect swaps it for the word
    # meant before typing the rest, if the field really ends with it.
    # "keep": a word the user undid a correction of; never corrected again.
    back = body.get("back", 0)
    if not isinstance(back, int) or not 0 <= back <= 100:
        return 400, {"error": "back must be 0-100"}
    text = body.get("text") if isinstance(body.get("text"), str) else ""
    key = body.get("key") if body.get("key") in KEYS else None
    if not (back or text or key or "keep" in body):
        return 400, {"error": "need text, a known key or back"}
    expect = body.get("expect")
    if isinstance(expect, str) and expect and not ends_with_word(expect):
        return 409, {"error": "the field does not end with the expected text"}
    lang = body.get("lang", "en")
    if isinstance(body.get("keep"), str):
        with GLIDE["lock"]:
            d = dictionary(lang)
            if d:
                d["corrector"].keep(body["keep"])
                # The language's other layouts keep the same list.
                for other in GLIDE["packs"].values():
                    c = other["corrector"]
                    if c is not d["corrector"] and c.personal_path == d["corrector"].personal_path:
                        c.personal.add(body["keep"].lower())
    reply: dict = {"ok": True, "back": back, "text": text}
    if key:
        reply["key"] = key
    word = body.get("correct")
    if isinstance(word, str) and word and not back:
        with GLIDE["lock"]:
            d = dictionary(lang)
            fixed = d["corrector"].correct(word) if d else None
        if fixed and ends_with_word(word):
            reply.update(back=len(word), text=fixed + text, corrected=fixed)
            log(f"autocorrect: {word} -> {fixed}")
    return 200, reply


GLIDE = {"packs": {}, "lock": threading.Lock()}  # lang -> its dictionary


def keyboard_dirs() -> list[str]:
    env = os.environ.get("BARRY_KEYBOARDS_DIRS")
    if env:
        return [d for d in env.split(":") if d]
    return [KEYBOARDS_DIR, os.path.join(DATA, "keyboards")]


def keyboard_pack(lang: str, borrow: bool = True) -> dict | None:
    """A keyboard pack's rows (or grid), held keys' letters and words file
    (a path inside its folder, or None): the user's, else the shipped one.
    A pack without words of its own can borrow another's ("wordsFrom": a
    second layout for a language); words_lang is whose they are."""
    if not isinstance(lang, str) or not LANG_ID.match(lang):
        return None
    for base in reversed(keyboard_dirs()):
        folder = os.path.join(base, lang)
        try:
            with open(os.path.join(folder, "keyboard.json"), encoding="utf-8") as fh:
                pack = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(pack, dict):
            continue
        words = None
        if isinstance(pack.get("words"), str) and pack["words"]:
            path = os.path.realpath(os.path.join(folder, pack["words"]))
            if path.startswith(os.path.realpath(folder) + os.sep) and os.path.isfile(path):
                words = path
        rows = [[k for k in r if isinstance(k, str)] for r in pack.get("rows", []) if isinstance(r, list)]
        grid = pack.get("grid") if isinstance(pack.get("grid"), list) else None
        more = pack.get("more") if isinstance(pack.get("more"), dict) else {}
        more = {k: [a for a in v if isinstance(a, str)] for k, v in more.items() if isinstance(v, list)}
        words_lang = lang
        source = pack.get("wordsFrom")
        if words is None and borrow and isinstance(source, str) and source != lang:
            lender = keyboard_pack(source, borrow=False)
            if lender and lender["words"]:
                words, words_lang = lender["words"], source
        return {"folder": folder, "words": words, "rows": rows, "grid": grid, "more": more,
                "words_lang": words_lang}
    return None


def dictionary(lang: str) -> dict | None:
    """A pack's dictionary ({"decoder", "corrector", "fold"}), loaded on
    first use and again when its files change; None for a pack without
    words (call with GLIDE["lock"] held)."""
    pack = keyboard_pack(lang)
    if pack is None or pack["words"] is None:
        return None
    try:
        stamp = (pack["words"], os.stat(pack["words"]).st_mtime_ns,
                 os.stat(os.path.join(pack["folder"], "keyboard.json")).st_mtime_ns)
    except OSError:
        return None
    cached = GLIDE["packs"].get(lang)
    if cached and cached["stamp"] == stamp:
        return cached
    # Whose words: two layouts of a language share them (and one copy).
    words_lang = pack["words_lang"]
    english = words_lang == "en"
    decoders = GLIDE.setdefault("decoders", {})
    shared = decoders.get(pack["words"])
    if shared and shared[0] == (stamp[1], english):
        decoder = shared[1]
    else:
        try:
            decoder = barry_glide.Decoder(pack["words"], english)
        except (OSError, ValueError) as err:
            log(f"keyboard {lang}: cannot read {pack['words']}: {err}")
            return None
        decoders[pack["words"]] = ((stamp[1], english), decoder)
    personal = os.path.join(DATA, "personal-words.txt" if english else f"personal-words-{words_lang}.txt")
    positions = barry_glide.grid_positions(pack["grid"]) if pack["grid"] else None
    entry = {"stamp": stamp, "decoder": decoder,
             "corrector": barry_glide.Corrector(decoder, personal, pack["rows"], pack["more"], positions),
             # A held key's letter ("é") glides over the key it is on ("e").
             "fold": {a.lower(): base.lower() for base, alts in pack["more"].items() if len(base) == 1
                      for a in alts if len(a) == 1}}
    GLIDE["packs"][lang] = entry
    log(f"keyboard {lang}: {len(decoder.words)} words")
    return entry


def load_dictionary() -> None:
    with GLIDE["lock"]:
        dictionary("en")


def suggest(body: dict) -> tuple[int, dict]:
    """The strip's words for the word being typed: near words, completions."""
    prefix = body.get("prefix")
    if not isinstance(prefix, str) or len(prefix) > 40:
        return 400, {"error": "need prefix"}
    with GLIDE["lock"]:
        d = dictionary(body.get("lang", "en"))
        return 200, {"words": d["corrector"].suggest(prefix) if d else []}


def glide(body: dict) -> tuple[int, dict]:
    """The likeliest words for a glide over the keyboard (barry_glide)."""
    path, keys, size = body.get("path"), body.get("keys"), body.get("size")
    point = lambda p: (isinstance(p, list) and len(p) == 2
                       and all(isinstance(v, (int, float)) for v in p))
    if not (isinstance(path, list) and 2 <= len(path) <= 4000 and all(map(point, path))
            and isinstance(keys, dict) and all(isinstance(k, str) and point(v) for k, v in keys.items())
            and isinstance(size, (int, float)) and size > 0):
        return 400, {"error": "need path, keys and size"}
    with GLIDE["lock"]:
        d = dictionary(body.get("lang", "en"))
        return 200, {"words": d["decoder"].decode(path, keys, float(size), fold=d["fold"]) if d else []}


class Handler(BaseHTTPRequestHandler):
    # One connection for a stream of requests, each reply sent at once: with
    # Nagle's algorithm on, the body written after the headers waits for an
    # ACK the client delays (tens of ms a reply).
    protocol_version = "HTTP/1.1"
    disable_nagle_algorithm = True

    def _json(self, code: int, obj) -> None:
        self._send(code, json.dumps(obj).encode())

    def _send(self, code: int, body: bytes) -> None:
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> dict:
        try:
            n = int(self.headers.get("Content-Length", "0"))
            if n > 4096:
                # Left unread, it would be taken for the next request.
                self.close_connection = True
            data = json.loads(self.rfile.read(n) if 0 < n <= 4096 else b"{}")
            return data if isinstance(data, dict) else {}
        except ValueError:
            return {}

    def do_GET(self) -> None:
        path, _, query = self.path.partition("?")
        # The topics' answers are kept ready (publish): sent as they are.
        if path == "/keyboard":
            # With the keyboard's panel height (?h=), as it once polled.
            h = urllib.parse.parse_qs(query).get("h", [""])[0]
            if h.isdigit():
                set_keyboard_height(int(h))
            self._send(200, EVENTS.answer("keyboard"))
        elif path[:1] == "/" and path[1:] in TOPICS:
            self._send(200, EVENTS.answer(path[1:]))
        elif path == "/layout":
            refresh_user_apps()
            self._json(200, layout_json())
        elif path == "/game-links":
            refresh_user_apps()
            self._json(200, game_links_json())
        else:
            self._json(404, {"error": "not found"})

    def _local(self) -> bool:
        return (self.headers.get("Host", "") in (f"127.0.0.1:{PORT}", f"localhost:{PORT}")
                and self.headers.get("Origin") is None
                and self.headers.get("Content-Type", "").split(";")[0].strip() == "application/json")

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        body = self._body()
        if not self._local():
            self._json(403, {"error": "local JSON requests only"})
        elif path == "/launch":
            self._json(*launch(str(body.get("app", ""))))
        elif path == "/close":
            self._json(*close(str(body.get("app", ""))))
        elif path == "/home":
            if DESKTOP:
                go_home()
            else:
                open_barry("asked")
            self._json(200, {"ok": True})
        elif path == "/barry":
            why = str(body.get("why", "the shell"))[:40]
            if DESKTOP:
                self._json(409, {"error": "Game Mode only"})
            else:
                page = body.get("page")
                if body.get("open") and page in (PAGE_DASHBOARD, PAGE_QUICK):
                    threading.Thread(target=open_side, args=(page, why), daemon=True).start()
                elif body.get("open"):
                    threading.Thread(target=open_barry, args=(why,), daemon=True).start()
                else:
                    back = body.get("back") if isinstance(body.get("back"), bool) else None
                    threading.Thread(target=close_barry, args=(why, back), daemon=True).start()
                self._json(200, {"ok": True})
        elif path == "/side-prepare":
            threading.Thread(target=side_prepare, daemon=True).start()
            self._json(200, {"ok": True})
        elif path == "/home-ready":
            if body.get("serial") == STATE.home_serial:
                STATE.home_ready.set()
            self._json(200, {"ok": True})
        elif path == "/keyboard":
            if not body.get("visible") and STATE.keyboard()["visible"]:
                STATE.hidden_by_hand = time.monotonic()
            STATE.set_keyboard(bool(body.get("visible")))
            self._json(200, STATE.keyboard())
        elif path == "/keyd":
            self._json(*keyd_do(body))
        elif path == "/type":
            self._json(*type_input(body))
        elif path == "/glide":
            self._json(*glide(body))
        elif path == "/suggest":
            self._json(*suggest(body))
        elif path == "/layout":
            self._json(*set_layout(body))
        elif path == "/apps/check":
            self._json(*check_app(body))
        elif path == "/apps/install":
            self._json(*install_app(body))
        elif path == "/apps/remove":
            self._json(*remove_app(body))
        elif path == "/game-links":
            self._json(*set_game_links(body))
        elif path == "/game-event":
            self._json(*game_event(body))
        elif path == "/desktop" and DESKTOP:
            # barry_launcher_desktop_switch, before it stops Barry.
            self._json(200, {"ok": barry_desktop.set_enabled(bool(body.get("enabled", True)))})
        else:
            self._json(404, {"error": "not found"})

    def log_message(self, *_args) -> None:
        pass


def watch_touches() -> None:
    """Swipes up from the bottom screen's edge. (When and where touches come
    down, and taps on fields, are barry_launcher_keyd's.) Reading an evdev
    node does not take its events away from gamescope."""
    for name_file in glob.glob("/sys/class/input/event*/device/name"):
        try:
            with open(name_file, encoding="utf-8") as fh:
                if fh.read().strip() != TOUCH_NAME:
                    continue
        except OSError:
            continue
        dev = "/dev/input/" + name_file.split("/")[4]
        try:
            fd = os.open(dev, os.O_RDONLY)
        except OSError as err:
            log(f"cannot read {dev} ({TOUCH_NAME}): {err}; no swipe up for home")
            return
        log(f"watching swipes on {dev}")
        # Per slot, as the kernel keeps them: a new contact repeats no
        # coordinate that has not changed.
        slot = 0
        pos: dict[int, list] = {}
        down: set[int] = set()
        lead = None  # the slot of the touch's first finger
        multi = False  # a second finger joined: neither tap nor swipe
        start = None  # the first finger's first position
        started_at = 0.0
        with os.fdopen(fd, "rb", buffering=0) as fh:
            while True:
                data = fh.read(INPUT_EVENT.size)
                if len(data) < INPUT_EVENT.size:
                    return
                _, _, etype, code, value = INPUT_EVENT.unpack(data)
                if etype == EV_SYN:
                    p = pos.get(lead)
                    if lead in down and start is None and p and None not in p:
                        start, started_at = tuple(p), time.monotonic()
                    continue
                if etype != EV_ABS:
                    continue
                if code == ABS_MT_SLOT:
                    slot = value
                elif code == ABS_MT_TRACKING_ID:
                    if value >= 0:
                        if not down:
                            lead, multi, start = slot, False, None
                        else:
                            multi = True
                        down.add(slot)
                    else:
                        down.discard(slot)
                        if not down:
                            end = pos.get(lead)
                            if not multi and start and end and None not in end:
                                touch_ended(start, tuple(end), time.monotonic() - started_at)
                            start = None
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    pos.setdefault(slot, [None, None])[code - ABS_MT_POSITION_X] = value
    log(f"no {TOUCH_NAME} input device; no swipe up for home")


def raw_to_screen(raw_x: int, raw_y: int) -> tuple[int, int]:
    """The panel is portrait and turned right: its y runs left to right on
    screen, its x bottom to top."""
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    return raw_y, screen_h - 1 - raw_x


def touch_ended(start: tuple, end: tuple, seconds: float) -> None:
    """A one-finger touch lifted: a swipe up from the bottom edge, if it was
    one. (Side swipes are Barry.Input's EdgeSwipe: they follow the finger;
    taps are barry_launcher_keyd's.)"""
    if abs(end[0] - start[0]) + abs(end[1] - start[1]) < TAP_SLOP:
        return
    # Raw x runs bottom to top on screen (raw_to_screen).
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    start_y, end_y = screen_h - 1 - start[0], screen_h - 1 - end[0]
    if start_y >= screen_h - HOME_SWIPE_EDGE and start_y - end_y >= HOME_SWIPE_MIN and seconds <= HOME_SWIPE_S:
        GLib.idle_add(on_home_swipe, raw_to_screen(*end))


def on_home_swipe(lifted: tuple[int, int]) -> bool:
    if DESKTOP:
        log("swipe up from the bottom edge: home")
        go_home()
    elif STATE.front is None or not running(STATE.front):
        # Over the game art (or Barry) it is no way in: a thumb holding the
        # Thor slid up the edge, opened Barry and then landed on a tile.
        # A tap or the AYN button wakes Barry there.
        log("swipe up from the bottom edge over the game art: ignored")
    else:
        # Where it lifted: the thumb comes back down there on its way to
        # the edge, onto the bottom row's tiles (Shell.qml: no tap there
        # just after).
        threading.Thread(target=open_barry, args=("swipe up from the bottom edge", 0, lifted),
                         daemon=True).start()
    return False


def under_shot() -> str:
    """A picture of the bottom screen as it shows now (this gamescope's
    screenshot): UNDER_SHOT, or "" if none came in time."""
    with STATE.under_lock:
        shot = take_under_shot()
        STATE.under_taken = time.monotonic() if shot else 0.0
        return shot


def take_under_shot() -> str:
    try:
        os.remove(UNDER_SHOT)
    except OSError:
        pass
    started = time.monotonic()
    try:
        subprocess.run(["gamescopectl", "screenshot", UNDER_SHOT], capture_output=True, timeout=UNDER_SHOT_S)
    except (OSError, subprocess.TimeoutExpired) as err:
        log(f"no picture of the app for the side page: {err}")
        return ""
    # gamescope writes the file itself, a moment after it says so.
    end = time.monotonic() + UNDER_SHOT_S
    size = -1
    while time.monotonic() < end:
        try:
            now = os.path.getsize(UNDER_SHOT)
        except OSError:
            now = -1
        if now > 0 and now == size:
            log(f"picture of the app for the side page in {time.monotonic() - started:.2f} s")
            return UNDER_SHOT
        size = now
        time.sleep(0.03)
    log("no picture of the app for the side page: gamescope wrote none in time")
    return ""


def app_in_front() -> bool:
    """An app (not a tool: the trackpad, the Deck controls) shows, Barry
    closed: side swipes pull Barry's side pages over it."""
    app = STATE.front
    return (not DESKTOP and not barry_up() and app is not None and running(app) is not None
            and not APPS.get(app, {}).get("tool"))


def side_prepare() -> None:
    """A finger at a side edge over an app: its picture now, so the page it
    may pull comes without waiting for one."""
    if app_in_front():
        under_shot()


def open_side(page: int, why: str) -> None:
    """A side page over the app in front, sliding in over its picture: the
    one taken at the finger's touch-down if it is fresh, else one now."""
    if not app_in_front():
        return
    with STATE.under_lock:
        fresh = STATE.under_taken and time.monotonic() - STATE.under_taken < UNDER_FRESH_S
    shot = UNDER_SHOT if fresh and os.path.exists(UNDER_SHOT) else under_shot()
    with STATE.barry_lock:
        STATE.under = shot
    STATE.quiet_until = time.monotonic() + SIDE_QUIET_S
    open_barry(why, page)
    publish("home", "keyd")  # under and quietUntil, if Barry was open already
    if not STATE.barry_open:
        STATE.under = ""
        publish("home")


def keyd_state() -> dict:
    """What barry_launcher_keyd's rules need from here (times: monotonic
    seconds, the clock it reads too)."""
    with STATE.lock:
        top_visible = STATE.top_keyboard["visible"]
    return dict(STATE.keyboard(), barryUp=barry_up(), topInputRunning=running(TOP_INPUT_APP) is not None,
                topKeyboardVisible=top_visible, quietUntil=STATE.quiet_until, hiddenByHand=STATE.hidden_by_hand,
                keyboardHeight=STATE.keyboard_height, browserProfile=os.path.join(DATA, APPS["browser"]["profile"]))


def keyd_do(body: dict) -> tuple[int, dict]:
    """barry_launcher_keyd's call: "show" the bottom keyboard, "hide" it,
    "top", the Trackpad app's keys for a top-screen field, or "top-down",
    the Trackpad app's full trackpad again."""
    what, why = body.get("do"), str(body.get("why", "keyd"))[:80]
    if what == "show":
        STATE.set_keyboard(True, False)  # always at the bottom: the app moves up above it
    elif what == "hide":
        STATE.set_keyboard(False)
    elif what == "top":
        if DESKTOP:
            top_field_keyboard(why)
        else:
            STATE.set_top_keyboard(True, why)
    elif what == "top-down":
        STATE.set_top_keyboard(False, why)
    else:
        return 400, {"error": "do: show, hide, top or top-down"}
    return 200, {"ok": True}


def top_field_keyboard(why: str) -> None:
    """Desktop Mode, a field on the top screen: the Trackpad app's keys come
    up, as in Game Mode (top_text_focus), with the trackpad above them; the
    app opens with them up if it is not running. The bottom screen's own
    keyboard is for the fields of Barry's apps there."""
    if STATE.keyboard()["visible"]:
        STATE.set_keyboard(False)
    if running(TOP_INPUT_APP):
        # Asked every time: the app puts its keys away by itself (its ⌄
        # key), so "visible" here may be stale. Typing on them asks nothing,
        # as only a top-screen press just before counts.
        STATE.set_top_keyboard(True, why)
    else:
        log(f"{why}: Trackpad app with its keyboard")
        launch(TOP_KEYBOARD)


def started(app: str, proc: subprocess.Popen) -> None:
    """An app's process started: it runs until its pidfd says it ended
    (app_ended)."""
    STATE.apps[app] = proc
    try:
        fd = os.pidfd_open(proc.pid)
    except ProcessLookupError:
        # Ended and reaped already (a poll() elsewhere).
        GLib.idle_add(app_ended, app, proc)
    except OSError:
        # No pidfds (an old kernel): GLib's child watch reaps it instead.
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, lambda *_: app_ended(app, proc))
    else:
        def ended(_fd, _cond) -> bool:
            os.close(fd)
            return app_ended(app, proc)
        GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, fd, GLib.IOCondition.IN, ended)
    write_top_input()
    publish("apps", "home", "keyd")


def app_ended(app: str, proc: subprocess.Popen) -> bool:
    """An app's process ended (main loop). Its fields are gone too."""
    proc.poll()  # reaped here, as Popen does
    if STATE.apps.get(app) is not proc:
        return False  # started again since
    log(f"{app} exited ({proc.returncode})")
    # Its service (stopped below) may still be frozen.
    thaw(app, "exited")
    with STATE.life_lock:
        STATE.life.pop(app, Background()).cancel()
    del STATE.apps[app]
    tool_gone(proc.pid)
    if STATE.front == app:
        STATE.front = None  # gamescope shows the home window again
        publish("home")
        if STATE.home_win and not barry_up():
            bring_forward(None)  # unmapped as Barry closed back to it
    if app in STATE.services:
        threading.Thread(target=barry_apps.stop_service, args=(STATE.services.pop(app),), daemon=True).start()
    STATE.set_keyboard(False)
    write_top_input()
    publish("apps", "home", "keyd")
    return False


TOP_INPUT_WRITTEN: list = [None]  # what TOP_INPUT_FLAG says
TOP_INPUT_LOCK = threading.Lock()


def write_top_input() -> None:
    """TOP_INPUT_FLAG: whether the Trackpad app runs (sm8550-thor-backlightd).
    Without it (not a Thor) it is tried again at the next change."""
    top_input = not DESKTOP and running(TOP_INPUT_APP) is not None
    with TOP_INPUT_LOCK:
        if top_input == TOP_INPUT_WRITTEN[0]:
            return
        try:
            with open(TOP_INPUT_FLAG, "w", encoding="utf-8") as fh:
                fh.write("1" if top_input else "0")
            TOP_INPUT_WRITTEN[0] = top_input
        except OSError:
            pass


class Background:
    """A running app's life off the screen (see the top): its timers (GLib
    sources, armed on the main loop), whether it is frozen and plays
    sound, and when it was last on the screen."""

    def __init__(self) -> None:
        self.frozen: list[str] = []  # the cgroups frozen (the app's, its service's); [] when thawed
        self.freeze_timer = 0
        self.close_timer = 0
        self.shown = True  # on the screen at the last look (background_changed)
        self.left_at = time.monotonic()  # when it was last on the screen (or stopped playing sound)
        self.playing = False
        self.no_scope = False  # said once: it has no scope of its own to freeze
        self.closing = False  # thawed to be closed: never frozen again

    def cancel(self) -> None:
        for timer in (self.freeze_timer, self.close_timer):
            if timer:
                GLib.source_remove(timer)
        self.freeze_timer = self.close_timer = 0


def scope_probe() -> None:
    """Can apps start in systemd user scopes of their own? Tried once, at
    start: systemd-run --user --scope (it needs the user's systemd), bound
    to shelld's own service, so they stop with it as they did inside it.
    Not ordered after it: they stop together, and this thaws them as it
    gets its SIGTERM (systemd does not know of a freeze written to
    cgroup.freeze, and a frozen app would sit on its SIGTERM until
    TimeoutStopSec's SIGKILL). Without, apps start as before and are never
    frozen."""
    if DESKTOP:
        return
    STATE.own_cgroup = proc_cgroup(os.getpid())
    cmd = ["systemd-run", "--user", "--scope", "--quiet", "--collect", "-p", "TimeoutStopSec=5"]
    unit = os.path.basename(STATE.own_cgroup)
    if unit.endswith(".service"):
        cmd += ["-p", f"BindsTo={unit}"]
    try:
        r = subprocess.run([*cmd, f"--unit={SCOPE_PREFIX}probe-{os.getpid()}", "--", "true"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as err:
        log(f"apps not in scopes of their own (never frozen): {err}")
        return
    if r.returncode != 0:
        log(f"apps not in scopes of their own (never frozen): {r.stderr.strip()[-200:]}")
        return
    STATE.scope_cmd = cmd
    log("apps start in scopes of their own" + (f", bound to {unit}" if unit.endswith(".service") else ""))


def scope_prefix(app: str, part: str = "") -> list[str]:
    """What an app's command starts with to run in a scope of its own
    (systemd-run execs it in place: the pid, and its pidfd, are the
    app's); nothing for a tool (never frozen) or without scopes."""
    if STATE.scope_cmd is None or APPS.get(app, {}).get("tool"):
        return []
    with STATE.life_lock:
        STATE.scope_seq += 1
        seq = STATE.scope_seq
    name = f"{app}-{part}" if part else app
    return [*STATE.scope_cmd, f"--unit={SCOPE_PREFIX}{name}-{os.getpid()}-{seq}", "--"]


def proc_cgroup(pid: int) -> str:
    """The cgroup (its path under CGROUP_ROOT) of process pid, or ""."""
    try:
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as fh:
            return next((line[3:].strip() for line in fh if line.startswith("0::")), "")
    except OSError:
        return ""


def app_cgroups(app: str) -> list[str]:
    """The scopes an app (and its service) runs in, to freeze: only ours
    and Flatpak's (FROZEN_SCOPES), never shelld's own nor one holding it.
    Looked up as needed: Flatpak moves its app into its scope as it starts."""
    out = []
    for proc in (running(app), STATE.services.get(app)):
        if proc is None or proc.poll() is not None:
            continue
        path = proc_cgroup(proc.pid)
        leaf = os.path.basename(path)
        own = STATE.own_cgroup
        if (leaf.endswith(".scope") and leaf.startswith(FROZEN_SCOPES) and path != own
                and not own.startswith(path + "/")):
            out.append(CGROUP_ROOT + path)
    return out


def write_freeze(cgroup: str, on: bool) -> bool:
    try:
        with open(os.path.join(cgroup, "cgroup.freeze"), "w", encoding="utf-8") as fh:
            fh.write("1" if on else "0")
        return True
    except OSError as err:
        if on or os.path.isdir(cgroup):  # a scope gone with its app needs no thaw
            log(f"cannot {'freeze' if on else 'thaw'} {cgroup}: {err}")
        return False


def frozen(app: str) -> bool:
    # No lock: publish asks this with EVENTS.lock held.
    life = STATE.life.get(app)
    return bool(life and life.frozen)


def on_screen(app: str) -> bool:
    """The app shows: in front, Barry closed."""
    return STATE.front == app and not STATE.barry_open


def may_freeze(app: str) -> bool:
    spec = APPS.get(app, {})
    return not DESKTOP and STATE.scope_cmd is not None and not spec.get("tool") and not spec.get("keepAwake")


def thaw(app: str, why: str) -> None:
    """Thaw a frozen app (any thread): before its window shows, before it
    is closed. Its timer to close it goes."""
    with STATE.life_lock:
        life = STATE.life.get(app)
        if life is None or not life.frozen:
            return
        for cgroup in life.frozen:
            write_freeze(cgroup, False)
        life.frozen = []
        if life.close_timer:
            GLib.source_remove(life.close_timer)
            life.close_timer = 0
    log(f"{app} thawed ({why})")
    publish("apps")


def thaw_all(why: str) -> None:
    for app in list(STATE.life):
        thaw(app, why)


BACKGROUND_QUEUED = [False]
BACKGROUND_QUEUE_LOCK = threading.Lock()


def background_soon() -> None:
    """Something that decides what shows changed (publish): look again on
    the main loop, once for a burst."""
    with BACKGROUND_QUEUE_LOCK:
        if BACKGROUND_QUEUED[0]:
            return
        BACKGROUND_QUEUED[0] = True
    GLib.idle_add(background_changed)


def background_changed() -> bool:
    """Which apps show changed (main loop): each app that left the screen
    gets FREEZE_S before it is frozen (freeze_due), one that came back
    loses its timers. Thawing is not left to this: launch and close_barry
    thaw an app before its window shows."""
    with BACKGROUND_QUEUE_LOCK:
        BACKGROUND_QUEUED[0] = False
    thaw_late = []
    with STATE.life_lock:
        now = time.monotonic()
        for app in list(STATE.apps):
            if running(app) is None or APPS.get(app, {}).get("tool"):
                continue
            life = STATE.life.setdefault(app, Background())
            if on_screen(app):
                life.shown = True
                life.cancel()
                if life.frozen:
                    thaw_late.append(app)
                continue
            if life.shown:
                life.shown = False
                life.left_at = now
            if (not life.frozen and not life.freeze_timer and not life.playing and not life.closing
                    and may_freeze(app)):
                life.freeze_timer = GLib.timeout_add(max(0, int((life.left_at + FREEZE_S - now) * 1000)),
                                                     freeze_due, app)
        want_audio = any(may_freeze(a) for a in STATE.life)
    for app in thaw_late:
        thaw(app, "on the screen")  # a safety net
    audio_wanted(want_audio)
    return False


def freeze_due(app: str) -> bool:
    """FREEZE_S off the screen (main loop): frozen, unless it came back,
    plays sound or ended meanwhile; closed BACKGROUND_CLOSE_S after it
    left the screen (close_due)."""
    with STATE.life_lock:
        life = STATE.life.get(app)
        if life is None:
            return False
        life.freeze_timer = 0
        if (running(app) is None or on_screen(app) or life.playing or life.frozen or life.closing
                or not may_freeze(app)):
            return False
        cgroups = app_cgroups(app)
        if not cgroups:
            if not life.no_scope:
                life.no_scope = True
                log(f"{app} has no scope of its own: not frozen")
            return False
        life.frozen = [c for c in cgroups if write_freeze(c, True)]
        if not life.frozen:
            return False
        life.close_timer = GLib.timeout_add(
            max(0, int((life.left_at + BACKGROUND_CLOSE_S - time.monotonic()) * 1000)), close_due, app)
    log(f"{app} frozen ({FREEZE_S:.0f} s off the screen)")
    publish("apps")
    return False


def close_due(app: str) -> bool:
    """A frozen app BACKGROUND_CLOSE_S off the screen (main loop): closed
    (close thaws it first)."""
    with STATE.life_lock:
        life = STATE.life.get(app)
        if life is None:
            return False
        life.close_timer = 0
        if not life.frozen:
            return False
    log(f"{app}: off the screen for {BACKGROUND_CLOSE_S / 60:.0f} min; closing it")
    close(app)
    return False


def watch_pressure() -> None:
    """Memory pressure (a PSI trigger on PSI_PATH, POLLPRI as it fires):
    each time, the frozen app least recently on the screen closes. A FIFO
    in its place (tests): each write is one trigger."""
    if DESKTOP:
        return
    try:
        fifo = stat.S_ISFIFO(os.stat(PSI_PATH).st_mode)
        fd = os.open(PSI_PATH, os.O_RDWR | os.O_NONBLOCK)  # a FIFO's own writer too: no HUP
        if not fifo:
            os.write(fd, PSI_TRIGGER.encode() + b"\0")
    except OSError as err:
        log(f"no memory pressure trigger ({PSI_PATH}): {err}")
        return

    def fired(_fd, cond) -> bool:
        if fifo:
            try:
                os.read(fd, 4096)
            except BlockingIOError:
                return True
        elif cond & (GLib.IOCondition.ERR | GLib.IOCondition.HUP | GLib.IOCondition.NVAL):
            log("memory pressure trigger gone")
            return False
        with STATE.life_lock:
            frozen_apps = sorted((life.left_at, app) for app, life in STATE.life.items() if life.frozen)
        if not frozen_apps:
            log("memory pressure: no frozen app to close")
            return True
        app = frozen_apps[0][1]
        log(f"memory pressure: closing {app} (frozen, least recently used)")
        close(app)
        return True
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, fd, GLib.IOCondition.IN if fifo else GLib.IOCondition.PRI, fired)
    log(f"memory pressure trigger on {PSI_PATH}" + ("" if fifo else f" ({PSI_TRIGGER})"))


AUDIO = {"proc": None, "watch": 0, "settle": 0, "retry": 0, "buf": b""}  # main loop only


def audio_wanted(want: bool) -> None:
    """pactl subscribe runs while an app that may be frozen runs."""
    if want and AUDIO["proc"] is None and not AUDIO["retry"]:
        audio_start()
    elif not want and AUDIO["proc"] is not None:
        audio_stop()


def audio_start() -> None:
    try:
        # Line by line: into a pipe, pactl's output would wait for a full buffer.
        proc = subprocess.Popen(["stdbuf", "-oL", "pactl", "subscribe"], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as err:
        log(f"cannot follow sound (pactl subscribe): {err}; an app playing it may be frozen")
        return
    AUDIO["proc"] = proc
    fd = proc.stdout.fileno()
    os.set_blocking(fd, False)
    AUDIO["watch"] = GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, fd,
                                           GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR,
                                           audio_event)
    audio_check()  # the streams there already


def audio_stop() -> None:
    proc, AUDIO["proc"] = AUDIO["proc"], None
    for key in ("watch", "settle", "retry"):
        if AUDIO[key]:
            GLib.source_remove(AUDIO[key])
            AUDIO[key] = 0
    AUDIO["buf"] = b""
    if proc:
        proc.kill()
        proc.wait()
        proc.stdout.close()


def audio_event(fd, _cond) -> bool:
    """pactl subscribe's lines: a sink-input (a stream) came, changed
    (corked, uncorked) or went; looked at once a burst has settled."""
    try:
        data = os.read(fd, 65536)
    except BlockingIOError:
        return True
    except OSError:
        data = b""
    if not data:
        AUDIO["watch"] = 0  # this source ends with False
        audio_stop()
        log(f"pactl subscribe ended; again in {AUDIO_RETRY_S} s")

        def retry() -> bool:
            AUDIO["retry"] = 0
            background_changed()
            return False
        AUDIO["retry"] = GLib.timeout_add_seconds(AUDIO_RETRY_S, retry)
        return False
    AUDIO["buf"] += data
    *lines, AUDIO["buf"] = AUDIO["buf"].split(b"\n")
    if any(b"sink-input" in line for line in lines) and not AUDIO["settle"]:
        AUDIO["settle"] = GLib.timeout_add(AUDIO_SETTLE_MS, audio_settled)
    return True


def audio_settled() -> bool:
    AUDIO["settle"] = 0
    audio_check()
    return False


def pactl_json(*args: str) -> list:
    try:
        r = subprocess.run(["pactl", "-f", "json", *args], capture_output=True, text=True, timeout=2)
        out = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    return out if isinstance(out, list) else []


def audio_check() -> None:
    """Which apps play sound (main loop): a stream not corked whose process
    is in the app's scope, the process as the stream says
    (application.process.id) or as PipeWire saw it connect (its client's
    pipewire.sec.pid: a Flatpak's own pid is its sandbox's). One that plays
    is not frozen (thawed, if it was); one that stopped gets FREEZE_S from
    now."""
    clients = {str(c.get("index")): c.get("properties") for c in pactl_json("list", "clients")
               if isinstance(c, dict)}
    pids = set()
    for s in pactl_json("list", "sink-inputs"):
        if not isinstance(s, dict) or s.get("corked") is not False:
            continue
        for props in (s.get("properties"), clients.get(str(s.get("client")))):
            for key in ("application.process.id", "pipewire.sec.pid"):
                value = str(props.get(key, "")) if isinstance(props, dict) else ""
                if value.isdigit():
                    pids.add(int(value))
    playing_in = {proc_cgroup(pid) for pid in pids} - {""}
    changed = []
    with STATE.life_lock:
        for app, life in list(STATE.life.items()):
            mine = [c[len(CGROUP_ROOT):] for c in app_cgroups(app)]
            playing = any(c == m or c.startswith(m + "/") for c in playing_in for m in mine)
            if playing == life.playing:
                continue
            life.playing = playing
            changed.append((app, playing))
            if playing and life.freeze_timer:
                GLib.source_remove(life.freeze_timer)
                life.freeze_timer = 0
            elif not playing:
                life.left_at = max(life.left_at, time.monotonic())  # FREEZE_S from now, if off the screen
    for app, playing in changed:
        log(f"{app} {'plays sound: kept awake' if playing else 'stopped playing sound'}")
        if playing:
            thaw(app, "plays sound")
    background_changed()


