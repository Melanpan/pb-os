[Unit]
Description=AYN Thor: a volume for each screen (PipeWire's "Top screen" output)
# Links the PipeWire config before the user session starts its audio.
# Other devices never run this.
After=etc.mount local-fs.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible'
ExecStart=/bin/sh -c 'mkdir -p /etc/pipewire/pipewire.conf.d && ln -sfn /usr/share/pb-os/thor-audio/60-pbos-top-screen.conf /etc/pipewire/pipewire.conf.d/60-pbos-top-screen.conf'

[Install]
WantedBy=multi-user.target
