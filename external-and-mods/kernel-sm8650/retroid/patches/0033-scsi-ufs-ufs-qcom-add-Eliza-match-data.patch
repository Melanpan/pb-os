From 1213eb175774de1f4ba6577a4329bba58729840d Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Wed, 9 Sep 2026 16:21:08 +0700
Subject: [PATCH 33/71] scsi: ufs: ufs-qcom: add Eliza match data

The UFS PHY on Eliza does not retain its state across deep sleep, like
SM8550 and SM8650: with the default spm_lvl the link is parked in
hibern8 and the exit fails on resume ("hibern8 exit failed. ret = 5").
Match qcom,eliza-ufshc to the SM8550 driver data so system suspend
powers the link off instead.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/ufs/host/ufs-qcom.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 954be9343..9bda76403 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -3014,6 +3014,7 @@ static const struct of_device_id ufs_qcom_of_match[] __maybe_unused = {
 	{ .compatible = "qcom,ufshc" },
 	{ .compatible = "qcom,sm8550-ufshc", .data = &ufs_qcom_sm8550_drvdata },
 	{ .compatible = "qcom,sm8650-ufshc", .data = &ufs_qcom_sm8550_drvdata },
+	{ .compatible = "qcom,eliza-ufshc", .data = &ufs_qcom_sm8550_drvdata },
 	{ .compatible = "qcom,sa8255p-ufshc", .data = &ufs_qcom_sa8255p_drvdata },
 	{},
 };
