
/*
 * pb-os: IDs for a stock Qualcomm ABL (`fastboot boot KERNEL-rpduo`; there is
 * no OpenABL for SM7750). Its DTB match (LocateDeviceTree.c) drops a DTB
 * whose qcom,msm-id has no entry for the chip (low 16 bits), so this lists
 * every Eliza id in dt-bindings/arm/qcom,ids.h: SM7750 (659) and the
 * Dragonwing CQ7790M/S (731/732; Retroid sells the Duo as "Q-7790"). SoC
 * revision 1.0: an equal one is an exact match, an older one still a best
 * match. board-id variant 0 is never rejected. Untested: no Duo in hand.
 */
/ {
	qcom,msm-id = <659 0x10000>, <731 0x10000>, <732 0x10000>;
	qcom,board-id = <0 0>;
};
