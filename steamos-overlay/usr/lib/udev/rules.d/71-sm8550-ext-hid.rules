# Real USB/BT keyboard or mouse only. Never match virtual devices (deck-uhid,
# InputPlumber's own keyboard: uinput/uhid under /devices/virtual; the deck
# target: USB/IP on vhci_hcd):
# that restarted the composite in a loop and Steam never started.
# systemd ignores SYSTEMD_WANTS on "remove", so unplugging the last external
# keyboard never gave InputPlumber its virtual keyboard back (and with it the
# volume-up key on devices where it shares gpio-keys with the gamepad, like
# the Retroid Pocket 6). Removal starts the service directly.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", \
  ENV{ID_BUS}=="usb|bluetooth", ENV{ID_INPUT_KEYBOARD}=="1", \
  ENV{ID_VENDOR_ID}!="28de", DEVPATH!="/devices/virtual/*", DEVPATH!="*/vhci_hcd*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="sm8550-inputplumber-ext-hid.service"

ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", \
  ENV{ID_BUS}=="usb|bluetooth", ENV{ID_INPUT_MOUSE}=="1", \
  ENV{ID_VENDOR_ID}!="28de", DEVPATH!="/devices/virtual/*", DEVPATH!="*/vhci_hcd*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="sm8550-inputplumber-ext-hid.service"

# Any USB/BT input removal: the helper re-checks what is still attached.
ACTION=="remove", SUBSYSTEM=="input", KERNEL=="event*", \
  ENV{ID_BUS}=="usb|bluetooth", ENV{ID_VENDOR_ID}!="28de", DEVPATH!="/devices/virtual/*", DEVPATH!="*/vhci_hcd*", \
  RUN+="/usr/bin/systemctl --no-block start sm8550-inputplumber-ext-hid.service"

# One of InputPlumber's Steam controllers appeared: the generic one
# (deck-uhid, a uhid device; steamos-manager resets the composite to it at
# boot) or a real Steam Deck one (deck, USB/IP on vhci_hcd). The helper keeps
# the device at one controller, the real Steam Deck one. Its own switch only
# runs it once more, to no change.
ACTION=="add", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", DEVPATH=="/devices/virtual/misc/uhid/0003:28DE:*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="sm8550-inputplumber-ext-hid.service"
ACTION=="add", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", DEVPATH=="*/vhci_hcd*", KERNELS=="0003:28DE:*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="sm8550-inputplumber-ext-hid.service"
