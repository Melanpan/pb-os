#!/bin/sh
# pbos-hostname: name the device after its model (rp6, rpnova, thor, odin2,
# odin2mini, odin2portal, rpduo, kpf, pockets2) instead of the Steam Frame image's "frame". One image covers
# several models, so this runs at boot and reads the device tree. It only
# renames while the name is still the image's: a name set in Steam
# (Settings > System) or with hostnamectl is kept. /etc is an overlay on
# /var, so the new name lasts and updates keep it.

current=$(cat /etc/hostname 2>/dev/null)
case "$current" in
  ""|frame|localhost) ;;
  *) exit 0 ;;
esac

name=
for c in $(tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null); do
  case "$c" in
    retroidpocket,rp6*) name=rp6 ;;
    retroidpocket,rpnova) name=rpnova ;;
    retroidpocket,rpduo) name=rpduo ;;
    ayn,thor) name=thor ;;
    ayn,odin2) name=odin2 ;;
    ayn,odin2mini) name=odin2mini ;;
    ayn,odin2portal) name=odin2portal ;;
    konkr,pocket-fit) name=kpf ;;
    ayaneo,pocket-s2) name=pockets2 ;;
    *) continue ;;
  esac
  break
done
[ -n "$name" ] || exit 0
# A test image carries its build tag (scripts/test-access.sh): rpnova-onetest7.
tag=$(cat /etc/pbos-test/tag 2>/dev/null)
[ -z "$tag" ] || name="$name-$tag"

printf '%s\n' "$name" >/etc/hostname
hostname "$name"
echo "hostname: $name (was ${current:-unset})"
