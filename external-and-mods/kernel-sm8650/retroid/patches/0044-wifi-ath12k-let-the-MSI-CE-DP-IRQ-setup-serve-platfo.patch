From f2c4631acf1e6a497cee3610d1bcddbe13d1a75c Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:19 +0000
Subject: [PATCH 44/71] wifi: ath12k: let the MSI CE/DP IRQ setup serve
 platform devices

ath12k_pci_get_msi_irq() resolves vectors through the PCI MSI API only.
Dispatch on the bus type so a platform device whose MSI vectors are a
block of GIC SPIs in its "interrupts" property (WCN7750, as WCN6750 in
ath11k) can use the same CE and DP IRQ code, and export
ath12k_pci_config_irq()/ath12k_pci_free_irq() for it.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/net/wireless/ath/ath12k/pci.c | 11 +++++++----
 drivers/net/wireless/ath/ath12k/pci.h |  5 +++++
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index ad0362d30..07a1052aa 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -8,6 +8,7 @@
 #include <linux/interrupt.h>
 #include <linux/msi.h>
 #include <linux/pci.h>
+#include <linux/platform_device.h>
 #include <linux/time.h>
 #include <linux/vmalloc.h>
 
@@ -328,7 +329,7 @@ static void ath12k_pci_free_ext_irq(struct ath12k_base *ab)
 	}
 }
 
-static void ath12k_pci_free_irq(struct ath12k_base *ab)
+void ath12k_pci_free_irq(struct ath12k_base *ab)
 {
 	int i, irq_idx;
 
@@ -630,7 +631,7 @@ static int ath12k_pci_set_irq_affinity_hint(struct ath12k_pci *ab_pci,
 	return irq_set_affinity_and_hint(ab_pci->pdev->irq, m);
 }
 
-static int ath12k_pci_config_irq(struct ath12k_base *ab)
+int ath12k_pci_config_irq(struct ath12k_base *ab)
 {
 	struct ath12k_ce_pipe *ce_pipe;
 	u32 msi_data_start;
@@ -1006,9 +1007,11 @@ int ath12k_pci_map_service_to_pipe(struct ath12k_base *ab, u16 service_id,
 
 int ath12k_pci_get_msi_irq(struct device *dev, unsigned int vector)
 {
-	struct pci_dev *pci_dev = to_pci_dev(dev);
+	if (dev_is_pci(dev))
+		return pci_irq_vector(to_pci_dev(dev), vector);
 
-	return pci_irq_vector(pci_dev, vector);
+	/* WCN7750: GIC SPI block in the DT "interrupts" property */
+	return platform_get_irq(to_platform_device(dev), vector);
 }
 
 int ath12k_pci_get_user_msi_assignment(struct ath12k_base *ab, char *user_name,
diff --git a/drivers/net/wireless/ath/ath12k/pci.h b/drivers/net/wireless/ath/ath12k/pci.h
index 21b95bbe6..a071a351b 100644
--- a/drivers/net/wireless/ath/ath12k/pci.h
+++ b/drivers/net/wireless/ath/ath12k/pci.h
@@ -174,6 +174,11 @@ void ath12k_pci_stop(struct ath12k_base *ab);
 int ath12k_pci_start(struct ath12k_base *ab);
 int ath12k_pci_power_up(struct ath12k_base *ab);
 void ath12k_pci_power_down(struct ath12k_base *ab, bool is_suspend);
+
+/* Shared CE/MSI IRQ setup, reused by the WCN7750 AHB (WPSS) transport. */
+int ath12k_pci_config_irq(struct ath12k_base *ab);
+void ath12k_pci_free_irq(struct ath12k_base *ab);
+
 int ath12k_pci_register_driver(const enum ath12k_device_family device_id,
 			       struct ath12k_pci_driver *driver);
 void ath12k_pci_unregister_driver(const enum ath12k_device_family device_id);
-- 
