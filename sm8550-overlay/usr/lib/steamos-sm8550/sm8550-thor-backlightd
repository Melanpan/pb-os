#!/usr/bin/env python3
"""sm8550-thor-backlightd: AYN Thor bottom screen. One brightness for both
panels, the Barry Launcher plugin's bottom-screen switch, and the AYN button's dashboard overlay.

Brightness: Steam's Game Mode slider adjusts the first backlight it finds,
the bottom panel's (ae94000.dsi.0), and writes it directly (the video group
may), about ten times a second while the slider moves, from a file it keeps
open. Game Mode shows the top panel (ae96000.dsi.0). So that Steam's writes
never reach the bottom panel, this opens the panel's brightness file and
then bind-mounts STEAM_BOTTOM, a plain file, over it before Game Mode starts
(the unit runs before the display manager); Steam writes its level there and
this is the only writer of the bottom panel. Steam's level, a fraction of
the range (from STEAM_BOTTOM, or from the top panel should gamescope write
that), is kept in LEVEL. Each panel gets Steam's level times its own dimmer
from DIMMERS (percent, set by the Barry Launcher plugin; 100 when unset), so
Steam's slider moves both screens together. Steam's slider puts out its
position to the power STEAM_GAMMA (30% writes 7%): right for the top LCD, but
the bottom AMOLED is close to black that low, so the bottom panel gets the
slider's position itself, spread over the range the panel shows
(BOTTOM_VISIBLE). (A
steamos-priv-write redirect alone ran pkexec for every slider step and
lagged; it stays as a fallback.)

Bottom-screen switch: the Barry Launcher Decky plugin writes "off" or "on" to STATE. While the
bottom screen is off its backlight is powered down (bl_power; the brightness
Steam sets is kept underneath, so the top panel still follows) and its
touchscreen is inhibited. Both are enforced on every pass, because the panel
driver powers the backlight up again on each modeset and wake, and the Game
Mode / Desktop start scripts re-enable the touchscreen.

AYN button: InputPlumber leaves gpio-keys-ayn alone on the Thor (no device
config lists it, see 50-ayn_thor.yaml); this grabs it. A short
press of KEY_F24 toggles OVERLAY; holding it LONG_PRESS_S writes HOME, which
Barry Launcher watches to bring its home screen forward (and hides the
dashboard). Barry Launcher's dashboard shows itself
over whatever the bottom screen holds while OVERLAY is "1" (and writes "0"
itself if an idle time is set). While the overlay is up the bottom screen is on even if
the switch says off (from OVERLAY_DELAY_S after the press, once the
dashboard has drawn, so the app under it does not flash up); afterwards it
returns to the switch's state. While OVERLAY or TOP_INPUT (Barry Launcher's
Keyboard or Trackpad app open, written by barry_launcher_shelld) is "1",
Steam's gamescope also gets GAMESCOPE_BOTTOM_SCREEN_YIELD on its root:
should it be drawing a game's second window on the bottom screen (a DS or
3DS emulator's, gamescope's dual-screen branch), it hands the screen back to
Barry Launcher's gamescope for the dashboard or keyboard and takes it again
once both are "0". Holding the AYN button while such a game has the bottom
screen (GAMESCOPE_BOTTOM_SCREEN_SHOWING, 1 shown or 2 waiting) yields it for
Barry Launcher's home as well, until the button is held again or the game's
window is gone.

Charge rest: while sm8550-charge-rest has the device resting on the
charger (CHARGE_REST), both screens are its to power off and back on, and
this does nothing.

Idle dim: Steam dims the screens (and later sleeps) when it has seen no
input for a while, and touches on the bottom screen go to the bottom
session's gamescope, not Steam's. So a touch there brightens nothing until
the top screen or a button is used. This reads the bottom touchscreen
(without grabbing it) and, at most every NUDGE_S, taps right Shift on
Steam's display, which Steam counts as input. (Steam's display has no X
screensaver extension; moving the pointer also works but shows gamescope's
cursor on the top screen.)
"""
from __future__ import annotations

import fcntl
import glob
import ctypes
import grp
import json
import os
import pwd
import select
import signal
import struct
import subprocess
import sys
import time

BOTTOM = "/sys/class/backlight/ae94000.dsi.0"
TOP = "/sys/class/backlight/ae96000.dsi.0"
STATE = "/var/lib/steamos-sm8550/thor-bottom-screen"
CHARGE_REST = "/run/sm8550-charge-rest"  # sm8550-charge-rest: resting on the charger
DIMMERS = "/var/lib/steamos-sm8550/thor-screen-dimmers.json"
RUN_DIR = "/run/sm8550-thor"
LEVEL = f"{RUN_DIR}/steam-brightness"
STEAM_BOTTOM = f"{RUN_DIR}/steam-bottom-brightness"
FIRMWARE_TYPE = f"{RUN_DIR}/bottom-backlight-type"
DESKTOP_MAX = f"{RUN_DIR}/bottom-backlight-max"
IN_MODIFY = 0x2
STEAM_GAMMA = 2.2
OVERLAY = f"{RUN_DIR}/overlay"
TOP_INPUT = f"{RUN_DIR}/top-input"
HOME = f"{RUN_DIR}/home"  # a request counter; any change means "go home"
LONG_PRESS_S = 0.6
TOUCH_NAME = "bottom_touchscreen"
AYN_KEYS_NAME = "gpio-keys-ayn"
KEY_F24 = 194
EV_KEY = 1
EV_ABS = 3
EVIOCGRAB = 0x40044590
EVENT = struct.Struct("llHHi")
BL_ON, BL_OFF = "0", "4"  # FB_BLANK_UNBLANK, FB_BLANK_POWERDOWN
# The kernel notifies actual_brightness on changes; the timeout also paces
# enforcing the switch and retrying the AYN key device.
POLL_MS = 100
# The dashboard polls the flag every 200 ms, then maps and draws.
OVERLAY_DELAY_S = 0.5
# Steam's shortest idle dim is minutes; one nudge per this many seconds of
# touching keeps it awake.
NUDGE_S = 20
# Steam's display is looked for again this often while Game Mode is not up.
YIELD_RETRY_S = 2
# A panel that refused its brightness (off, or still coming up) is tried
# again this often.
PANEL_RETRY_S = 0.5
# Whether Desktop Mode (Plasma) is up is looked at this often.
MODE_CHECK_S = 2
# A new brightness is reached in a glide this long, a step every GLIDE_MS:
# sliders send a few values a second, and each jump showed as a tick.
GLIDE_S = 0.15
GLIDE_MS = 16
# The bottom AMOLED, measured on a Thor (2026-10-14): black up to about 200
# of 65535, dim but readable at 500, and brighter at every doubling up to
# the top. Both modes spread their slider evenly over those doublings, from
# 270 (the lowest the tester wanted) up.
BOTTOM_VISIBLE = 270


def log(msg: str) -> None:
    print(msg, flush=True)


def charge_rest() -> bool:
    """sm8550-charge-rest is resting (CHARGE_REST holds its live PID)."""
    try:
        with open(CHARGE_REST, encoding="utf-8") as fh:
            pid = fh.read().strip()
    except OSError:
        return False
    return pid.isdigit() and os.path.exists(f"/proc/{pid}")


def read(path: str, default: str = "") -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return default


def write(path: str, value: str, quiet: bool = False) -> bool:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(value)
        return True
    except OSError as err:
        if not quiet:
            log(f"cannot write {value} to {path}: {err}")
        return False


def read_dimmers(cache: dict) -> tuple[int, int]:
    """(top, bottom) percent; reread only when the file changes."""
    try:
        mtime = os.stat(DIMMERS).st_mtime_ns
    except OSError:
        return 100, 100
    if cache.get("mtime") != mtime:
        top = bottom = 100
        try:
            with open(DIMMERS, encoding="utf-8") as fh:
                d = json.load(fh)
            top = max(1, min(100, int(d.get("top", 100))))
            bottom = max(1, min(100, int(d.get("bottom", 100))))
        except (OSError, ValueError, TypeError, AttributeError):
            pass
        cache.update(mtime=mtime, value=(top, bottom))
    return cache["value"]


def mounted(path: str) -> bool:
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as fh:
            return any(line.split()[4] == path for line in fh)
    except OSError:
        return False


def unshadow(path: str) -> None:
    # Lazily: Steam keeps STEAM_BOTTOM open through the mount, and goes on
    # writing to it once a new mount is in place.
    while mounted(path):
        if subprocess.run(["umount", "-l", path], capture_output=True).returncode != 0:
            log(f"cannot unmount {path}")
            return


def shadow_bottom(path: str, value: int) -> None:
    """Steam's writes to the bottom panel go to STEAM_BOTTOM from now on."""
    with open(STEAM_BOTTOM, "w", encoding="utf-8") as fh:
        fh.write(f"{value}\n")
    try:
        gid = grp.getgrnam("video").gr_gid
    except KeyError:
        gid = -1
    os.chown(STEAM_BOTTOM, -1, gid)
    os.chmod(STEAM_BOTTOM, 0o664)
    subprocess.run(["mount", "--bind", STEAM_BOTTOM, path], check=True, capture_output=True)


def bottom_alone(type_path: str, max_path: str, top_max: int, on: bool) -> None:
    """Desktop Mode: PowerDevil's backlight helper takes every backlight of
    the best type it finds and writes them all; both panels are "raw", so
    the bottom slider moved the top screen too, and the helper read its
    value back from the top panel. With "firmware" over the bottom panel's
    type it takes that one alone. PowerDevil reads the range once, from the
    top panel if it came first: the bottom's max_brightness shows the top's
    too, so the slider's values come on that one scale either way. Off for
    Game Mode, whose gamescope picks its backlight by type as well."""
    for path, src, value in ((type_path, FIRMWARE_TYPE, "firmware"), (max_path, DESKTOP_MAX, str(top_max))):
        if not on:
            unshadow(path)
            continue
        if mounted(path):
            continue
        with open(src, "w", encoding="utf-8") as fh:
            fh.write(value + "\n")
        os.chmod(src, 0o644)
        if subprocess.run(["mount", "--bind", src, path], capture_output=True).returncode != 0:
            log(f"cannot put {value} over {path}")


def steam_bottom() -> int | None:
    """The last value Steam wrote. It may write at a growing offset without
    truncating, so take the last number and trim the file now and then."""
    try:
        with open(STEAM_BOTTOM, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    if len(data) > 4096:
        os.truncate(STEAM_BOTTOM, 0)
    for word in reversed(data.replace(b"\0", b" ").split()):
        if word.isdigit():
            return int(word)
    return None


def watch(path: str) -> int | None:
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if fd < 0 or libc.inotify_add_watch(fd, path.encode(), IN_MODIFY) < 0:
        log("cannot watch Steam's brightness file; checking it every pass")
        return None
    return fd


def input_dirs(name: str) -> list[str]:
    return [d for d in glob.glob("/sys/class/input/input*") if read(f"{d}/name") == name]


def touch_inhibited_paths() -> list[str]:
    return [f"{d}/inhibited" for d in input_dirs(TOUCH_NAME)]


def setup_overlay() -> None:
    """Session-writable flags: the dashboard clears OVERLAY on timeout, and
    barry_launcher_shelld keeps TOP_INPUT."""
    os.makedirs(RUN_DIR, exist_ok=True)
    try:
        gid = grp.getgrnam("input").gr_gid
    except KeyError:
        gid = -1
    os.chown(RUN_DIR, -1, gid)
    os.chmod(RUN_DIR, 0o2775)
    for flag in (OVERLAY, TOP_INPUT):
        write(flag, "0")
        os.chown(flag, -1, gid)
        os.chmod(flag, 0o664)


def open_ayn_key() -> int | None:
    for d in input_dirs(AYN_KEYS_NAME):
        for ev in glob.glob(f"{d}/event*"):
            try:
                fd = os.open(f"/dev/input/{os.path.basename(ev)}", os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 1)
            except OSError as err:
                log(f"cannot grab {AYN_KEYS_NAME}: {err}")
                os.close(fd)
                return None
            log(f"AYN button on {os.path.basename(ev)}")
            return fd
    return None


def open_touch() -> int | None:
    for d in input_dirs(TOUCH_NAME):
        for ev in glob.glob(f"{d}/event*"):
            try:
                fd = os.open(f"/dev/input/{os.path.basename(ev)}", os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            log(f"bottom touchscreen on {os.path.basename(ev)}")
            return fd
    return None


def steam_display_user() -> str | None:
    """The user running Game Mode's main gamescope (Steam's :0), if any."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                args = fh.read().split(b"\0")
            if os.path.basename(args[0]) == b"gamescope" and b"--steam" in args:
                return pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid).pw_name
        except (OSError, KeyError):
            continue
    return None


def desktop_mode() -> bool:
    """Plasma's KWin runs and Game Mode's gamescope does not."""
    kwin = False
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                args = fh.read().split(b"\0")
        except OSError:
            continue
        name = os.path.basename(args[0])
        if name == b"gamescope" and b"--steam" in args:
            return False
        kwin = kwin or name == b"kwin_wayland"
    return kwin


def nudge_steam() -> subprocess.Popen | None:
    user = steam_display_user()
    if user is None:
        return None
    try:
        return subprocess.Popen(
            ["runuser", "-u", user, "--", "env", "DISPLAY=:0", "xdotool", "key", "Shift_R"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        log(f"cannot nudge Steam: {err}")
        return None


def steam_xprop(*args: str) -> subprocess.CompletedProcess | None:
    """xprop -root ARGS on Steam's display; None if Game Mode is not running."""
    user = steam_display_user()
    if user is None:
        return None
    try:
        return subprocess.run(
            ["runuser", "-u", user, "--", "env", "DISPLAY=:0", "xprop", "-root", *args],
            capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as err:
        log(f"cannot reach Steam's display: {err}")
        return None


def set_bottom_screen_yield(on: bool) -> bool:
    """GAMESCOPE_BOTTOM_SCREEN_YIELD on Steam's display; False if Game Mode
    is not running."""
    prop = "GAMESCOPE_BOTTOM_SCREEN_YIELD"
    r = steam_xprop(*(["-f", prop, "32c", "-set", prop, "1"] if on else ["-remove", prop]))
    return r is not None and r.returncode == 0


def bottom_screen_game() -> bool:
    """Steam's gamescope has a game's window for the bottom screen, shown
    there or waiting for it (GAMESCOPE_BOTTOM_SCREEN_SHOWING 1 or 2)."""
    r = steam_xprop("GAMESCOPE_BOTTOM_SCREEN_SHOWING")
    if r is None or r.returncode != 0:
        return False
    value = r.stdout.rsplit("=", 1)[-1].strip()
    return value in ("1", "2")


def main() -> int:
    # A copy left over a panel's attributes by a run that died goes first.
    for name in ("type", "max_brightness"):
        unshadow(os.path.realpath(f"{BOTTOM}/{name}"))
    bottom_max = int(read(f"{BOTTOM}/max_brightness", "0") or 0)
    top_max = int(read(f"{TOP}/max_brightness", "0") or 0)
    if bottom_max <= 0 or top_max <= 0:
        log("no usable backlights")
        return 1
    setup_overlay()

    # The real bottom panel, opened before Steam's file goes over it.
    bottom_path = os.path.realpath(f"{BOTTOM}/brightness")
    type_path = os.path.realpath(f"{BOTTOM}/type")
    max_path = os.path.realpath(f"{BOTTOM}/max_brightness")
    unshadow(bottom_path)
    if mounted(bottom_path):
        log("Steam's file is still over the bottom panel; cannot reach the panel")
        return 1
    bl_fd = os.open(bottom_path, os.O_RDWR)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        return run(bl_fd, bottom_path, (type_path, max_path), bottom_max, top_max)
    finally:
        unshadow(type_path)
        unshadow(max_path)
        unshadow(bottom_path)


def run(bl_fd: int, bottom_path: str, alone_paths: tuple[str, str], bottom_max: int, top_max: int) -> int:
    key_fd = open_ayn_key()
    key_retry = 0
    touch_fd = open_touch()
    touch_retry = 0
    nudged_at = -NUDGE_S
    nudge: subprocess.Popen | None = None

    def bottom_set() -> int:
        # Not actual_brightness: that reads 0 while bl_power is off.
        try:
            return int(os.pread(bl_fd, 32, 0).strip() or 0)
        except (OSError, ValueError):
            return 0

    def set_bottom(value: int, quiet: bool = False) -> bool:
        try:
            os.pwrite(bl_fd, str(value).encode(), 0)
            return True
        except OSError as err:
            if not quiet:
                log(f"cannot write {value} to {bottom_path}: {err}")
            return False

    def top_set() -> int:
        return int(read(f"{TOP}/brightness", "0") or 0)

    def level_of(value: int, maximum: int) -> float:
        return max(0.0, min(1.0, value / maximum))

    def target(level: float, dim: int, maximum: int) -> int:
        return max(1, min(maximum, round(level * dim / 100 * maximum)))

    def visible(position: float) -> int:
        """A slider position (0-1) on the bottom panel: from BOTTOM_VISIBLE
        at its low end to full, one doubling per step."""
        floor = min(BOTTOM_VISIBLE, bottom_max)
        return round(floor * (bottom_max / floor) ** max(0.0, min(1.0, position)))

    def desktop_bottom(value: int) -> int:
        """Plasma's bottom slider: linear, in Steam's file, on the top
        panel's scale (bottom_alone)."""
        return visible(level_of(value, top_max))

    def game_bottom(level: float, dim: int) -> int:
        """Steam's level (its slider's position to the power STEAM_GAMMA)
        times the bottom's dimmer."""
        return visible(level ** (1 / STEAM_GAMMA) * dim / 100)

    dim_cache: dict = {}
    glides: dict[str, tuple[int, int, float]] = {}  # panel -> (from, to, since)

    def glide(panel: str, want: int, now: int) -> int:
        """The value to write now on the way to want: a new want starts a
        glide from where the panel is, in even ratios (equal steps to the
        eye, more so on the AMOLED)."""
        g = glides.get(panel)
        if g is None or g[1] != want:
            if now == want:
                glides.pop(panel, None)
                return want
            g = glides[panel] = (max(1, now), want, time.monotonic())
        start, end, since = g
        f = (time.monotonic() - since) / GLIDE_S
        if f >= 1:
            glides.pop(panel, None)
            return end
        return max(1, round(start * (max(1, end) / start) ** f))
    try:
        level = float(read(LEVEL))
    except ValueError:
        level = level_of(bottom_set(), bottom_max)
    write(LEVEL, f"{level:.5f}")
    steam_value = max(1, round(level * bottom_max))
    shadow_bottom(bottom_path, steam_value)
    steam_fd = watch(STEAM_BOTTOM)
    # What the top panel held after this last wrote it (or found it), so a
    # different value there is a change from gamescope.
    wrote_top = top_set()
    # A panel refused its last write (EINVAL while it is off or coming up,
    # as after Desktop Mode turned the screens off): the value sits in sysfs
    # all the same, but not on the panel. Retried until it takes.
    top_refused = bottom_refused = False
    panel_retry_at = 0.0
    was_on = None
    overlay_since: float | None = None
    pressed_at: float | None = None  # AYN held down since, until handled
    home_count = 0
    yield_sent: bool | None = None  # GAMESCOPE_BOTTOM_SCREEN_YIELD as last set
    yield_retry_at = 0.0  # after Game Mode was not found
    home_over_game = False  # Home yields the bottom screen of a dual-screen game
    home_checked = 0.0
    desktop, mode_checked = False, -MODE_CHECK_S
    log(f"following {BOTTOM} (max {bottom_max}) -> {TOP} (max {top_max})")
    while True:
        if charge_rest():
            # Resting on the charger: sm8550-charge-rest has the screens off
            # and puts them back. Hands off until then.
            time.sleep(POLL_MS / 1000)
            continue
        poller = select.poll()
        if steam_fd is not None:
            poller.register(steam_fd, select.POLLIN)
        if key_fd is not None:
            poller.register(key_fd, select.POLLIN | select.POLLERR)
        if touch_fd is not None:
            poller.register(touch_fd, select.POLLIN | select.POLLERR)
        events = dict(poller.poll(GLIDE_MS if glides else POLL_MS))
        if steam_fd is not None and steam_fd in events:
            try:
                os.read(steam_fd, 4096)  # consume the notification
            except BlockingIOError:
                pass

        # AYN button: a short press toggles the dashboard, a long one goes
        # home. Decided on release, or once held long enough.
        if key_fd is not None and key_fd in events:
            try:
                data = os.read(key_fd, EVENT.size * 32)
            except BlockingIOError:
                data = b""
            except OSError:
                os.close(key_fd)
                key_fd, data = None, b""
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if etype != EV_KEY or code != KEY_F24:
                    continue
                if value == 1:
                    pressed_at = time.monotonic()
                elif value == 0 and pressed_at is not None:
                    pressed_at = None
                    up = read(OVERLAY, "0") != "1"
                    write(OVERLAY, "1" if up else "0")
                    log(f"AYN button: dashboard {'shown' if up else 'hidden'}")
        elif key_fd is None:
            pressed_at = None
            key_retry += 1
            if key_retry >= 50:  # every 5 s
                key_retry = 0
                key_fd = open_ayn_key()

        # Bottom-screen touches count as activity for Steam's idle dim.
        if touch_fd is not None and touch_fd in events:
            try:
                data = os.read(touch_fd, EVENT.size * 64)
            except BlockingIOError:
                data = b""
            except OSError:
                os.close(touch_fd)
                touch_fd, data = None, b""
            touched = any(EVENT.unpack_from(data, off)[2] in (EV_KEY, EV_ABS)
                          for off in range(0, len(data) - EVENT.size + 1, EVENT.size))
            if nudge is not None and nudge.poll() is not None:
                nudge = None
            if touched and nudge is None and time.monotonic() - nudged_at >= NUDGE_S:
                nudged_at = time.monotonic()
                nudge = nudge_steam()
                log(f"bottom touch: {'nudged Steam' if nudge else 'Game Mode not running'}")
        elif touch_fd is None:
            touch_retry += 1
            if touch_retry >= 50:  # every 5 s
                touch_retry = 0
                touch_fd = open_touch()

        if pressed_at is not None and time.monotonic() - pressed_at >= LONG_PRESS_S:
            pressed_at = None  # the release does nothing more
            if read(OVERLAY, "0") == "1":
                write(OVERLAY, "0")
            if home_over_game:
                # Held again: the game's window gets the bottom screen back.
                home_over_game = False
                log("AYN button held: back to the game")
            else:
                home_over_game = bottom_screen_game()
                home_checked = time.monotonic()
                home_count += 1
                write(HOME, str(home_count))
                log(f"AYN button held: home{' over the game' if home_over_game else ''}")
        elif home_over_game and time.monotonic() - home_checked >= YIELD_RETRY_S:
            # The game quit meanwhile: nothing to go back to.
            home_checked = time.monotonic()
            if not bottom_screen_game():
                home_over_game = False
                log("the game's window is gone; Home stays")

        overlay = read(OVERLAY, "0") == "1"
        want_yield = overlay or home_over_game or read(TOP_INPUT, "0") == "1"
        if want_yield != yield_sent and time.monotonic() >= yield_retry_at:
            if set_bottom_screen_yield(want_yield):
                yield_sent = want_yield
                log(f"bottom screen {'yielded to' if want_yield else 'back from'} Barry Launcher")
            elif want_yield:
                yield_retry_at = time.monotonic() + YIELD_RETRY_S
            else:
                yield_sent = False  # no Game Mode, nothing to take back
        if overlay and overlay_since is None:
            overlay_since = time.monotonic()
        elif not overlay:
            overlay_since = None
        on = read(STATE, "on") != "off" or (
            overlay_since is not None and time.monotonic() - overlay_since >= OVERLAY_DELAY_S
        )
        if not on:
            if read(f"{BOTTOM}/bl_power") != BL_OFF:
                write(f"{BOTTOM}/bl_power", BL_OFF)
            for p in touch_inhibited_paths():
                if read(p) != "1":
                    write(p, "1")
        elif was_on is False:
            # Back on: at its level, then power up and allow touch.
            set_bottom(desktop_bottom(steam_value) if desktop
                       else game_bottom(level, read_dimmers(dim_cache)[1]))
            write(f"{BOTTOM}/bl_power", BL_ON)
            for p in touch_inhibited_paths():
                write(p, "0")
        if on != was_on:
            log(f"bottom screen {'on' if on else 'off'}")
        was_on = on

        if time.monotonic() - mode_checked >= MODE_CHECK_S:
            mode_checked = time.monotonic()
            if desktop_mode() != desktop:
                desktop = not desktop
                bottom_alone(*alone_paths, top_max, desktop)
                log("Desktop Mode: Plasma sets each screen" if desktop else "Game Mode: Steam's level, with the dimmers")
        if desktop:
            # Plasma has a slider per screen and sets the top panel itself;
            # its bottom one writes into Steam's file (STEAM_BOTTOM), which
            # goes to the panel without the dimmers (Game Mode's, set in the
            # Barry Launcher plugin), over the range it shows (desktop_bottom).
            # It reaches the bottom panel alone (bottom_alone).
            steam_now = steam_bottom()
            if steam_now is not None:
                steam_value = steam_now
            want_bottom = glide("bottom", desktop_bottom(steam_value), bottom_set())
            if on and (bottom_set() != want_bottom or (bottom_refused and time.monotonic() >= panel_retry_at)):
                refused = not set_bottom(want_bottom, quiet=bottom_refused)
                if refused != bottom_refused:
                    log(f"bottom panel {'refuses' if refused else 'took'} brightness {want_bottom}")
                bottom_refused = refused
                if refused:
                    panel_retry_at = time.monotonic() + PANEL_RETRY_S
            wrote_top = top_set()  # Plasma's: no level for Game Mode
            continue

        # Steam's level: a new value in Steam's file (or on the top panel).
        steam_now, top_now = steam_bottom(), top_set()
        if steam_now is not None and steam_now != steam_value:
            steam_value = steam_now
            level = level_of(steam_now, bottom_max)
            write(LEVEL, f"{level:.5f}")
        elif top_now != wrote_top and top_now > 0:
            level, wrote_top = level_of(top_now, top_max), top_now
            write(LEVEL, f"{level:.5f}")
        dims = read_dimmers(dim_cache)
        retry = (top_refused or bottom_refused) and time.monotonic() >= panel_retry_at
        want_bottom = glide("bottom", game_bottom(level, dims[1]), bottom_set())
        if bottom_set() != want_bottom or (bottom_refused and retry):
            refused = not set_bottom(want_bottom, quiet=bottom_refused)
            if refused != bottom_refused:
                log(f"bottom panel {'refuses' if refused else 'took'} brightness {want_bottom}")
            bottom_refused = refused
        want_top = glide("top", target(level, dims[0], top_max), top_now)
        if top_now != want_top or (top_refused and retry):
            refused = not write(f"{TOP}/brightness", str(want_top), quiet=top_refused)
            if refused != top_refused:
                log(f"top panel {'refuses' if refused else 'took'} brightness {want_top}")
            top_refused = refused
            # Even refused, the value is now in sysfs: this one's own, not a
            # level gamescope set. Taking it for one fed each refused write
            # back in as the new level, down to 1, and the screens stayed
            # black once they came back on.
            wrote_top = top_set()
        if (top_refused or bottom_refused) and time.monotonic() >= panel_retry_at:
            panel_retry_at = time.monotonic() + PANEL_RETRY_S


if __name__ == "__main__":
    sys.exit(main())
