+/// The capability a touch is sent as: a touchscreen's, or a trackpad's
+fn touch_capability(trackpad: Option<Trackpad>) -> Capability {
+    match trackpad {
+        None => Capability::Touchscreen(Touch::Motion),
+        Some(Trackpad::Left) => Capability::Touchpad(Touchpad::LeftPad(Touch::Motion)),
+        Some(Trackpad::Right) => Capability::Touchpad(Touchpad::RightPad(Touch::Motion)),
     }
