[Unit]
Description=SM8550 gpio volume rocker
# The main account only: other logins (ssh) must not drive the shared hardware.
ConditionUser=steamos
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --user --only volume-keys
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
