#!/usr/bin/env python3
"""sm8550-thor-backlightd: AYN Thor bottom screen. One brightness for both
panels, the Barry Launcher plugin's bottom-screen switch, and the AYN button.

Brightness: Steam's Game Mode slider adjusts the first backlight it finds,
the bottom panel's (ae94000.dsi.0), and writes it directly (the video group
may), about ten times a second while the slider moves, from a file it keeps
open. Game Mode shows the top panel (ae96000.dsi.0). So that Steam's writes
never reach the bottom panel, this opens the panel's brightness file and
then bind-mounts STEAM_BOTTOM, a plain file, over it before Game Mode starts
(the unit runs before the display manager); Steam writes its level there and
this is the only writer of the bottom panel. Steam's level, a fraction of
the range (from STEAM_BOTTOM, or from the top panel should gamescope write
that), is kept in LEVEL. As on AYN's Android, each screen has a brightness
of its own (SCREENS, a slider position 0-1): Steam's slider is Android's
"both screens" one and sets both to its position, the Barry Launcher
plugin's top and bottom sliders set one each. The panels then get what
Android gives them for those positions (stock_top, stock_bottom). Steam's
slider puts out
its position to the power STEAM_GAMMA (30% writes 7%) and never less than
STEAM_LOWEST, so its position is the level to the power 1/STEAM_GAMMA,
stretched so that Steam's slider covers Android's whole range. The top panel
takes it straight, up to TOP_CAP; the bottom one through AYN's own curve
(BOTTOM_CURVE, from the stock framework), both in the 4095 steps Android's
display stack uses, and never under PANEL_MIN. (A steamos-priv-write
redirect alone ran pkexec for every slider step and lagged; it stays as a
fallback.)

Bottom-screen switch: the Barry Launcher Decky plugin writes "off" or "on" to STATE. While the
bottom screen is off its backlight is powered down (bl_power; the brightness
Steam sets is kept underneath, so the top panel still follows) and its
touchscreen is inhibited. Both are enforced on every pass, because the panel
driver powers the backlight up again on each modeset and wake, and the Game
Mode / Desktop start scripts re-enable the touchscreen.

AYN button: InputPlumber leaves gpio-keys-ayn alone on the Thor (no device
config lists it, see 50-ayn_thor.yaml); this grabs it. In Game Mode a short
press of KEY_F24 opens or closes Barry Launcher: it flips OVERLAY, which
barry_launcher_shelld watches (and also writes: an app started from Barry
closes it, a swipe up from the bottom edge opens it). Holding it
LONG_PRESS_S turns the bottom screen off or on, as the Dual Screen switch
does (STATE); turning it off also closes Barry. A short press while it is
off turns it on again, with Barry open. While Barry is open
(OVERLAY "1") the bottom screen is on even if the switch says off (from
OVERLAY_DELAY_S after the press, once Barry has drawn, so the app under it
does not flash up); once it closes the screen returns to the switch's
state. While OVERLAY or TOP_INPUT (Barry Launcher's Keyboard or Trackpad
app open, written by barry_launcher_shelld) is "1", Steam's gamescope also
gets GAMESCOPE_BOTTOM_SCREEN_YIELD on its root: should it be drawing a
game's second window on the bottom screen (a DS or 3DS emulator's,
gamescope's dual-screen branch), it hands the screen back to Barry
Launcher's gamescope and takes it again once both are "0". In Desktop Mode
a short press turns Barry Launcher off or on there (DESKTOP_SWITCH): off,
the bottom screen is a plain second screen of the desktop.

Sleep: with Barry Launcher's bottomSleepSeconds set (its settings, the
desktop user's BARRY_SETTINGS, the PB-OS tab's Dual Screen page), no touch
on the bottom screen and no AYN press for that long turns the bottom
backlight off, its touchscreen left on: the next touch, or an AYN press,
wakes it (that press does nothing else; a touch also reaches whatever is
under it). Not in Desktop Mode, nor while a game draws on the bottom screen
(GAMESCOPE_BOTTOM_SCREEN_SHOWING).

Charge rest: while sm8550-charge-rest has the device resting on the
charger (CHARGE_REST), both screens are its to power off and back on, and
this does nothing.

Idle dim: Steam dims the screens (and later sleeps) when it has seen no
input for a while, and touches on the bottom screen go to the bottom
session's gamescope, not Steam's. So a touch there brightens nothing until
the top screen or a button is used. This reads the bottom touchscreen
(without grabbing it) and, at most every NUDGE_S, taps right Shift on
Steam's display, which Steam counts as input. (Steam's display has no X
screensaver extension; moving the pointer also works but shows gamescope's
cursor on the top screen.)
"""
from __future__ import annotations

import fcntl
import glob
import ctypes
import grp
import json
import os
import pwd
import select
import signal
import struct
import subprocess
import sys
import time

BOTTOM = "/sys/class/backlight/ae94000.dsi.0"
TOP = "/sys/class/backlight/ae96000.dsi.0"
STATE = "/var/lib/steamos-sm8550/thor-bottom-screen"
CHARGE_REST = "/run/sm8550-charge-rest"  # sm8550-charge-rest: resting on the charger
# Settings of earlier ways to set the screens (the plugin's dimmers, and a
# test build's floors and screen match): both screens follow Steam's slider
# alone now, so any left over are removed.
LEFTOVERS = [f"/var/lib/steamos-sm8550/thor-screen-{name}.json" for name in ("dimmers", "floors", "match")]
RUN_DIR = "/run/sm8550-thor"
LEVEL = f"{RUN_DIR}/steam-brightness"
# Each screen's brightness, a slider position (0-1) as on Android:
# {"top": f, "bottom": f, "steam": the last value Steam wrote}. Steam
# writes its level again at every start; only a different value is a move
# of its slider, so the screens keep their own settings across restarts.
SCREENS = "/var/lib/steamos-sm8550/thor-screen-brightness.json"
STEAM_BOTTOM = f"{RUN_DIR}/steam-bottom-brightness"
FIRMWARE_TYPE = f"{RUN_DIR}/bottom-backlight-type"
DESKTOP_MAX = f"{RUN_DIR}/bottom-backlight-max"
IN_MODIFY = 0x2
STEAM_GAMMA = 2.2
OVERLAY = f"{RUN_DIR}/overlay"  # "1": Barry Launcher is open
TOP_INPUT = f"{RUN_DIR}/top-input"
# Desktop Mode shares SCREENS with Game Mode, through
# sm8550-thor-desktop-brightness in the Plasma session: on entering it this
# leaves DESKTOP_START (SCREENS as they were) and holds both panels there
# until the helper has set Plasma's sliders to it and made DESKTOP_READY
# (Plasma first applies its own last levels), or DESKTOP_READY_S passes.
# Plasma's top slider dims in software, so the top panel then stays at its
# highest and the helper writes that slider's position to DESKTOP_TOP; its
# bottom slider writes into Steam's file (bottom_alone).
DESKTOP_START = f"{RUN_DIR}/desktop-start.json"
DESKTOP_READY = f"{RUN_DIR}/desktop-ready"
DESKTOP_TOP = f"{RUN_DIR}/desktop-top"
DESKTOP_READY_S = 10
LONG_PRESS_S = 0.6
BARRY_SETTINGS = os.path.expanduser("~steamos/.config/barry_launcher/settings.json")
# Barry Launcher on or off in Desktop Mode (as its menu entry and the PB-OS
# tab do), run as the desktop user.
DESKTOP_SWITCH = "/usr/lib/barry_launcher/barry_launcher_desktop_switch"
# Asleep is due, but a game draws on the bottom screen: looked at again after.
SLEEP_CHECK_S = 5
TOUCH_NAME = "bottom_touchscreen"
AYN_KEYS_NAME = "gpio-keys-ayn"
KEY_F24 = 194
EV_KEY = 1
EV_ABS = 3
EVIOCGRAB = 0x40044590
EVENT = struct.Struct("llHHi")
BL_ON, BL_OFF = "0", "4"  # FB_BLANK_UNBLANK, FB_BLANK_POWERDOWN
# The kernel notifies actual_brightness on changes; the timeout also paces
# enforcing the switch and retrying the AYN key device.
POLL_MS = 100
# Barry Launcher hears the flag, then comes forward and draws.
OVERLAY_DELAY_S = 0.5
# Steam's shortest idle dim is minutes; one nudge per this many seconds of
# touching keeps it awake.
NUDGE_S = 20
# Steam's display is looked for again this often while Game Mode is not up.
YIELD_RETRY_S = 2
# A panel that refused its brightness (off, or still coming up) is tried
# again this often.
PANEL_RETRY_S = 0.5
# Whether Desktop Mode (Plasma) is up is looked at this often.
MODE_CHECK_S = 2
# A new brightness is reached in a glide this long, a step every GLIDE_MS:
# sliders send a few values a second, and each jump showed as a tick.
GLIDE_S = 0.15
GLIDE_MS = 16
# As AYN's Android (Thor 1.0.0.377) sets the panels. A slider position f
# (0-1) becomes one of STEPS levels, 1 + f * (STEPS - 1), and the panel gets
# level * its highest / STEPS, never under PANEL_MIN (the device tree's
# bl-min-level). The top panel's highest is TOP_CAP (bl-max-level 0x0D55;
# the kernel caps it too), the bottom one's its full 65535. The bottom panel
# first goes through AYN's curve: percent = a + b*d + c*d^2 + e*d^3 with
# d = f * 100, up to 100 (it passes 100 above f = 0.9045 and dips a little
# below f = 0.0345, both as on Android).
STEPS = 4095
# Steam's slider all the way down writes this level (655 of 65535 on a
# Thor), which is Android's slider at 0.
STEAM_LOWEST = 0.01
PANEL_MIN = 10
TOP_CAP = 3413
BOTTOM_CURVE = (0.514020912017522, -0.0624984606065165, 0.00882449823664514, 4.45251742834015e-05)


def log(msg: str) -> None:
    print(msg, flush=True)


def charge_rest() -> bool:
    """sm8550-charge-rest is resting (CHARGE_REST holds its live PID)."""
    try:
        with open(CHARGE_REST, encoding="utf-8") as fh:
            pid = fh.read().strip()
    except OSError:
        return False
    return pid.isdigit() and os.path.exists(f"/proc/{pid}")


def read(path: str, default: str = "") -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return default


def write(path: str, value: str, quiet: bool = False) -> bool:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(value)
        return True
    except OSError as err:
        if not quiet:
            log(f"cannot write {value} to {path}: {err}")
        return False


def read_screens(cache: dict) -> dict | None:
    """SCREENS, reread only when the file changes; None if unset."""
    try:
        mtime = os.stat(SCREENS).st_mtime_ns
    except OSError:
        return None
    if cache.get("mtime") != mtime:
        try:
            with open(SCREENS, encoding="utf-8") as fh:
                d = json.load(fh)
            cache.update(mtime=mtime, value={
                "top": max(0.0, min(1.0, float(d["top"]))),
                "bottom": max(0.0, min(1.0, float(d["bottom"]))),
                "steam": int(d.get("steam", -1))})
        except (OSError, ValueError, TypeError, KeyError):
            cache.update(mtime=mtime, value=None)
    return cache["value"]


def clear_desktop() -> None:
    """A Desktop Mode session's files, gone once it has ended."""
    for path in (DESKTOP_START, DESKTOP_READY, DESKTOP_TOP):
        try:
            os.remove(path)
        except OSError:
            pass


def save_screens(screens: dict) -> None:
    tmp = SCREENS + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(screens, fh)
            fh.write("\n")
        os.replace(tmp, SCREENS)
    except OSError as err:
        log(f"cannot save {SCREENS}: {err}")


def mounted(path: str) -> bool:
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as fh:
            return any(line.split()[4] == path for line in fh)
    except OSError:
        return False


def unshadow(path: str) -> None:
    # Lazily: Steam keeps STEAM_BOTTOM open through the mount, and goes on
    # writing to it once a new mount is in place.
    while mounted(path):
        if subprocess.run(["umount", "-l", path], capture_output=True).returncode != 0:
            log(f"cannot unmount {path}")
            return


def shadow_bottom(path: str, value: int) -> None:
    """Steam's writes to the bottom panel go to STEAM_BOTTOM from now on."""
    with open(STEAM_BOTTOM, "w", encoding="utf-8") as fh:
        fh.write(f"{value}\n")
    try:
        gid = grp.getgrnam("video").gr_gid
    except KeyError:
        gid = -1
    os.chown(STEAM_BOTTOM, -1, gid)
    os.chmod(STEAM_BOTTOM, 0o664)
    subprocess.run(["mount", "--bind", STEAM_BOTTOM, path], check=True, capture_output=True)


def bottom_alone(type_path: str, max_path: str, top_max: int, on: bool) -> None:
    """Desktop Mode: PowerDevil's backlight helper takes every backlight of
    the best type it finds and writes them all; both panels are "raw", so
    the bottom slider moved the top screen too, and the helper read its
    value back from the top panel. With "firmware" over the bottom panel's
    type it takes that one alone. PowerDevil reads the range once, from the
    top panel if it came first: the bottom's max_brightness shows the top's
    too, so the slider's values come on that one scale either way. Off for
    Game Mode, whose gamescope picks its backlight by type as well."""
    for path, src, value in ((type_path, FIRMWARE_TYPE, "firmware"), (max_path, DESKTOP_MAX, str(top_max))):
        if not on:
            unshadow(path)
            continue
        if mounted(path):
            continue
        with open(src, "w", encoding="utf-8") as fh:
            fh.write(value + "\n")
        os.chmod(src, 0o644)
        if subprocess.run(["mount", "--bind", src, path], capture_output=True).returncode != 0:
            log(f"cannot put {value} over {path}")


def steam_bottom() -> int | None:
    """The last value Steam wrote. It may write at a growing offset without
    truncating, so take the last number and trim the file now and then."""
    try:
        with open(STEAM_BOTTOM, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    if len(data) > 4096:
        os.truncate(STEAM_BOTTOM, 0)
    for word in reversed(data.replace(b"\0", b" ").split()):
        if word.isdigit():
            return int(word)
    return None


def watch(path: str) -> int | None:
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if fd < 0 or libc.inotify_add_watch(fd, path.encode(), IN_MODIFY) < 0:
        log("cannot watch Steam's brightness file; checking it every pass")
        return None
    return fd


def input_dirs(name: str) -> list[str]:
    return [d for d in glob.glob("/sys/class/input/input*") if read(f"{d}/name") == name]


def touch_inhibited_paths() -> list[str]:
    return [f"{d}/inhibited" for d in input_dirs(TOUCH_NAME)]


def setup_overlay() -> None:
    """Session-writable flags: barry_launcher_shelld opens and closes Barry
    (OVERLAY) too, and keeps TOP_INPUT."""
    os.makedirs(RUN_DIR, exist_ok=True)
    try:
        gid = grp.getgrnam("input").gr_gid
    except KeyError:
        gid = -1
    os.chown(RUN_DIR, -1, gid)
    os.chmod(RUN_DIR, 0o2775)
    for flag in (OVERLAY, TOP_INPUT):
        write(flag, "0")
        os.chown(flag, -1, gid)
        os.chmod(flag, 0o664)


def open_ayn_key() -> int | None:
    for d in input_dirs(AYN_KEYS_NAME):
        for ev in glob.glob(f"{d}/event*"):
            try:
                fd = os.open(f"/dev/input/{os.path.basename(ev)}", os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 1)
            except OSError as err:
                log(f"cannot grab {AYN_KEYS_NAME}: {err}")
                os.close(fd)
                return None
            log(f"AYN button on {os.path.basename(ev)}")
            return fd
    return None


def open_touch() -> int | None:
    for d in input_dirs(TOUCH_NAME):
        for ev in glob.glob(f"{d}/event*"):
            try:
                fd = os.open(f"/dev/input/{os.path.basename(ev)}", os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            log(f"bottom touchscreen on {os.path.basename(ev)}")
            return fd
    return None


def steam_display_user() -> str | None:
    """The user running Game Mode's main gamescope (Steam's :0), if any."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                args = fh.read().split(b"\0")
            if os.path.basename(args[0]) == b"gamescope" and b"--steam" in args:
                return pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid).pw_name
        except (OSError, KeyError):
            continue
    return None


def desktop_mode() -> bool:
    """Plasma's KWin runs and Game Mode's gamescope does not."""
    kwin = False
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                args = fh.read().split(b"\0")
        except OSError:
            continue
        name = os.path.basename(args[0])
        if name == b"gamescope" and b"--steam" in args:
            return False
        kwin = kwin or name == b"kwin_wayland"
    return kwin


def desktop_user() -> pwd.struct_passwd | None:
    """The user running Plasma's KWin."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                if os.path.basename(fh.read().split(b"\0")[0]) == b"kwin_wayland":
                    return pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid)
        except (OSError, KeyError):
            continue
    return None


def toggle_desktop_barry() -> subprocess.Popen | None:
    """Barry Launcher off (the bottom screen the desktop's) or on again."""
    user = desktop_user()
    if user is None or not os.access(DESKTOP_SWITCH, os.X_OK):
        return None
    runtime = f"/run/user/{user.pw_uid}"
    try:
        return subprocess.Popen(
            ["runuser", "-u", user.pw_name, "--", "env", f"HOME={user.pw_dir}", f"XDG_RUNTIME_DIR={runtime}",
             f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus", "BARRY_SWITCH_QUIET=1",
             DESKTOP_SWITCH, "toggle"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        log(f"cannot switch Barry Launcher: {err}")
        return None


def nudge_steam() -> subprocess.Popen | None:
    user = steam_display_user()
    if user is None:
        return None
    try:
        return subprocess.Popen(
            ["runuser", "-u", user, "--", "env", "DISPLAY=:0", "xdotool", "key", "Shift_R"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        log(f"cannot nudge Steam: {err}")
        return None


def steam_xprop(*args: str) -> subprocess.CompletedProcess | None:
    """xprop -root ARGS on Steam's display; None if Game Mode is not running."""
    user = steam_display_user()
    if user is None:
        return None
    try:
        return subprocess.run(
            ["runuser", "-u", user, "--", "env", "DISPLAY=:0", "xprop", "-root", *args],
            capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as err:
        log(f"cannot reach Steam's display: {err}")
        return None


def bottom_screen_game() -> bool:
    """Steam's gamescope shows a game's window on the bottom screen
    (GAMESCOPE_BOTTOM_SCREEN_SHOWING 1)."""
    r = steam_xprop("GAMESCOPE_BOTTOM_SCREEN_SHOWING")
    if r is None or r.returncode != 0:
        return False
    return r.stdout.rsplit("=", 1)[-1].strip() == "1"


def sleep_seconds(cache: dict) -> int:
    """Barry Launcher's bottomSleepSeconds (0: never), read again only when
    its settings file changes."""
    try:
        mtime = os.stat(BARRY_SETTINGS).st_mtime_ns
    except OSError:
        return 0
    if cache.get("mtime") != mtime:
        cache["mtime"] = mtime
        try:
            with open(BARRY_SETTINGS, encoding="utf-8") as fh:
                v = json.load(fh).get("bottomSleepSeconds", 0)
        except (OSError, ValueError, AttributeError):
            v = 0
        cache["value"] = int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v > 0 else 0
    return cache["value"]


def set_bottom_screen_yield(on: bool) -> bool:
    """GAMESCOPE_BOTTOM_SCREEN_YIELD on Steam's display; False if Game Mode
    is not running."""
    prop = "GAMESCOPE_BOTTOM_SCREEN_YIELD"
    r = steam_xprop(*(["-f", prop, "32c", "-set", prop, "1"] if on else ["-remove", prop]))
    return r is not None and r.returncode == 0


def main() -> int:
    # A copy left over a panel's attributes by a run that died goes first.
    for name in ("type", "max_brightness"):
        unshadow(os.path.realpath(f"{BOTTOM}/{name}"))
    bottom_max = int(read(f"{BOTTOM}/max_brightness", "0") or 0)
    top_max = min(TOP_CAP, int(read(f"{TOP}/max_brightness", "0") or 0))
    if bottom_max <= 0 or top_max <= 0:
        log("no usable backlights")
        return 1
    setup_overlay()
    clear_desktop()
    for path in LEFTOVERS:
        try:
            os.remove(path)
            log(f"removed {path}: both screens follow Steam's slider")
        except OSError:
            pass

    # The real bottom panel, opened before Steam's file goes over it.
    bottom_path = os.path.realpath(f"{BOTTOM}/brightness")
    type_path = os.path.realpath(f"{BOTTOM}/type")
    max_path = os.path.realpath(f"{BOTTOM}/max_brightness")
    unshadow(bottom_path)
    if mounted(bottom_path):
        log("Steam's file is still over the bottom panel; cannot reach the panel")
        return 1
    bl_fd = os.open(bottom_path, os.O_RDWR)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        return run(bl_fd, bottom_path, (type_path, max_path), bottom_max, top_max)
    finally:
        unshadow(type_path)
        unshadow(max_path)
        unshadow(bottom_path)


def run(bl_fd: int, bottom_path: str, alone_paths: tuple[str, str], bottom_max: int, top_max: int) -> int:
    key_fd = open_ayn_key()
    key_retry = 0
    touch_fd = open_touch()
    touch_retry = 0
    nudged_at = -NUDGE_S
    nudge: subprocess.Popen | None = None

    def bottom_set() -> int:
        # Not actual_brightness: that reads 0 while bl_power is off.
        try:
            return int(os.pread(bl_fd, 32, 0).strip() or 0)
        except (OSError, ValueError):
            return 0

    def set_bottom(value: int, quiet: bool = False) -> bool:
        try:
            os.pwrite(bl_fd, str(value).encode(), 0)
            return True
        except OSError as err:
            if not quiet:
                log(f"cannot write {value} to {bottom_path}: {err}")
            return False

    def top_set() -> int:
        return int(read(f"{TOP}/brightness", "0") or 0)

    def level_of(value: int, maximum: int) -> float:
        return max(0.0, min(1.0, value / maximum))

    def panel_value(f: float, maximum: int) -> int:
        """Android's display stack: a position (0-1) in STEPS levels, onto
        the panel's range."""
        step = int(1 + max(0.0, min(1.0, f)) * (STEPS - 1))
        return max(PANEL_MIN, min(maximum, step * maximum // STEPS))

    def stock_top(f: float) -> int:
        return panel_value(f, top_max)

    def stock_bottom(f: float) -> int:
        """AYN's curve for the bottom screen, in percent of the panel."""
        a, b, c, e = BOTTOM_CURVE
        d = max(0.0, min(1.0, f)) * 100
        return panel_value(min(100.0, a + b * d + c * d * d + e * d * d * d) / 100, bottom_max)

    def steam_position(level: float) -> float:
        """Where Steam's slider sits (0-1, from its lowest to full), from
        the level it put out."""
        lowest = STEAM_LOWEST ** (1 / STEAM_GAMMA)
        position = max(0.0, min(1.0, level)) ** (1 / STEAM_GAMMA)
        return max(0.0, (position - lowest) / (1 - lowest))


    glides: dict[str, tuple[int, int, float]] = {}  # panel -> (from, to, since)

    def glide(panel: str, want: int, now: int) -> int:
        """The value to write now on the way to want: a new want starts a
        glide from where the panel is, in even ratios (equal steps to the
        eye, more so on the AMOLED)."""
        g = glides.get(panel)
        if g is None or g[1] != want:
            if now == want:
                glides.pop(panel, None)
                return want
            g = glides[panel] = (max(1, now), want, time.monotonic())
        start, end, since = g
        f = (time.monotonic() - since) / GLIDE_S
        if f >= 1:
            glides.pop(panel, None)
            return end
        return max(1, round(start * (max(1, end) / start) ** f))
    try:
        level = float(read(LEVEL))
    except ValueError:
        level = level_of(bottom_set(), bottom_max)
    write(LEVEL, f"{level:.5f}")
    steam_value = max(1, round(level * bottom_max))
    screens_cache: dict = {}
    screens = read_screens(screens_cache)
    if screens is None:
        f = steam_position(level)
        screens = {"top": f, "bottom": f, "steam": steam_value}
        save_screens(screens)
    elif screens["steam"] > 0:
        steam_value = screens["steam"]
    shadow_bottom(bottom_path, steam_value)
    steam_fd = watch(STEAM_BOTTOM)
    # What the top panel held after this last wrote it (or found it), so a
    # different value there is a change from gamescope.
    wrote_top = top_set()
    # A panel refused its last write (EINVAL while it is off or coming up,
    # as after Desktop Mode turned the screens off): the value sits in sysfs
    # all the same, but not on the panel. Retried until it takes.
    top_refused = bottom_refused = False
    panel_retry_at = 0.0
    was_on = None
    asleep = False
    last_active = time.monotonic()  # a bottom touch or an AYN press
    sleep_cache: dict = {}
    game_checked = 0.0
    overlay_since: float | None = None
    pressed_at: float | None = None  # AYN held down since, until handled
    switching: subprocess.Popen | None = None  # DESKTOP_SWITCH running
    yield_sent: bool | None = None  # GAMESCOPE_BOTTOM_SCREEN_YIELD as last set
    yield_retry_at = 0.0  # after Game Mode was not found
    desktop, mode_checked = False, -MODE_CHECK_S
    desktop_since = 0.0
    desktop_top_seen: int | None = None  # DESKTOP_TOP's mtime last taken in
    log(f"following {BOTTOM} (max {bottom_max}) -> {TOP} (max {top_max})")
    while True:
        if charge_rest():
            # Resting on the charger: sm8550-charge-rest has the screens off
            # and puts them back. Hands off until then.
            time.sleep(POLL_MS / 1000)
            continue
        poller = select.poll()
        if steam_fd is not None:
            poller.register(steam_fd, select.POLLIN)
        if key_fd is not None:
            poller.register(key_fd, select.POLLIN | select.POLLERR)
        if touch_fd is not None:
            poller.register(touch_fd, select.POLLIN | select.POLLERR)
        events = dict(poller.poll(GLIDE_MS if glides else POLL_MS))
        if steam_fd is not None and steam_fd in events:
            try:
                os.read(steam_fd, 4096)  # consume the notification
            except BlockingIOError:
                pass

        # AYN button: a short press opens or closes Barry Launcher (on
        # release); holding it turns the bottom screen off or on (once held
        # long enough).
        if key_fd is not None and key_fd in events:
            try:
                data = os.read(key_fd, EVENT.size * 32)
            except BlockingIOError:
                data = b""
            except OSError:
                os.close(key_fd)
                key_fd, data = None, b""
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if etype != EV_KEY or code != KEY_F24:
                    continue
                if value == 1:
                    last_active = time.monotonic()
                    if asleep:
                        # Only wakes the bottom screen.
                        asleep, pressed_at = False, None
                        log("AYN button: bottom screen wakes")
                        continue
                    pressed_at = time.monotonic()
                elif value == 0 and pressed_at is not None:
                    pressed_at = None
                    if desktop:
                        if switching is not None and switching.poll() is None:
                            log("AYN button: short press (Barry Launcher still switching)")
                        else:
                            switching = toggle_desktop_barry()
                            log("AYN button: Barry Launcher on or off in Desktop Mode"
                                if switching else "AYN button: short press (no desktop user)")
                    else:
                        opening = read(OVERLAY, "0") != "1"
                        # Pressed while the bottom screen is off: it wakes
                        # (the switch goes on) with Barry open, so Barry's
                        # standby then shows the game art, not black.
                        if opening and read(STATE, "on") == "off":
                            write(STATE, "on")
                            log("AYN button: bottom screen on")
                        write(OVERLAY, "1" if opening else "0")
                        log(f"AYN button: Barry Launcher {'opens' if opening else 'closes'}")
        elif key_fd is None:
            pressed_at = None
            key_retry += 1
            if key_retry >= 50:  # every 5 s
                key_retry = 0
                key_fd = open_ayn_key()

        # Bottom-screen touches count as activity for Steam's idle dim.
        if touch_fd is not None and touch_fd in events:
            try:
                data = os.read(touch_fd, EVENT.size * 64)
            except BlockingIOError:
                data = b""
            except OSError:
                os.close(touch_fd)
                touch_fd, data = None, b""
            touched = any(EVENT.unpack_from(data, off)[2] in (EV_KEY, EV_ABS)
                          for off in range(0, len(data) - EVENT.size + 1, EVENT.size))
            if touched:
                last_active = time.monotonic()
                if asleep:
                    asleep = False
                    log("bottom touch: bottom screen wakes")
            if nudge is not None and nudge.poll() is not None:
                nudge = None
            if touched and nudge is None and time.monotonic() - nudged_at >= NUDGE_S:
                nudged_at = time.monotonic()
                nudge = nudge_steam()
                log(f"bottom touch: {'nudged Steam' if nudge else 'Game Mode not running'}")
        elif touch_fd is None:
            touch_retry += 1
            if touch_retry >= 50:  # every 5 s
                touch_retry = 0
                touch_fd = open_touch()

        if pressed_at is not None and time.monotonic() - pressed_at >= LONG_PRESS_S:
            pressed_at = None  # the release does nothing more
            # Off as the switch would be: Barry closes too, or it would keep
            # the screen lit.
            turning_off = read(STATE, "on") != "off"
            write(STATE, "off" if turning_off else "on")
            if turning_off and read(OVERLAY, "0") == "1":
                write(OVERLAY, "0")
            log(f"AYN button held: bottom screen {'off' if turning_off else 'on'}")

        overlay = read(OVERLAY, "0") == "1"
        want_yield = overlay or read(TOP_INPUT, "0") == "1"
        if want_yield != yield_sent and time.monotonic() >= yield_retry_at:
            if set_bottom_screen_yield(want_yield):
                yield_sent = want_yield
                log(f"bottom screen {'yielded to' if want_yield else 'back from'} Barry Launcher")
            elif want_yield:
                yield_retry_at = time.monotonic() + YIELD_RETRY_S
            else:
                yield_sent = False  # no Game Mode, nothing to take back
        if overlay and overlay_since is None:
            overlay_since = time.monotonic()
        elif not overlay:
            overlay_since = None
        switch_on = read(STATE, "on") != "off" or (
            overlay_since is not None and time.monotonic() - overlay_since >= OVERLAY_DELAY_S
        )
        # Sleep: untouched for bottomSleepSeconds (not in Desktop Mode, nor
        # while a game draws on the bottom screen).
        limit = sleep_seconds(sleep_cache)
        if asleep and limit == 0:
            asleep = False  # the timer was turned off: awake at once
            last_active = time.monotonic()
            log("bottom screen wakes: sleep turned off")
        if (not asleep and switch_on and limit > 0 and not desktop
                and time.monotonic() - last_active >= limit
                and time.monotonic() - game_checked >= SLEEP_CHECK_S):
            game_checked = time.monotonic()
            if bottom_screen_game():
                last_active = time.monotonic()
            else:
                asleep = True
                log(f"bottom screen asleep: untouched for {limit} s")
        if not switch_on:
            asleep = False
            last_active = time.monotonic()  # turned on again: a fresh start
        on = switch_on and not asleep
        if not switch_on:
            if read(f"{BOTTOM}/bl_power") != BL_OFF:
                write(f"{BOTTOM}/bl_power", BL_OFF)
            for p in touch_inhibited_paths():
                if read(p) != "1":
                    write(p, "1")
        elif asleep:
            # Dark, but touch stays on: a touch wakes it.
            if read(f"{BOTTOM}/bl_power") != BL_OFF:
                write(f"{BOTTOM}/bl_power", BL_OFF)
        elif was_on is False:
            # Back on: at its level, then power up and allow touch.
            set_bottom(stock_bottom(screens["bottom"]))
            write(f"{BOTTOM}/bl_power", BL_ON)
            for p in touch_inhibited_paths():
                write(p, "0")
        if on != was_on:
            log(f"bottom screen {'on' if on else 'off'}")
        was_on = on

        if time.monotonic() - mode_checked >= MODE_CHECK_S:
            mode_checked = time.monotonic()
            if desktop_mode() != desktop:
                desktop = not desktop
                bottom_alone(*alone_paths, top_max, desktop)
                if desktop:
                    # The helper may have been quicker; it then read SCREENS.
                    desktop_since, desktop_top_seen = time.monotonic(), None
                    if not os.path.exists(DESKTOP_READY):
                        write(DESKTOP_START, json.dumps(screens) + "\n")
                else:
                    clear_desktop()
                if not desktop and screens["steam"] > 0:
                    # Plasma's bottom slider wrote into Steam's file: it
                    # gets back what Steam last wrote, which a move of
                    # Steam's slider is told from.
                    steam_value = screens["steam"]
                    write(STEAM_BOTTOM, f"{steam_value}\n")
                log("Desktop Mode: Plasma's sliders, sharing Game Mode's brightness" if desktop else "Game Mode: Steam's level on both, as on Android")
        if desktop:
            # Plasma has a slider per screen, and they set SCREENS as the
            # Barry Launcher plugin's do in Game Mode: the bottom one writes
            # into Steam's file (STEAM_BOTTOM) on the top panel's scale
            # (bottom_alone), the top one dims in software and comes through
            # DESKTOP_TOP. Until the helper is ready, both panels hold
            # SCREENS. The top never goes above TOP_CAP, whoever writes it.
            ready = os.path.exists(DESKTOP_READY) or time.monotonic() - desktop_since >= DESKTOP_READY_S
            steam_now = steam_bottom()
            if ready:
                changed = False
                if steam_now is not None and steam_now != steam_value:
                    screens["bottom"], changed = level_of(steam_now, top_max), True
                try:
                    mtime = os.stat(DESKTOP_TOP).st_mtime_ns
                except OSError:
                    mtime = None
                if mtime is not None and mtime != desktop_top_seen:
                    desktop_top_seen = mtime
                    try:
                        screens["top"], changed = max(0.0, min(1.0, float(read(DESKTOP_TOP)))), True
                    except ValueError:
                        pass
                if changed:
                    save_screens(screens)
            if steam_now is not None:
                steam_value = steam_now
            want_bottom = glide("bottom", stock_bottom(screens["bottom"]), bottom_set())
            if on and (bottom_set() != want_bottom or (bottom_refused and time.monotonic() >= panel_retry_at)):
                refused = not set_bottom(want_bottom, quiet=bottom_refused)
                if refused != bottom_refused:
                    log(f"bottom panel {'refuses' if refused else 'took'} brightness {want_bottom}")
                bottom_refused = refused
                if refused:
                    panel_retry_at = time.monotonic() + PANEL_RETRY_S
            want_top = glide("top", top_max if ready else stock_top(screens["top"]), top_set())
            if top_set() != want_top and not write(f"{TOP}/brightness", str(want_top), quiet=top_refused):
                top_refused = True
            wrote_top = top_set()  # Plasma's: no level for Game Mode
            continue

        # Steam's level: a new value in Steam's file (or on the top panel)
        # sets both screens, as Android's "both screens" slider does; the
        # plugin's sliders change one screen in SCREENS.
        screens = read_screens(screens_cache) or screens
        steam_now, top_now = steam_bottom(), top_set()
        moved = False
        if steam_now is not None and steam_now != steam_value:
            steam_value = steam_now
            level, moved = level_of(steam_now, bottom_max), True
        elif top_now != wrote_top and top_now > 0:
            level, wrote_top, moved = level_of(top_now, top_max), top_now, True
        if moved:
            write(LEVEL, f"{level:.5f}")
            f = steam_position(level)
            screens = {"top": f, "bottom": f, "steam": steam_value}
            save_screens(screens)
        retry = (top_refused or bottom_refused) and time.monotonic() >= panel_retry_at
        want_bottom = glide("bottom", stock_bottom(screens["bottom"]), bottom_set())
        if bottom_set() != want_bottom or (bottom_refused and retry):
            refused = not set_bottom(want_bottom, quiet=bottom_refused)
            if refused != bottom_refused:
                log(f"bottom panel {'refuses' if refused else 'took'} brightness {want_bottom}")
            bottom_refused = refused
        want_top = glide("top", stock_top(screens["top"]), top_now)
        if top_now != want_top or (top_refused and retry):
            refused = not write(f"{TOP}/brightness", str(want_top), quiet=top_refused)
            if refused != top_refused:
                log(f"top panel {'refuses' if refused else 'took'} brightness {want_top}")
            top_refused = refused
            # Even refused, the value is now in sysfs: this one's own, not a
            # level gamescope set. Taking it for one fed each refused write
            # back in as the new level, down to 1, and the screens stayed
            # black once they came back on.
            wrote_top = top_set()
        if (top_refused or bottom_refused) and time.monotonic() >= panel_retry_at:
            panel_retry_at = time.monotonic() + PANEL_RETRY_S


if __name__ == "__main__":
    sys.exit(main())
