#!/usr/bin/env python3
"""barry_launcher_audio: the AYN Thor's two volumes, one per screen.

PipeWire has a "Top screen" output (60-pbos-top-screen.conf), a loopback
into the real output. This keeps:
  - "Top screen" the default output, so Steam, games, Steam's volume bar
    and the volume keys use it: its volume is the top screen's;
  - its loopback on the real output (the speakers, HDMI or Bluetooth),
    which stays at 100 %;
  - each bottom-screen app's stream (barry_quick.bottom_apps) straight on
    the real output, at the bottom screen's volume (barry_quick's
    appsVolume) as its own volume. Neither volume moves the other.
When the default output becomes a real one (sm8550-audio-pipewire on an
HDMI or DisplayPort change, an output picked in Steam, Bluetooth
connecting), that one is the real output from then on: the top volume
becomes the one it had there last (or that output's own, the first time),
it goes to 100 % and "Top screen" is the default again. Streams moved onto
the real output that are not the bottom apps' go back to "Top screen".

Event-driven: pactl subscribe; SIGUSR1 (barry_quick) when the bottom
volume moves. Without the "Top screen" output (the config is not linked)
it does nothing.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/barry_launcher")
import barry_quick  # noqa: E402

TOP = "pbos_top_screen"
TOP_OUT = "pbos_top_screen_out"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                     "barry_launcher_audio.json")
# Events come in bursts (our own changes make more); act once they settle.
SETTLE_S = 0.15


def log(msg: str) -> None:
    print(msg, flush=True)


def pactl(*args: str) -> str | None:
    try:
        r = subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def pactl_json(what: str) -> list[dict]:
    try:
        out = json.loads(pactl("-f", "json", "list", what) or "[]")
    except ValueError:
        return []
    return out if isinstance(out, list) else []


def percent(volume: dict) -> int | None:
    """pactl's volume ({"front-left": {"value_percent": "25%"}, ...}): the
    loudest channel, in Steam's (cubic) percent."""
    try:
        return max(int(str(c["value_percent"]).rstrip("%")) for c in volume.values())
    except (AttributeError, KeyError, ValueError, TypeError):
        return None


def is_real(sink: dict | None) -> bool:
    """A hardware output (ALSA, Bluetooth), not a virtual one."""
    return bool(sink) and bool(sink.get("properties", {}).get("device.api"))


def load_state() -> dict:
    try:
        with open(STATE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(data: dict) -> None:
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, STATE)


class Audio:
    def __init__(self) -> None:
        self.state = load_state()
        self.state.setdefault("top", {})   # real output -> top volume there
        self.real: str | None = self.state.get("real")
        self.missing_logged = False

    def _remember(self, real: str, top_pct: int | None) -> None:
        changed = False
        if top_pct is not None and self.state["top"].get(real) != top_pct:
            self.state["top"][real] = top_pct
            changed = True
        if self.state.get("real") != real:
            self.state["real"] = real
            changed = True
        if changed:
            save_state(self.state)

    def reconcile(self) -> None:
        sinks = {s.get("name"): s for s in pactl_json("sinks")}
        top = sinks.get(TOP)
        if not top:
            if not self.missing_logged:
                log(f"no {TOP} output: nothing to do")
                self.missing_logged = True
            return
        self.missing_logged = False
        by_index = {s.get("index"): s.get("name") for s in sinks.values()}
        inputs = pactl_json("sink-inputs")
        out = next((i for i in inputs if i.get("properties", {}).get("node.name") == TOP_OUT), None)
        default = (pactl("get-default-sink") or "").strip()
        top_pct = percent(top.get("volume", {}))

        # A real output became the default: it is the real output now.
        if default != TOP and is_real(sinks.get(default)):
            new = default
            if self.real and self.real != new and self.real in sinks:
                self._remember(self.real, top_pct)
            want = self.state["top"].get(new)
            if want is None:
                own = percent(sinks[new].get("volume", {}))
                want = own if own is not None and own < 99 else top_pct
            pactl("set-default-sink", TOP)
            if want is not None and want != top_pct:
                pactl("set-sink-volume", TOP, f"{want}%")
                top_pct = want
            log(f"real output {new}; top volume {top_pct}%")
            self.real = new
        elif not is_real(sinks.get(self.real)) and out is not None:
            # The real output went (Bluetooth disconnecting): WirePlumber
            # moved the loopback on to another; that one is it now.
            here = by_index.get(out.get("sink"))
            if is_real(sinks.get(here)):
                log(f"real output {here} (the loopback's)")
                self.real = here
        if not is_real(sinks.get(self.real)):
            return
        real = sinks[self.real]
        self._remember(self.real, top_pct)

        # The real output: at 100 %, not muted, under the loopback.
        if percent(real.get("volume", {})) != 100:
            pactl("set-sink-volume", self.real, "100%")
        if real.get("mute"):
            pactl("set-sink-mute", self.real, "0")
        if out is not None and by_index.get(out.get("sink")) != self.real:
            pactl("move-sink-input", str(out["index"]), self.real)

        # The streams: the bottom apps' on the real output at their volume;
        # others moved onto it go back to "Top screen". Filters' and
        # loopbacks' own streams (node.link-group) are left alone.
        apps = barry_quick.bottom_apps(inside=False)
        apps_pct = barry_quick.apps_volume()
        for i in inputs:
            props = i.get("properties", {})
            if props.get("node.link-group") or props.get("node.name") == TOP_OUT:
                continue
            on = by_index.get(i.get("sink"))
            if barry_quick.is_app_stream(props, apps):
                if on != self.real:
                    pactl("move-sink-input", str(i["index"]), self.real)
                if percent(i.get("volume", {})) != apps_pct:
                    pactl("set-sink-input-volume", str(i["index"]), f"{apps_pct}%")
            elif on == self.real:
                pactl("move-sink-input", str(i["index"]), TOP)


def main() -> int:
    audio = Audio()
    wake = threading.Event()
    signal.signal(signal.SIGUSR1, lambda *_: wake.set())

    def listen() -> None:
        while True:
            try:
                proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True)
            except OSError:
                time.sleep(3)
                continue
            wake.set()  # (re)connected: look at everything once
            for line in proc.stdout:
                # sink-input new/change/remove, sink new/change/remove,
                # server (the default output changed).
                if any(w in line for w in ("sink-input", "on sink", "on server")):
                    wake.set()
            proc.wait()
            time.sleep(3)  # PipeWire restarting: listen again

    threading.Thread(target=listen, daemon=True).start()
    while True:
        wake.wait()
        time.sleep(SETTLE_S)
        wake.clear()
        try:
            audio.reconcile()
        except Exception as e:  # keep serving; the next event retries
            log(f"reconcile failed: {e!r}")


if __name__ == "__main__":
    sys.exit(main())
