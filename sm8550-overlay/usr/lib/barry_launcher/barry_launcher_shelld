HOME_LAYOUT = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"), "barry_launcher", "home.json")


def hideable(app: str) -> bool:
    return app in APPS and APPS[app].get("hideable", True)


def home_layout() -> tuple[list[str], set[str]]:
    try:
        with open(HOME_LAYOUT, encoding="utf-8") as fh:
            saved = json.load(fh)
        order = [a for a in saved.get("order", []) if a in APPS]
        hidden = {a for a in saved.get("hidden", []) if hideable(a)}
    except (OSError, ValueError, AttributeError):
        order, hidden = [], set()
    order = list(dict.fromkeys(order)) + [a for a in APPS if a not in order]
    return order, hidden


def layout_json() -> dict:
    order, hidden = home_layout()
    return {"apps": [{"id": a, "name": APPS[a]["name"], "hidden": a in hidden, "hideable": hideable(a),
                      "user": APPS[a].get("user", False), "version": APPS[a].get("version", "")}
                     for a in order]}


def set_layout(body: dict) -> tuple[int, dict]:
    order, hidden = body.get("order"), body.get("hidden", [])
    if not isinstance(order, list) or not isinstance(hidden, list):
        return 400, {"error": "order and hidden are lists of apps"}
    order = [a for a in order if a in APPS]
    order = list(dict.fromkeys(order)) + [a for a in APPS if a not in order]
    os.makedirs(os.path.dirname(HOME_LAYOUT), exist_ok=True)
    tmp = HOME_LAYOUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump({"order": order, "hidden": sorted(a for a in hidden if hideable(a))}, fh, indent=1)
        fh.write("\n")
    os.replace(tmp, HOME_LAYOUT)
    publish("apps")
    return 200, layout_json()
