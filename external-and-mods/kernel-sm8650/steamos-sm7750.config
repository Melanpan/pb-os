# Retroid Pocket Duo (SM7750 / Snapdragon 7 Gen 4, "Eliza") additions,
# merged after steamos.config when SOC=all builds the Duo DTB (DUO=1).
# Drivers for Retroid's eliza-retroidpocket-rpduo.dts (retroid/patches 0071).
# Untested: no Duo in hand.

# SoC: clocks, pins and interconnect built in, as for SM8550/SM8650.
CONFIG_CLK_ELIZA_GCC=y
CONFIG_CLK_ELIZA_TCSRCC=y
CONFIG_CLK_ELIZA_DISPCC=y
CONFIG_CLK_ELIZA_GPUCC=y
CONFIG_CLK_ELIZA_VIDEOCC=m
CONFIG_CLK_ELIZA_CAMCC=m
CONFIG_PINCTRL_ELIZA=y
CONFIG_PINCTRL_MILOS_LPASS_LPI=m
CONFIG_INTERCONNECT_QCOM_ELIZA=y

# WCN7750 Wi-Fi sits on AHB (Bluetooth: hci_qca, already on).
CONFIG_ATH12K_AHB=y

# Headphone codec, haptics.
CONFIG_SND_SOC_ES8326=m
CONFIG_INPUT_AW86927=m

# Panels: top = Retroid's vtdr6130 (rpduo-panel-top), bottom = Retroid's
# command-mode IL97680A (all/patches/0660; ROCKNIX's video-mode one stays
# for the Nova).
CONFIG_DRM_PANEL_VISIONOX_VTDR6130=y
CONFIG_DRM_PANEL_ILITEK_IL97680A_CMD=y
