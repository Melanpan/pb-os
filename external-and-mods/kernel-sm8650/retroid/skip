# Retroid patches build.sh leaves out (one basename per line). See README.

# Il97680a Nova panel: Retroid's driver runs the panel in command mode, which
# needs Retroid's Nova DTS (tearing-effect setup). pb-os still boots the Nova
# with ROCKNIX's DTS, so ROCKNIX's video-mode driver (0105) and 0640 stay.
0008-drm-panel-add-Ilitek-IL97680A-based-panels.patch
# RSInput: Retroid's driver has no rumble (ROCKNIX 1003 routes force feedback
# to the qcom haptics) and no axis_* parameters (sm8550-stickcal sets them).
# ROCKNIX's driver and our sleep patches (0508/0509/0515/0536/0548) stay.
0010-Input-rsinput-add-AYN-and-Retroid-Pocket-UART-gamepa.patch
# RP6/Nova device trees: same file names as ROCKNIX's, which pb-os still
# uses (the ROCKNIX copy would overwrite them anyway).
0067-arm64-dts-qcom-add-common-dtsi-for-QCS8550-Retroid-P.patch
0068-arm64-dts-qcom-add-Retroid-Pocket-6.patch
0069-arm64-dts-qcom-add-Retroid-Pocket-Nova.patch
