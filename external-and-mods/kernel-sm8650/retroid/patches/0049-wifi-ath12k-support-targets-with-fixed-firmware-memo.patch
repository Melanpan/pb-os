From 444bb9b352908ce84ab7425a1e747772bc7ec6da Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:22 +0000
Subject: [PATCH 49/71] wifi: ath12k: support targets with fixed firmware
 memory

WPSS-hosted targets run from a fixed MSA region granted by TZ and never
request DDR from the host over QMI. Asking for request_mem/fw_mem_ready
makes such a target hand the host a memory request it answers with
buffers the XPU will not let the target touch, which resets the SoC.

Add hw_params->fixed_fw_mem: skip those indications, go from host_cap
straight to BDF download, and do not send the PHY capability request
the firmware predates. Mirrors ath11k's WCN6750 handling.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/net/wireless/ath/ath12k/hw.h  |  3 +++
 drivers/net/wireless/ath/ath12k/qmi.c | 30 ++++++++++++++++++++++-----
 2 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/hw.h b/drivers/net/wireless/ath/ath12k/hw.h
index 76c790d6b..51fb78487 100644
--- a/drivers/net/wireless/ath/ath12k/hw.h
+++ b/drivers/net/wireless/ath/ath12k/hw.h
@@ -197,6 +197,9 @@ struct ath12k_hw_params {
 	bool current_cc_support:1;
 	bool supports_cong_ctrl_max_msdus:1;
 
+	/* fixed MSA region: no request_mem/fw_mem_ready, host_cap -> BDF directly */
+	bool fixed_fw_mem:1;
+
 	/* 0x8fc on PCIe parts, 0x504 on WPSS-hosted WCN parts */
 	u32 hal_shadow_base_addr;
 
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index 280e50a1f..d799a8c79 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2410,10 +2410,17 @@ static int ath12k_qmi_fw_ind_register_send(struct ath12k_base *ab)
 	req->client_id = QMI_WLANFW_CLIENT_ID;
 	req->fw_ready_enable_valid = 1;
 	req->fw_ready_enable = 1;
-	req->request_mem_enable_valid = 1;
-	req->request_mem_enable = 1;
-	req->fw_mem_ready_enable_valid = 1;
-	req->fw_mem_ready_enable = 1;
+
+	/* Fixed-MSA targets must not be asked for request_mem/fw_mem_ready
+	 * (ath11k WCN6750).
+	 */
+	if (!ab->hw_params->fixed_fw_mem) {
+		req->request_mem_enable_valid = 1;
+		req->request_mem_enable = 1;
+		req->fw_mem_ready_enable_valid = 1;
+		req->fw_mem_ready_enable = 1;
+	}
+
 	req->cal_done_enable_valid = 1;
 	req->cal_done_enable = 1;
 	req->fw_init_done_enable_valid = 1;
@@ -3744,7 +3751,11 @@ int ath12k_qmi_event_server_arrive(struct ath12k_qmi *qmi)
 	struct ath12k_hw_group *ag = ab->ag;
 	int ret;
 
-	ath12k_qmi_phy_cap_send(ab);
+	/* Not sent by ath11k WCN6750 nor icnss2; the firmware predates it. */
+	if (ab->hw_params->fixed_fw_mem)
+		ab->qmi.num_radios = ab->hw_params->def_num_link;
+	else
+		ath12k_qmi_phy_cap_send(ab);
 
 	ret = ath12k_qmi_fw_ind_register_send(ab);
 	if (ret < 0) {
@@ -3986,6 +3997,15 @@ static int ath12k_qmi_event_host_cap(struct ath12k_qmi *qmi)
 		return ret;
 	}
 
+	/* no memory request round trip; go straight to BDF (ath11k WCN6750) */
+	if (ab->hw_params->fixed_fw_mem) {
+		ret = ath12k_qmi_event_load_bdf(qmi);
+		if (ret < 0) {
+			ath12k_warn(ab, "qmi failed to download BDF: %d\n", ret);
+			return ret;
+		}
+	}
+
 	return ret;
 }
 
