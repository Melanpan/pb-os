From 99aceaebae0085cd19dfde1480578a9a05777afe Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Thu, 10 Sep 2026 19:10:37 +0700
Subject: [PATCH 30/71] Input: edt-ft5x06 - allow overriding the input device
 name from DT

The input device is named after the model read from the controller,
so two identical controllers on one board show up with the same name
and userspace cannot tell which touchscreen belongs to which display.

Use the optional "label" property as the input device name when it
is present; the detected model name is kept otherwise.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/input/touchscreen/edt-ft5x06.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/input/touchscreen/edt-ft5x06.c b/drivers/input/touchscreen/edt-ft5x06.c
index d5132935b..25689e475 100644
--- a/drivers/input/touchscreen/edt-ft5x06.c
+++ b/drivers/input/touchscreen/edt-ft5x06.c
@@ -1155,6 +1155,7 @@ static int edt_ft5x06_ts_probe(struct i2c_client *client)
 	const struct edt_i2c_chip_data *chip_data;
 	struct edt_ft5x06_ts_data *tsdata;
 	unsigned int val;
+	const char *label;
 	struct input_dev *input;
 	unsigned long irq_flags;
 	int error;
@@ -1328,6 +1329,10 @@ static int edt_ft5x06_ts_probe(struct i2c_client *client)
 		"Model \"%s\", Rev. \"%s\", %dx%d sensors\n",
 		tsdata->name, tsdata->fw_version, tsdata->num_x, tsdata->num_y);
 
+	/* Allow device tree to override the input device name */
+	if (!device_property_read_string(&client->dev, "label", &label))
+		strscpy(tsdata->name, label, EDT_NAME_LEN);
+
 	input->name = tsdata->name;
 	input->id.bustype = BUS_I2C;
 	input->dev.parent = &client->dev;
-- 
