
/*
 * From Armada (armada-os/armada@8675d4090): with its IO supply cut in sleep
 * the panel draws more than 1 W, so l12b stays on. Together with the SN3112
 * suspend fix (patches/0550) Armada measured 1.5 W asleep before, 0.2 W after.
 */
&vreg_l12b_1p8 {
	regulator-always-on;
};

/*
 * Stock AYN settings (factory DT, KalamaP HDK overlay, same on the Odin 2,
 * Odin 2 Portal and Odin 2 Mini): the haptics base voltage is 3200 mV (the
 * per-effect voltages already match AYN-common), and the fan PWM period is
 * 50 us. AYN-common, which the Thor shares, has 5000 mV and 40 us.
 */
&pm8550b_hv_haptics {
	qcom,vmax-mv = <3200>;
};

&pwm_fan {
	pwms = <&pm8550_pwm 3 50000>;
};
